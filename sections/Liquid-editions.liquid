<style>
    .section-edition-{{ section.id }}{
        padding-top: 100px;
        padding-bottom: 100px;
        overflow: hidden;
    }
    .section-edition-{{ section.id }} .container-full{
        padding-left: 16%;
        padding-right: 16%;
    }
    .section-edition-{{ section.id }} .head-block-cont{
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .section-edition-{{ section.id }} .head-block-cont .section-sub-title{
        font: 700 20px 'DIN';
        color: #fff;
        text-align: center;
    }
    .section-edition-{{ section.id }} .head-block-cont .section-title{
        font: 700 50px 'DIN';
        color: #fff;
        text-align: center;
    }
    .section-edition-{{ section.id }} .head-block-cont .section-desc{
        font: 400 16px 'Poppins';
        color: #fff;
        text-align: center;
    }

    .section-edition-{{ section.id }} .edition-cont{
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translateX(-50px);
    }
    .section-edition-{{ section.id }} .edition-cont img{
        height: auto;
    }
   
    .section-edition-{{ section.id }} .edition-cont .left-cont{
        transform: translateX(100px);
        width: calc(50% + 130px);
    }
    .section-edition-{{ section.id }} .edition-cont .right-cont{
        display: flex;
        flex-direction: column;
        width: calc(50% - 30px);
        position: relative;
    }
    .section-edition-{{ section.id }} .edition-cont .right-cont:before{
        display: inline-block;
        content: ' ';
        width: 2px;
        height: 100%;
        background: #1589DB;
        position: absolute;
        left: -50px;

    }
    .section-edition-{{ section.id }} .edition-cont .right-cont .item-block-title{
        font-family: "DIN";
        font-weight: 700;
        font-style: Bold;
        font-size: 30px;
        line-height: 39px;
        letter-spacing: -4%;
        text-transform: uppercase;
        color: #fff;
        z-index: 1;
    }
    .section-edition-{{ section.id }} .edition-cont .right-cont .item-block-desc{
        font-family: "Poppins";
        font-weight: 400;
        font-style: Regular;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: 0%;
        text-transform: capitalize;
        color: #fff;
        margin-top: 17px;
    }
    .section-edition-{{ section.id }} .container-full .edition-lists img{
        height: auto;
    }
    .section-edition-{{ section.id }} .container-full .edition-lists .edition-img-pc{
        display: block;
    }
    .section-edition-{{ section.id }} .container-full .edition-lists .edition-img-mb{
        display: none;
    }


    @media(max-width: 767px){
        .section-edition-{{ section.id }} {
            padding-top: 50px;
            padding-bottom: 50px;
        }
        .section-edition-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
        }
        .section-edition-{{ section.id }} .head-block-cont .section-sub-title{
            font-size: 16px;
        }
        .section-edition-{{ section.id }} .head-block-cont .section-title{
            font-size: 25px;
        }
        .section-edition-{{ section.id }} .head-block-cont .section-desc{
            font-size: 14px;
        }
        .section-edition-{{ section.id }} .edition-cont{
            flex-direction: column;
            transform: none;
        }
        .section-edition-{{ section.id }} .edition-cont .right-cont:before{
            display: none;
        }
        .section-edition-{{ section.id }} .edition-cont .left-cont{
            transform: none;
            width: 100%;
        }
        .section-edition-{{ section.id }} .edition-cont .right-cont{
            width: auto;
            transform: translateY(-40px);
        }
        .section-edition-{{ section.id }} .container-full .edition-lists .edition-img-pc{
            display: none;
        }
        .section-edition-{{ section.id }} .container-full .edition-lists .edition-img-mb{
            display: block;
        }
    }

    {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-edition-{{ section.id }}{
            padding-top: 50px;
            padding-bottom: 50px;
        }
        .section-edition-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
        }
        .section-edition-{{ section.id }} .head-block-cont .section-title{
            font-size: 40px;
        }
        .section-edition-{{ section.id }} .container-full .cont-container{
            margin-top: 20px;
        }
        .section-edition-{{ section.id }} .edition-cont .right-cont .item-block-title{
            font-size: 20px;
            line-height: 25px;
        }
        .section-edition-{{ section.id }} .edition-cont .right-cont .item-block-desc{
            font-size: 12px;
            line-height: 24px;
        }
        
    }

    {% comment %} small screen {% endcomment %}
    @media(min-width: 1025px) and (max-width: 1480px){
        .section-edition-{{ section.id }} .container-full{
            padding-left: 60px;
            padding-right: 60px;
        }
    }
</style>

<section class="section-edition-{{ section.id }}" id="{{ section.id }}" data-section-id="{{ section.id }}">
    {%- liquid
        assign bgImage = section.settings.sectionBgImage
        assign bgImageMb = section.settings.sectionBgImage_mb
    -%}

    <style>
        .section-edition-{{ section.id }} {
            background-color: #001538;
            background-image: url({{ bgImage | img_url: 'master' }});
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        @media (max-width: 767px) {
            .section-edition-{{ section.id }} {
                background-image: url({{ bgImageMb | img_url: 'master' }});
            }
        }
    </style>
    <div class="container-full">
        <div class="head-block-cont">
            {% if section.settings.sectionSubTitle != blank %}
                <div class="section-sub-title">{{ section.settings.sectionSubTitle }}</div>
            {% endif %}
            {% if section.settings.sectionTitle != blank %}
                <div class="section-title">{{ section.settings.sectionTitle }}</div>
            {% endif %}
            {% if section.settings.sectionDesc != blank %}
                <div class="section-desc">{{ section.settings.sectionDesc }}</div>
            {% endif %}
        </div>
        <div class="cont-container">
            {% for block in section.blocks %}
                {% if block.type == "itemBlock" %}
                    <div class="edition-cont">
                        <div class="left-cont">
                            <img src="{{ block.settings.item_block_edition_image | img_url: 'master' }}" 
                                width="{{ block.settings.item_block_edition_image.width }}" 
                                height="{{ block.settings.item_block_edition_image.height }}" 
                                alt="{{ block.settings.item_block_edition_image.alt }}" />
                        </div>
                        <div class="right-cont">
                            <div class="item-block-title">{{ block.settings.item_block_title }}</div>
                            <div class="item-block-desc">{{ block.settings.item_block_desc }}</div>
                        </div>
                    </div>
                {% elsif block.type == "itemImage" %}
                    <div class="edition-lists">
                        <div class="edition-img edition-img-pc">
                            <img src="{{ block.settings.itemImageWeb | img_url: 'master' }}" 
                                width="{{ block.settings.itemImageWeb.width }}" 
                                height="{{ block.settings.itemImageWeb.height }}" 
                                alt="{{ block.settings.itemImageWeb.alt }}" />
                        </div>
                        <div class="edition-img edition-img-mb">
                            <img src="{{ block.settings.itemImageMobile | img_url: 'master' }}" 
                                width="{{ block.settings.itemImageMobile.width }}" 
                                height="{{ block.settings.itemImageMobile.height }}" 
                                alt="{{ block.settings.itemImageMobile.alt }}" />
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Liquid Editions",
    "settings": [
        {
            "type": "image_picker",
            "id": "sectionBgImage",
            "label": "section Background Image"
        },
        {
            "type": "image_picker",
            "id": "sectionBgImage_mb",
            "label": "section Background Image Mobile"
        },
        {
            "type": "text",
            "id": "sectionTitle",
            "label": "section Title"
        },
        {
            "type": "text",
            "id": "sectionSubTitle",
            "label": "section sub title"
        },
        {
            "type": "textarea",
            "id": "sectionDesc",
            "label": "section description"
        }
    ],
    "blocks": [
        {
            "type": "itemBlock",
            "name": "itemBlock",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "item_block_edition_image",
                    "label": "Item Block Edition Image"
                },
                {
                    "type": "text",
                    "id": "item_block_title",
                    "label": "Item Block Title"
                },
                {
                    "type": "text",
                    "id": "item_block_desc",
                    "label": "Item Block Desc"
                }
            ]
        },
        {
            "type": "itemImage",
            "name": "itemImage",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "itemImageWeb",
                    "label": "Item Image Web"
                },
                {
                    "type": "image_picker",
                    "id": "itemImageMobile",
                    "label": "Item Image Mobile"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Liquid Editions"
        }
    ]
}
{% endschema %}