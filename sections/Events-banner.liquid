<style>
    .section-{{ section.id }}{
        background: rgba(0,0,0,0.8);
    }
    .section-{{ section.id }} .container-full{
        position: relative;
    }
    .section-{{ section.id }} .container-full img{
        height: auto;
    }

    .section-{{ section.id }} .container-full .large-image{
        padding-top: var(--pc-ratio);
        position: relative;
    }
    .section-{{ section.id }} .container-full .large-image picture{
        width: 100%;
        position: absolute;
        top: 0;
        left: 0;
    }

    .section-{{ section.id }} .container-full .cont-area{
        position: absolute;
        left: 16%;
        right: 16%;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .section-{{ section.id }} .container-full .cont-area-left{
        display: flex;
        flex-direction: column;
        width: 40%;
    }

    .section-{{ section.id }} .container-full .cont-area-right{
        display: flex;
        width: 70%;
    }

    .section-{{ section.id }} .container-full .cont-area-title{
        font-family: Poppins;
        font-weight: 600;
        font-style: SemiBold;
        font-size: 30px;
        line-height: 36px;
        letter-spacing: 0%;
        color: #fff;
        width: 80%;
    }

    .section-{{ section.id }} .container-full .cont-area-desc{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 16px;
        line-height: 26px;
        letter-spacing: 0%;
        color: #fff;
        margin-top: 10px;
    }

    .section-{{ section.id }} .container-full .cont-area-btn{
        font-family: Poppins;
        font-weight: 600;
        font-style: SemiBold;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: 0%;
        vertical-align: middle;
        color: #262629;
        background: #fff;
        padding: 16px 50px;
        width: max-content;
        border-radius: 60px;
        margin-top: 23px;
        transition: all .5s ease;
        border: 1px solid #fff;
    }
    .section-{{ section.id }} .container-full .cont-area-btn:hover{
        background: none;
        color: #fff;
        border-color: #262629;
        box-shadow: 0 0 12px #fff;
    }

    .section-{{ section.id }} .container-full .cont-area-right .small-image{
        margin-left: -30px;
    }
   

    {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-{{ section.id }} .container-full .cont-area{
            left: 10px;
            right: 10px;
        }
        .section-{{ section.id }} .container-full .cont-area-title{
            font-size: 26px;
            line-height: 30px;
        }
        .section-{{ section.id }} .container-full .cont-area-desc{
            font-size: 12px;
            line-height: 18px;
        }
        .section-{{ section.id }} .container-full .cont-area-btn{
            font-size: 14px;
            line-height: 20px;
            padding: 12px 40px;
        }
        .section-{{ section.id }} .container-full .cont-area-right .small-image{
            margin-left: -10px;
        }
        .section-{{ section.id }} .container-full .cont-area-right{
            width: 55%;
        }
    }

    {% comment %} iPhone {% endcomment %}
    @media(max-width: 767px){
        .section-{{ section.id }} .container-full .large-image{
            padding-top: var(--mb-ratio);
        }
        .section-{{ section.id }} .container-full .cont-area{
            left: 10px;
            right: 10px;
            flex-direction: column;
            gap: 20px;
        }
        .section-{{ section.id }} .container-full .cont-area-left{
            width: 90%;
        }

        .section-{{ section.id }} .container-full .cont-area-right{
            width: 95%;
            margin-left: 8%;
        }

        .section-{{ section.id }} .container-full .cont-area-title{
            font-size: 26px;
        }
        .section-{{ section.id }} .container-full .cont-area-desc{
            font-size: 14px;
            line-height: 23px;
            margin-top: 5px;
        }

        .section-{{ section.id }} .container-full .cont-area-btn{
            font-size: 14px;
            padding: 9px 14px;
            margin-top: 13px;
        }

        .section-{{ section.id }} .container-full .cont-area-right .small-image{
            margin-left: -20px;
        }
    }

    {% comment %} small screen {% endcomment %}
    @media(min-width: 1025px) and (max-width: 1480px){
        .section-{{ section.id }} .container-full .cont-area{
            left: 60px;
            right: 60px;
        }
    }

</style>

<section class="section-{{ section.id }}" data-section-id="{{ section.id }}" id="{{ section.id }}">
    <div class="container-full">
        {% if section.settings.sectionImage != blank or section.settings.sectionImage_mb != blank %}
            {% liquid
                assign pc_ratio = 1 | divided_by: section.settings.sectionImage.aspect_ratio | times: 100
                if section.settings.sectionImage.presentation.focal_point != '50.0% 50.0%'
                    assign pc_ratio = pc_ratio | times: 1.2
                endif

                assign mb_ratio = 1 | divided_by: section.settings.sectionImage_mb.aspect_ratio | times: 100
                if section.settings.sectionImage_mb.presentation.focal_point != '50.0% 50.0%'
                    assign mb_ratio = mb_ratio | times: 1.2
                endif
            %}

            <div class="large-image-cont">
                <div class="large-image large-image-responsive" style="--pc-ratio: {{ pc_ratio }}%;--mb-ratio: {{ mb_ratio }}%;">
                    <picture>
                        <source media="(max-width: 768px)"
                                srcset="{{ section.settings.sectionImage_mb | image_url: width: 800 }}"
                                data-srcset="{{ section.settings.sectionImage_mb | image_url: width: 800 }}">

                        <img {% render 'lazyload',preview_img: section.settings.sectionImage, class: true, enable_rtl: settings.enable_layout_rtl  %}
                            width="{{ section.settings.sectionImage.width }}"
                            height="{{ section.settings.sectionImage.height }}"
                            alt="{{ section.settings.sectionImage.alt | escape }}"
                            loading="lazy"
                            decoding="async"
                            style="height: auto;"/>
                    </picture>
                </div>
            </div>
        {% endif %}

        <div class="cont-area">
            <div class="cont-area-left">
                {% if section.settings.sectionTitle != blank %}
                    <h1 class="cont-area-title">{{ section.settings.sectionTitle }}</h1>
                {% endif %}
                {% if section.settings.sectionDesc != blank %}
                    <div class="cont-area-desc">{{ section.settings.sectionDesc }}</div>
                {% endif %}
                {% if section.settings.sectionButton != blank %}
                    <a class="cont-area-btn" {% if section.settings.sectionLink != blank %} href="{{ section.settings.sectionLink }}" {% else %} aria-disabled="true" {% endif %}>{{ section.settings.sectionButton }}</a>
                {% endif %}
            </div>
            <div class="cont-area-right">
                {% for block in section.blocks %}
                    {% if block.type == "smallImage" %}
                        <picture class="small-image">
                            {% if block.settings.smallItemImage_mb %}
                                <source 
                                    media="(max-width: 768px)"
                                    data-srcset="{{ section.settings.smallItemImage_mb | image_url: width: 800 }}"
                                    width="{{ block.settings.smallItemImage_mb.width }}"
                                    height="{{ block.settings.smallItemImage_mb.height }}">
                            {% endif %}

                            <img {% render 'lazyload',preview_img: block.settings.smallItemImage, class: true, enable_rtl: settings.enable_layout_rtl  %}
                                width="{{ block.settings.smallItemImage.width }}"
                                height="{{ block.settings.smallItemImage.height }}"
                                alt="{{ block.settings.smallItemImage.alt }}"
                                loading="lazy"
                                decoding="async"
                                style="height: auto;">
                        </picture>

                    {% endif %}
                {% endfor %}
            </div>
            
        </div>
        
        
    </div>
</section>

{% schema %}
{
    "name": "Events Banner",
    "settings": [
        {
            "type": "image_picker",
            "id": "sectionImage",
            "label": "section Image"
        },
        {
            "type": "image_picker",
            "id": "sectionImage_mb",
            "label": "section Image Mobile"
        },
        {
            "type": "text",
            "id": "sectionTitle",
            "label": "section Title",
            "default": "Blacklyte Events & Collaborations"
        },
        {
            "type": "text",
            "id": "sectionDesc",
            "label": "section Descripe",
            "default": "Explore our journey across esports tournaments, team partnerships, and exclusive product drops."
        },
        {
            "type": "text",
            "id": "sectionButton",
            "label": "section Button",
            "default": "Explore Collab Chairs"
        },
        {
            "type": "url",
            "id": "sectionLink",
            "label": "section Link"
        }
    ],
    "blocks": [
        {
            "type": "smallImage",
            "name": "smallImage",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "smallItemImage",
                    "label": "small Item Image"        
                },
                {
                    "type": "image_picker",
                    "id": "smallItemImage_mb",
                    "label": "small Item Image Mobile"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Events Banner"
        }
    ]
}
{% endschema %}