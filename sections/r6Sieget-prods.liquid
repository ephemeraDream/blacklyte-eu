<style>
  .section-{{ section.id }}{
      padding-top: 60px;
      padding-bottom: 70px;
  }
  .section-{{ section.id }} .container-full{
      padding-left: 16%;
      padding-right: 16%;
  }

  .section-{{ section.id }} .container-full .product-collection{
      display: flex;
      gap: 200px;
  }

  .section-{{ section.id }} .container-full .product-collection .left-cont,
  .section-{{ section.id }} .container-full .product-collection .right-cont{
      display: flex;
      flex-direction: column;
      width: calc((100% - 200px) / 2);
  }
  .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image{
      height: 50vh;
  }
  .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image img{
      height: 100%;
      width: auto;
      margin: auto;
      transform: translateY(20px);
  }
  .section-{{ section.id }} .container-full .product-collection .cont-title{
      font: 700 26px 'DIN';
      flex: 1;
  }
  .section-{{ section.id }} .container-full .product-collection .left-cont .cont-title{
      color: #3582E4;
  }
  .section-{{ section.id }} .container-full .product-collection .right-cont .cont-title{
      color: #FDDA6F;
  }
  {% comment %} .section-{{ section.id }} .container-full .product-collection .right-cont .cont-title{
      text-align: right;
  } {% endcomment %}
  .section-{{ section.id }} .container-full .product-collection .cont-desc{
      font: 500 16px 'DIN';
      color: #fff;
      margin-top: 10px;
  }
  {% comment %} .section-{{ section.id }} .container-full .product-collection .right-cont .cont-desc{
      text-align: right;
  }  {% endcomment %}
  .section-{{ section.id }} .container-full .product-collection .cont-button{
      font: 700 20px 'DIN';
      color: #fff;
      padding: 16px 36px;
      width: fit-content;
      white-space: nowrap;
      margin-top: 24px;
      border-radius: 100px;
      transition: all .35s ease;
  }

  .section-{{ section.id }} .container-full .product-collection .left-cont .cont-button{
      background: linear-gradient(90deg, #0B68DE 0%, #063878 100%);
  }
  .section-{{ section.id }} .container-full .product-collection .left-cont .cont-button:hover{
      background: linear-gradient(90deg, #0068ED 0%, #0068ED 100%);
  }
  .section-{{ section.id }} .container-full .product-collection .right-cont .cont-button{
      background: linear-gradient(90deg, #BEA24C 6.08%, #544311 89.95%);
  }
  .section-{{ section.id }} .container-full .product-collection .right-cont .cont-button:hover{
      background: linear-gradient(90deg, #BEA24C 6.08%, #BEA24C 89.95%);
  }

  {% comment %} .section-{{ section.id }} .container-full .product-collection .right-cont .cont-button{
      margin-left: auto;
  } {% endcomment %}
  .section-{{ section.id }} .container-full .prods-collection-features img{
      height: auto;
  }
  .section-{{ section.id }} .container-full .prods-collection-features-mb{
      display: none;
  }

  {% comment %} iPhone {% endcomment %}
  @media(max-width: 767px){
      .section-{{ section.id }} {
          padding-top: 50px;
          padding-bottom: 20px;
      }
      .section-{{ section.id }} .container-full{
          padding-left: 10px;
          padding-right: 10px;
      }
      .section-{{ section.id }} .container-full .product-collection{
          gap: 50px;
          flex-direction: column;
      }
      .section-{{ section.id }} .container-full .product-collection .left-cont,
      .section-{{ section.id }} .container-full .product-collection .right-cont{
          width: 100%;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-title{
          font-size: 25px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-desc {
          font-size: 18px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-button{
          font-size: 14px;
          padding: 10px 30px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image{
          height: auto;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image img{
          width: 80%;
          margin: auto;
      }
      .section-{{ section.id }} .container-full .prods-collection-features{
          display: none;
      }
      .section-{{ section.id }} .container-full .prods-collection-features-mb{
          display: block;
      }
      .section-{{ section.id }} .container-full .prods-collection-features-mb svg{
          width: 100%;
          height: auto;
      }
      .section-{{ section.id }} .container-full .product-collection .right-cont .cont-title,
      .section-{{ section.id }} .container-full .product-collection .right-cont .cont-desc{
          text-align: left;
      }
      .section-{{ section.id }} .container-full .product-collection .right-cont .cont-button{
          margin-left: initial;
      }
  }

  {% comment %} iPad {% endcomment %}
  @media(min-width: 768px) and (max-width: 1024px){
      .section-{{ section.id }} .container-full{
          padding-left: 10px;
          padding-right: 10px;
      }
      .section-{{ section.id }} .container-full .product-collection{
          gap: 100px;
      }
      .section-{{ section.id }} .container-full .product-collection .left-cont,
      .section-{{ section.id }} .container-full .product-collection .right-cont{
          width: calc((100% - 100px) / 2);
      }
      .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image{
          height: auto;
      }
  }

  {% comment %} small screen {% endcomment %}
  @media(min-width: 1025px) and (max-width: 1480px){
      .section-{{ section.id }} .container-full{
          padding-left: 60px;
          padding-right: 60px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-title{
          font-size: 30px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-desc{
          font-size: 20px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-button{
          font-size: 24px;
          padding: 12px 30px;
      }
      {% comment %} .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image{
          height: auto;
      } {% endcomment %}
  }

  @media(min-width: 2000px){
      .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image{
          height: 900px;
      }
  }
</style>

<section class="section-{{ section.id }}" id="{{ section.id }}" data-section-id="{{ section.id }}">
  {%- liquid
    assign bgImage = section.settings.webBgImage
    assign bgImageMb = section.settings.MobileBgImage
  -%}

  <style>
    .section-{{ section.id }} {
        background-image: url({{ bgImage | img_url: 'master' }});
        background-size: cover;
        background-position: bottom;
        background-repeat: no-repeat;
    }

    @media (max-width: 767px) {
        .section-{{ section.id }} {
            background-image: url({{ bgImageMb | img_url: 'master' }});
        }
    }
  </style>
  <div class="container-full">
    <div class="product-collection">
      {% for block in section.blocks %}
        {% if block.type == 'prodItemLeft' %}
          <div class="left-cont">
            <div class="cont-title">{{ block.settings.prodTitle }}</div>
            <div class="cont-desc">{{ block.settings.prodDesc }}</div>
            <a
              class="cont-button"
              {% if block.settings.productUrl != blank %}
                href="{{ block.settings.productUrl }}"
              {% endif %}
            >
              {{- block.settings.prodBtn -}}
            </a>
            <a href="{{ block.settings.productUrl }}" class="cont-prod-featured-image">
              {% if block.settings.prodMainImage != blank %}
                <img
                  src="{{ block.settings.prodMainImage | img_url: 'master' }}"
                  width="{{ block.settings.prodMainImage.width }}"
                  height="{{ block.settings.prodMainImage.height }}"
                  alt="{{ block.settings.prodMainImage.alt }}"
                >
              {% else %}
                <img src="{{ block.settings.product.selected_or_first_available_variant.featured_image | img_url: 'master' }}">
              {% endif %}
            </a>
          </div>
        {% endif %}
      {% endfor %}

      {% for block in section.blocks %}
        {% if block.type == 'prodItemRight' %}
          <div class="right-cont">
            <div class="cont-title">{{ block.settings.prodTitle }}</div>
            <div class="cont-desc">{{ block.settings.prodDesc }}</div>
            {% if block.settings.prodBtn != blank %}
              <a
                class="cont-button"
                {% if block.settings.productUrl != blank %}
                  href="{{ block.settings.productUrl }}"
                {% endif %}
              >
                {{- block.settings.prodBtn -}}
              </a>
            {% endif %}
            <a
              {% if block.settings.product != blank %}
                href="{{ block.settings.productUrl }}"
              {% else %}
                aria-disabled="true"
              {% endif %}
              class="cont-prod-featured-image"
            >
              {% if block.settings.prodMainImage != blank %}
                <img
                  src="{{ block.settings.prodMainImage | img_url: 'master' }}"
                  width="{{ block.settings.prodMainImage.width }}"
                  height="{{ block.settings.prodMainImage.height }}"
                  alt="{{ block.settings.prodMainImage.alt }}"
                >
              {% else %}
                <img src="{{ block.settings.product.selected_or_first_available_variant.featured_image | img_url: 'master' }}">
              {% endif %}
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.prodFeatures != blank %}
      <div class="prods-collection-features">
        <img
          src="{{ section.settings.prodFeatures | img_url: 'master' }}"
          width="{{ section.settings.prodFeatures.width }}"
          height="{{ section.settings.prodFeatures.height }}"
          alt="{{ section.settings.prodFeatures.alt }}"
        >
      </div>
