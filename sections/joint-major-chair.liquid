{{ 'section-joint-major-chair.css' | asset_url | stylesheet_tag }}

<style>
  .major_chair {
    background: url('{{ section.settings.background_img | image_url }}') no-repeat;
    background-size: cover;
    background-position: center center;
    margin-top: -1px;
  }
  @media screen and (max-width: 1000px) {
    .major_chair {
      background: url('{{ section.settings.background_img_mobile | image_url }}') no-repeat;
    }
  }
</style>

<div class="major_chair">
  <div class="major_chair_title">{{ section.settings.title }}</div>
  <div class="major_chair_contain">
    {{-
      section.settings.chair_image
      | image_url: width: section.settings.chair_image.width
      | image_tag: alt: section.settings.title, class: 'major_chair_contain_image'
    -}}
    <div class="major_chair_contain_right">
      {% for block in section.blocks %}
        <div class="major_chair_contain_item">
          <div class="major_chair_contain_item_title">{{ block.settings.title }}</div>
          <div class="major_chair_contain_item_text">{{ block.settings.description }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="major_chair_filebox">
    {% for block in section.blocks %}
      <div class="major_chair_filebox_item">
        {{-
          block.settings.file_image
          | image_url: width: block.settings.file_image.width
          | image_tag: alt: block.settings.title, class: 'major_chair_filebox_image'
        -}}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "major chair",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "description"
    },
    {
      "type": "image_picker",
      "id": "background_img",
      "label": "background image"
    },
    {
      "type": "image_picker",
      "id": "background_img_mobile",
      "label": "background image mobile"
    },
    {
      "type": "image_picker",
      "id": "chair_image",
      "label": "chair image"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "title"
        },
        {
          "type": "text",
          "id": "sub_title",
          "label": "sub title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "description"
        },
        {
          "type": "image_picker",
          "id": "file_image",
          "label": "file image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "major chair"
    }
  ]
}
{% endschema %}
