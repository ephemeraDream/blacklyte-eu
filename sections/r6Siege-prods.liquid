<style>
    .section-{{ section.id }}{
        padding-top: 100px;
        padding-bottom: 0;
        overflow: hidden;
    }
    .section-{{ section.id }} .container-full{
        padding-left: 16%;
        padding-right: 16%;
        padding-bottom: 140px;
        position: relative;
    }

    .section-{{ section.id }} .container-full .container-sticky-image{
        width: 100%;
        max-height: 50px;
        position: absolute;
        bottom: 0;
        left: 0;
    }
    .section-{{ section.id }} .container-full .container-sticky-image img{
        width: 100%;
        height: auto;
    }
    .section-{{ section.id }} .btn-item-dot{
        cursor: pointer;
    }
    
    .section-{{ section.id }} .btn-item-dot svg{
        width: 100%;
        height: auto;
    }
    .section-{{ section.id }} .btn-item-dot span{
        width: 100%;
        max-width: 100%;
    }

    .section-{{ section.id }} .btn-item-dot.btn-item-dot-active .static-svg,
    .section-{{ section.id }} .btn-item-dot .active-svg{
        display: none;
    }
    .section-{{ section.id }} .btn-item-dot.btn-item-dot-active .active-svg{
        display: block;
    }

    .section-{{ section.id }} .head-container{
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        text-align: center;
    }
    .section-{{ section.id }} .head-container .title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 40px;
        leading-trim: NONE;
        line-height: 30px;
        letter-spacing: 0%;
        text-align: center;
        text-transform: uppercase;
        color: #8D959E;
    }

    .section-{{ section.id }} .head-container .sub-title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 24px;
        line-height: 30px;
        letter-spacing: 40%;
        text-align: center;
        text-transform: uppercase;
        color: #8D959E;
    }
    .section-{{ section.id }} .head-container .descripetion{
        font-family: Poppins;
        font-weight: 400;
        font-style: Regular;
        font-size: 20px;
        leading-trim: NONE;
        line-height: 120%;
        letter-spacing: 0%;
        color: #8D959E;
        margin-top: 22px;
    }
    .section-{{ section.id }} .swiper-pagination-cont{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 38px;
        margin-top: 40px;
    }
    .section-{{ section.id }} .swiper-pagination-cont .swiper-pre-icon svg,
    .section-{{ section.id }} .swiper-pagination-cont .swiper-next-icon svg{
        width: 190px;
        height: auto;
    }
    .section-{{ section.id }} .btn-item-dot img{
        height: auto;
    }
    
    .section-{{ section.id }} .prod-item{
        display: flex;
        gap: 40px;
        justify-content: space-between;
    }
    .section-{{ section.id }} .prod-item-left{
        padding: 0 10px;
        width: calc(42% - 20px);
    }
    
    .section-{{ section.id }} .prod-item-right{
        width: calc(58% - 20px);
        display: flex;
        align-items: flex-end;
    }

    .section-{{ section.id }} .prod-item-right img{
        height: auto;
    }
    .section-{{ section.id }} .prod-item-right .prod-item-right-imgs{
        position: relative;
    }
    .section-{{ section.id }} .prod-item-right .rih-img{
        transform: translate(-10%);
        transition: all .5s ease;
    }
    
    .section-{{ section.id }} .prod-item-right .rih-img.rih-img-active{
        opacity: 1;
        transform: translate(0);
        position: absolute;
        top: 0;
    }
    .section-{{ section.id }} .prod-item-right .rih-img.rih-img-hidden{
        opacity: 0;
        position: relative;
    }
    .section-{{ section.id }} .prod-sub-title{
        font-family: DIN;
        font-weight: 500;
        font-style: Medium;
        font-size: 20px;
        line-height: normal;
        letter-spacing: 0%;
        color: #fff;
    }
    .section-{{ section.id }} .prod-title,
    .section-{{ section.id }} .prod-10th-title{
        font-family: Poppins;
        font-weight: 700;
        font-style: Bold;
        font-size: 40px;
        line-height: 52px;
        letter-spacing: 0%;
        color: #E73C24;
        margin-top: 10px;
        transition: all .35s ease;
    }

    .section-{{ section.id }} .prod-10th-title{
        color: #BE9F6C;
    }

    .section-liquid-prods .prod-10th-title,
    .section-liquid-prods.section-r6Siege-10thEdition .prod-title{
        opacity: 0;
        transform: translateX(-100px);
        height: 0;
    }

    .section-liquid-prods .prod-title,
    .section-liquid-prods.section-r6Siege-10thEdition .prod-10th-title{
        opacity: 1;
        transform: translateX(0px);
        height: auto;
    }
    .section-liquid-prods .prod-desc,
    .section-liquid-prods .prod-10th-desc{
        font-family: Poppins;
        font-weight: 400;
        font-size: 16px;
        line-height: 1.4;
        letter-spacing: 0%;
        margin-top: 14px;
        color: #8D959E;
    }

    .section-liquid-prods .prod-10th-desc,
    .section-liquid-prods.section-r6Siege-10thEdition .prod-desc{
        opacity: 0;
        transform: translateX(-100px);
        height: 0;
    }

    .section-liquid-prods .prod-desc,
    .section-liquid-prods.section-r6Siege-10thEdition .prod-10th-desc{
        opacity: 1;
        transform: translateX(0px);
        height: auto;
    }


    .section-{{ section.id }} .feature-list{
        display: flex;
        gap: 18px;
        margin-top: 13px;

    }
    .section-{{ section.id }} .feature-list .feature-item{
        width: calc((100% - 54px) / 4);
        cursor: pointer;
        position: relative;
        
    }

    .section-{{ section.id }} .feature-item svg{
        width: 100%;
        height: auto;
    }

    .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active{ }
    .section-{{ section.id }} .prod-item-left-1 .feature-list .feature-item.feature-item-active{ }

    .section-{{ section.id }} .feature-list .feature-item img{
        height: auto;
    }
    .section-{{ section.id }} .feature-svg{
        font-family: Poppins;
        font-weight: 300;
        font-style: Light;
        font-size: 16px;
        leading-trim: NONE;
        line-height: 120%;
        letter-spacing: 0%;
        text-align: center;
        color: #8D959E;
        text-align: left;
        margin-top: 50px;
    }
   
    .section-{{ section.id }} .feature-btn{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 18px;
        letter-spacing: 0%;
        text-align: center;
        text-transform: uppercase;
        display: inline-block;
        width: 100%;
        letter-spacing: 0%;
        color: #fff;
        border-radius: 4px;
        margin-top: 46px;
        padding: 16px 0;
        line-height: normal;
        border: 1px solid #E73C24;
        border-bottom-width: 4px;
        color: #E73C24;
        transition: all .35s ease;
    }


    .section-{{ section.id }} .feature-btn-1{
        display: none;
    }

    .section-{{ section.id }} .prod-item-left-0 .feature-btn-1,
    .section-{{ section.id }} .prod-item-left-1 .feature-btn-0{
        display: none;
    }

    .section-{{ section.id }} .prod-item-left-0 .feature-btn-0,
    .section-{{ section.id }} .prod-item-left-1 .feature-btn-1{
        display: block;
    }
   
    .section-{{ section.id }} .feature-btn-1{
        border-color: #BE9F6C;
        color: #BE9F6C;
    }

    .section-{{ section.id }} .feature-list .feature-item .prod-feature-descont{
        position: absolute;
        padding: 20px 22px 22px 18px;
        background: #fff;
        left: 0;
        width: 330px;
        top: calc(100% + 10px);
        border-radius: 5px;
        opacity: 0;
        z-index: -1;
        transition: opacity 0.3s ease;
    }
    .section-{{ section.id }} .feature-list .feature-item .prod-feature-descont.active{
        opacity: 1;
        z-index: 2;
    }
    .prod-feature-descont::before {
        content: '';
        position: absolute;
        top: -18px;
        left: 20px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 10px; 
        border-color: transparent transparent #ffffff transparent;
    }
    .section-{{ section.id }} .feature-item .title-text,
    .section-{{ section.id }} .feature-item .sub-title-text{
        font-family: Poppins;
        font-weight: 600;
        font-style: SemiBold;
        font-size: 12px;
        line-height: 1.2;
        letter-spacing: 0%;
        color: #262629;
    }
    .section-{{ section.id }} .feature-item .sub-title-text{
        margin-top: 6px;
    }
    .section-{{ section.id }} .feature-item .line-center{
        display: block;
        width: 100%;
        height: 1px;
        background: #E5E5E5;
        margin: 10px 0;
    }
    .section-{{ section.id }} .feature-item .desc-text{
        font-family: Poppins;
        font-weight: 500;
        font-size: 12px;
        line-height: 1.5;
        letter-spacing: 0%;
        color: #8D959E;
    }

    .section-liquid-prods .feature-item.feature-item-active svg path{
        stroke: #E73C24;
    }
    .section-liquid-prods.section-r6Siege-10thEdition .feature-item.feature-item-active svg path{
        stroke: #BE9F6C;
    }
    
    .section-liquid-prods .feature-btn:hover{
        box-shadow: 0 0 20px #e73c24;
    }

    .section-liquid-prods.section-r6Siege-10thEdition .feature-btn:hover{
        box-shadow: 0 0 20px #BE9F6C;
    }

    @media(max-width: 767px){
        .section-{{ section.id }} {
            padding-top: 50px;
            padding-bottom: 0;
        }
        .section-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
            padding-bottom: 0;
        }
        .section-{{ section.id }} .head-container .title,
        .section-{{ section.id }} .head-container .sub-title{
            font-size: 20px;
        }

        .section-{{ section.id }} .head-container .descripetion{
            font-size: 16px;
            margin-top: 10px;
        }
       
        .section-{{ section.id }} .swiper-pagination-cont{
            gap: 20px;
            margin-top: 15px;
        }
        
        .section-{{ section.id }} .prod-item{
            flex-direction: column-reverse;
            padding-bottom: 90px;
            gap: 0;
        }
        .section-{{ section.id }} .prod-sub-title{
            font-size: 14px;
        }
        .section-{{ section.id }} .prod-title,
        .section-{{ section.id }} .prod-10th-title{
            font-size: 26px;
            line-height: normal;
        }
        .section-{{ section.id }} .prod-desc,
        .section-liquid-prods .prod-10th-desc{
            font-size: 18px;
            margin-top: 0;
        }
        .section-{{ section.id }} .feature-svg{
            font-size: 16px;
            line-height: 1.2;
            margin-top: 22px;
        }
        .section-{{ section.id }} .feature-list{
            gap: 10px;
            margin-top: 20px;
        }
        .section-{{ section.id }} .feature-list .feature-item{
            width: calc((100% - 30px) / 4);
        }
        .section-{{ section.id }} .feature-btn{
            font-size: 18px;
            margin-top: 30px;
            padding: 10px 0;
        }
        .section-{{ section.id }} .feature-list .feature-item .prod-feature-descont{
            width: 280px;
            top: auto;
            bottom: calc(100% + 10px);
        }  
        .prod-feature-descont::before{
            border-width: 5px;
            top: auto;
            left: 10px;
            bottom: -9px;
            transform: rotate(180deg);
        }
        .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active:nth-of-type(2) .prod-feature-descont.active{
            transform: translateX(-80px);
        }
        .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active:nth-of-type(2) .prod-feature-descont::before{
            left: 40%;
        }
        .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active:nth-of-type(4) .prod-feature-descont.active{
            transform: translateX(-200px);
        }
        .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active:nth-of-type(3) .prod-feature-descont.active{
            transform: translateX(-140px);
        }
        .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active:nth-of-type(3) .prod-feature-descont::before{
            left: 55%;
        }
        .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active:nth-of-type(4) .prod-feature-descont::before{
            right: 20px;
            left: auto;
        }
        .section-{{ section.id }} .feature-item .title-text,
        .section-{{ section.id }} .feature-item .sub-title-text{
            font-size: 8px;
        }
        .section-{{ section.id }} .feature-item .line-center{
            margin: 5px 0;
        }  
        .section-{{ section.id }} .feature-item .desc-text{
            font-size: 9px;
        }
        
        .section-{{ section.id }} .prod-item-left,
        .section-{{ section.id }} .prod-item-right{
            width: 100%;
        }

        .section-{{ section.id }} .btn-item-dot span{
            display: block;
            width: 50px;
        }

        .section-{{ section.id }} .swiper-pagination-cont .swiper-pre-icon svg,
        .section-{{ section.id }} .swiper-pagination-cont .swiper-next-icon svg{
            width: 80px;
        }

        .section-{{ section.id }} .prod-list{
            margin-top: 30px;
        }

    }

     {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-{{ section.id }}{
            padding-top: 50px;
            padding-bottom: 50px;
        }
        .section-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
            
        }
        .section-{{ section.id }} .prod-sub-title{
            font-size: 16px;
        }
        .section-{{ section.id }} .prod-title,
        .section-{{ section.id }} .prod-10th-title{
            font-size: 30px;
            line-height: 1.2;
        }
        .section-{{ section.id }} .prod-desc{
            font-size: 12px;
        }
        .section-{{ section.id }} .feature-list{
            gap: 10px;
        }
        .section-{{ section.id }} .feature-btn{
            width: 94%;
            font-size: 20px;
            padding: 10px 0;
            margin-top: 30px;
        }

        .section-{{ section.id }} .prod-list{
            margin-top: 30px;
        }
        
    }

    {% comment %} small screen {% endcomment %}
    @media(min-width: 1025px) and (max-width: 1480px){
        .section-{{ section.id }} .container-full{
            padding-left: 60px;
            padding-right: 60px;
        }
        
    }

</style>

<div class="section-{{ section.id }} section-liquid-prods" id="{{ section.id }}" data-section-id="{{ section.id }}">
    {%- liquid
        assign bg_image = section.settings.sectionBgImage
        assign bg_image_mb = section.settings.sectionBgImage_mb
        assign section_bg_image_sec = section.settings.sectionBgImageSec
        assign section_bg_image_sec_mb = section.settings.sectionBgImageSec_mb
    -%}

    <style>
        .section-liquid-prods {
            background-color: #00050E;
            background-image: url({{ bg_image | image_url: width: 1920 }});
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .section-liquid-prods.section-r6Siege-10thEdition {
            background-image: url({{ section_bg_image_sec | image_url: width: 1920 }})
        }

        @media (max-width: 767px){
            .section-liquid-prods {
                background-image: url({{ bg_image_mb | image_url: width: 768 }});
            }
            .section-liquid-prods.section-r6Siege-10thEdition {
                background-image: url({{ section_bg_image_sec_mb | image_url: width: 768 }})
            }
        }



    </style>
    <div class="container-full">
        <div class="head-container">
            {% if section.settings.sectionTitle != blank %}
                <div class="title">{{ section.settings.sectionTitle }}</div>
            {% endif %}
            
            {% if section.settings.sectionSubTitle != blank %}
                <div class="sub-title">{{ section.settings.sectionSubTitle }}</div>
            {% endif %}
            
            {% if section.settings.sectionDesc != blank %}
                <div class="descripetion">{{ section.settings.sectionDesc }}</div>
            {% endif %}
            
        </div>
    
        {% comment %} 自定义swiper pagination {% endcomment %}
        <div class="swiper-pagination-cont">
            <span class="swiper-pre-icon">
                <svg width="190" height="2" viewBox="0 0 190 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M189.5 1H0" stroke="url(#paint0_linear_16451_33363)" stroke-width="2"/>
                    <defs>
                    <linearGradient id="paint0_linear_16451_33363" x1="189.5" y1="1.5" x2="0" y2="1.5" gradientUnits="userSpaceOnUse">
                    <stop stop-color="white" stop-opacity="0.5"/>
                    <stop offset="1" stop-color="#05080E"/>
                    </linearGradient>
                    </defs>
                </svg>

            </span>
            {% for block in section.blocks %}
                {% if block.type == "itemBtn" %}
                    <div class="btn-item-dot">
                        {% if block.settings.itemBtnSvg != blank %}
                            <span class="static-svg">{{ block.settings.itemBtnSvg }}</span>
                            <span class="active-svg">{{ block.settings.itemBtnSvgActive }}</span>
                        {% else %}
                        <img class="static-imag" src="{{ block.settings.itemBtnImage | image_url: width: 160 }}"
                            width="{{ block.settings.itemBtnImage.width }}"
                            height="{{ block.settings.itemBtnImage.height }}"
                            alt="{{ block.settings.itemBtnImage.alt }}" />
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
            <span class="swiper-next-icon">
                <svg width="190" height="2" viewBox="0 0 190 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 1H189.5" stroke="url(#paint0_linear_16451_33362)" stroke-width="2"/>
                    <defs>
                    <linearGradient id="paint0_linear_16451_33362" x1="0" y1="1.5" x2="189.5" y2="1.5" gradientUnits="userSpaceOnUse">
                    <stop stop-color="white" stop-opacity="0.5"/>
                    <stop offset="1" stop-color="#05080E"/>
                    </linearGradient>
                    </defs>
                </svg>

            </span>
        </div>
        <div class="prod-list">
            {% for block in section.blocks %}
                {% if block.type == 'itemProd' %}
                    <div class="prod-item">
                        {% assign product = block.settings.product_item %}
                        {% assign product_item = block.settings['product_item_1'] %}
                        <div class="prod-item-left">
                            <div class="prod-head">
                                {% if block.settings.prod_sub_title != blank %}
                                    <div class="prod-sub-title">{{ block.settings.prod_sub_title }}</div>
                                {% endif %}

                                {% if block.settings.prod_title != blank or block.settings.prod_title-next != blank %}
                                    <div class="prod-title">
                                        {{ block.settings.prod_title }}
                                        <br />
                                        {{ block.settings.prod_title-cap }}
                                    </div>
                                    <div class="prod-10th-title">
                                        {{ block.settings.prod_title-next }}
                                        <br />
                                        {{ block.settings.prod_title-next-cap }}
                                    </div>
                                {% endif %}
                                
                                {% if block.settings.prod_desc != blank or block.settings.prod_desc_cap != blank %}
                                    <div class="prod-desc">{{ block.settings.prod_desc }}</div>
                                    <div class="prod-10th-desc">{{ block.settings.prod_desc_cap }}</div>
                                {% endif %}
                                
                            </div>
                            <div class="feature-svg">
                                {{ block.settings.prod_feature_title }}
                            </div>
                            <div class="feature-list">
                                <div class="feature-item">
                                    <span>{{ block.settings.prod_feature-0-svg }}</span>
                                    
                                    {% if block.settings.prod_feature-0-title != blank or block.settings.prod_feature-0-desc != blank %}
                                        <div class="prod-feature-descont">
                                            <div class="title-text">{{ block.settings.prod_feature-0-title }}</div>
                                            <div class="sub-title-text">{{ block.settings.prod_feature-0-sub-title }}</div>
                                            <div class="line-center"></div>
                                            <div class="desc-text">{{ block.settings.prod_feature-0-desc }}</div>
                                        </div>
                                    {% endif %}

                                </div>
                                <div class="feature-item">
                                    <span>{{ block.settings.prod_feature-1-svg }}</span>
                                    
                                    {% if block.settings.prod_feature-1-title != blank or block.settings.prod_feature-1-desc != blank %}
                                        <div class="prod-feature-descont">
                                            <div class="title-text">{{ block.settings.prod_feature-1-title }}</div>
                                            <div class="sub-title-text">{{ block.settings.prod_feature-1-sub-title }}</div>
                                            <div class="line-center"></div>
                                            <div class="desc-text">{{ block.settings.prod_feature-1-desc }}</div>
                                        </div>
                                    {% endif %}

                                </div>
                                <div class="feature-item">
                                    <span>{{ block.settings.prod_feature-2-svg }}</span>
                                    
                                    {% if block.settings.prod_feature-2-title != blank or block.settings.prod_feature-2-desc != blank %}
                                        <div class="prod-feature-descont">
                                            <div class="title-text">{{ block.settings.prod_feature-2-title }}</div>
                                            <div class="sub-title-text">{{ block.settings.prod_feature-2-sub-title }}</div>
                                            <div class="line-center"></div>
                                            <div class="desc-text">{{ block.settings.prod_feature-2-desc }}</div>
                                        </div>
                                    {% endif %}

                                </div>
                                <div class="feature-item">
                                    <span>{{ block.settings.prod_feature-3-svg }}</span>
                                    
                                    {% if block.settings.prod_feature-3-title != blank or block.settings.prod_feature-3-desc != blank %}
                                        <div class="prod-feature-descont">
                                            <div class="title-text">{{ block.settings.prod_feature-3-title }}</div>
                                            <div class="sub-title-text">{{ block.settings.prod_feature-3-sub-title }}</div>
                                            <div class="line-center"></div>
                                            <div class="desc-text">{{ block.settings.prod_feature-3-desc }}</div>
                                        </div>
                                    {% endif %}

                                </div>
                            </div>
                            <a href="{{ product.url }}" class="feature-btn feature-btn-0">{{ block.settings.button }}</a>
                            <a href="{{ product_item.url }}" class="feature-btn feature-btn-1">{{ block.settings.button }}</a>
                        </div>
                        <div class="prod-item-right">
                            <div class="prod-item-right-imgs">
                                <div class="rih-img rih-img-active">
                                    <img src="{{ block.settings.prod_image | image_url: width: 1400 }}"
                                        width="{{ block.settings.prod_image.width }}"
                                        height="{{ block.settings.prod_image.height }}"
                                        alt="{{ block.settings.prod_image.alt }}" />
                                </div>
                                <div class="rih-img rih-img-hidden">
                                    <img src="{{ block.settings.prod_image_1 | image_url: width: 1400 }}"
                                        width="{{ block.settings.prod_image_1.width }}"
                                        height="{{ block.settings.prod_image_1.height }}"
                                        alt="{{ block.settings.prod_image_1.alt }}" />
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% comment %} bottom svg {% endcomment %}
        <div class="container-sticky-image">
            <img src="{{ section.settings.containerBottomImage | image_url: width: 1400 }}"
                width="{{ section.settings.containerBottomImage.width }}"
                height="{{ section.settings.containerBottomImage.height }}"
                alt="{{ section.settings.containerBottomImage.alt }}" />

        </div>
    </div>
    {% comment %} sticky container {% endcomment %}
    {% if section.settings.stickyProduct != blank %}
        {% render 'product-sticky', section: section %}
    {% endif %}
</div>

<script>
    const btnItems = document.querySelectorAll('.btn-item-dot');

    const section = document.querySelector('.section-liquid-prods');

    const prodItemLeft = document.querySelectorAll('.prod-item-left')

    if (btnItems.length > 0) {
        btnItems[0].classList.add('btn-item-dot-active');
    }

    btnItems.forEach(function(item, index) {
        item.addEventListener('click', function() {
            const rihImgs = document.querySelectorAll('.prod-item-right .rih-img');
            
            
            rihImgs.forEach(function(img, imgIndex) {
                if (imgIndex === index) {
                    img.classList.add('rih-img-active');
                    img.classList.remove('rih-img-hidden');
                } else {
                    img.classList.add('rih-img-hidden');
                    img.classList.remove('rih-img-active');
                }
            });

           
            if(index == 0){
                section.classList.remove('section-r6Siege-10thEdition')

            } else {
                section.classList.add('section-r6Siege-10thEdition')

            }
            
            btnItems.forEach(function(item) {
                item.classList.remove('btn-item-dot-active');
            });
            
            btnItems[index].classList.add('btn-item-dot-active');
            
            prodItemLeft.forEach(function(itemLeft) {
                
                itemLeft.classList.forEach(function(className) {
                    if (className.startsWith('prod-item-left-')) {
                        itemLeft.classList.remove(className);
                    }
                });

                
                itemLeft.classList.add('prod-item-left-' + index);
            });

            const prodVariant = document.querySelectorAll('.sticky-dom-chair .prod-info .left-cont .prod-img .sticky_prod_variant_image')
            prodVariant.forEach(function(item, itemIndex){
                if(itemIndex == index){
                    item.classList.add('sticky_prod_variant_image_active');
                    item.classList.remove('sticky_prod_variant_image_hidden');
                }else{
                    item.classList.remove('sticky_prod_variant_image_active');
                    item.classList.add('sticky_prod_variant_image_hidden');
                }
            })
            
        });
    });

    document.querySelectorAll('.feature-list .feature-item').forEach(function(item) {

            const isMobile = window.matchMedia("only screen and (max-width: 768px)").matches;
           
            function handleMouseOver() {
                if (item.classList.contains('feature-item-active')) {
                    item.classList.remove('feature-item-active');
                } else {
                    document.querySelectorAll('.feature-list .feature-item').forEach(function(featureItem) {
                        featureItem.classList.remove('feature-item-active');
                    });
                    item.classList.add('feature-item-active');
                }

                var target = item.querySelector('.prod-feature-descont');
                if (!target) return;

                if (target.classList.contains('active')) {
                    target.classList.remove('active');
                    return;
                }

                document.querySelectorAll('.prod-feature-descont.active').forEach(function(desc){
                    desc.classList.remove('active');
                });

                target.classList.add('active');
            }

            function handleMouseOut() {
                var target = item.querySelector('.prod-feature-descont');
                if (target) {
                    target.classList.remove('active');
                }

                item.classList.remove('feature-item-active');
            }

        
            if (isMobile) {
            
                item.addEventListener('click', function() {
                    handleMouseOver();
                });
            } else {
                
                item.addEventListener('mouseover', handleMouseOver);
                item.addEventListener('mouseout', handleMouseOut);
            }
    });

</script>

