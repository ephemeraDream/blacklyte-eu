<style>
    .section-{{ section.id }}{
        padding-top: 100px;
        padding-bottom: 0;
        overflow: hidden;
    }
    .section-{{ section.id }} .container-full{
        padding-left: 16%;
        padding-right: 16%;
    }
    .section-{{ section.id }} .btn-item-dot{
        cursor: pointer;
    }
    
    .section-{{ section.id }} .btn-item-dot svg{
        width: 100%;
        height: auto;
    }
    .section-{{ section.id }} .btn-item-dot span{
        width: 100%;
        max-width: 100%;
    }

    .section-{{ section.id }} .btn-item-dot.btn-item-dot-active .static-svg,
    .section-{{ section.id }} .btn-item-dot .active-svg{
        display: none;
    }
    .section-{{ section.id }} .btn-item-dot.btn-item-dot-active .active-svg{
        display: block;
    }

    .section-{{ section.id }} .head-container{
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        text-align: center;
    }
    .section-{{ section.id }} .head-container .title{
        font-family: DIN;
        font-weight: 700;
        font-style: Bold;
        font-size: 30px;
        line-height: 50px;
        letter-spacing: -4%;
        text-align: center;
        text-transform: uppercase;
        color: #fff;
    }
    .section-{{ section.id }} .head-container .descripetion{
        font-family: Poppins;
        font-weight: 400;
        font-style: Regular;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: 0%;
        text-align: center;
        text-transform: capitalize;
        color: #fff;
    }
    .section-{{ section.id }} .prod-list{
        margin-top: 20px;
    }
    .section-{{ section.id }} .swiper-pagination-cont{
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 38px;
        margin-top: 8px;
    }
    .section-{{ section.id }} .btn-item-dot img{
        height: auto;
    }
    
    .section-{{ section.id }} .prod-item{
        display: flex;
        gap: 20px;
        padding-bottom: 100px;
    }
    .section-{{ section.id }} .prod-item-left{
        padding: 0 10px;
    }
    .section-{{ section.id }} .prod-item-left,
    .section-{{ section.id }} .prod-item-right{
         width: calc((100% - 20px) / 2);
    }
    .section-{{ section.id }} .prod-item-right img{
        height: auto;
    }
    .section-{{ section.id }} .prod-item-right .prod-item-right-imgs{
        position: relative;
    }
    .section-{{ section.id }} .prod-item-right .rih-img{
        transform: translate(-10%);
        transition: all .5s ease;
    }
    
    .section-{{ section.id }} .prod-item-right .rih-img.rih-img-active{
        opacity: 1;
        transform: translate(0);
        position: absolute;
        top: 0;
    }
    .section-{{ section.id }} .prod-item-right .rih-img.rih-img-hidden{
        opacity: 0;
        position: relative;
    }
    .section-{{ section.id }} .prod-sub-title{
        font-family: DIN;
        font-weight: 500;
        font-style: Medium;
        font-size: 20px;
        line-height: normal;
        letter-spacing: 0%;
        color: #fff;
    }
    .section-{{ section.id }} .prod-title{
        font-family: Poppins;
        font-weight: 700;
        font-style: Bold;
        font-size: 40px;
        line-height: 52px;
        letter-spacing: 0%;
        color: #fff;
        margin-top: 10px;
    }
    .section-{{ section.id }} .prod-desc{
        font-family: DIN;
        font-weight: 500;
        font-style: Medium;
        font-size: 18px;
        line-height: 1.2;
        letter-spacing: 0%;
        text-transform: capitalize;
        color: #fff;
        margin-top: 14px;
    }
    .section-{{ section.id }} .feature-list{
        display: flex;
        gap: 18px;
        margin-top: 13px;

    }
    .section-{{ section.id }} .feature-list .feature-item{
        width: calc((100% - 54px) / 4);
        cursor: pointer;
        position: relative;
        
    }
    .section-{{ section.id }} .prod-item-left .feature-list .feature-item.feature-item-active{
        box-shadow: 1px 1px 6.5px 5px #1589DB;
    }
    .section-{{ section.id }} .prod-item-left-1 .feature-list .feature-item.feature-item-active{
        box-shadow: 1px 1px 6.5px 5px #fff;
    }

    .section-{{ section.id }} .feature-list .feature-item img{
        height: auto;
    }
    .section-{{ section.id }} .feature-svg{
        margin-top: 35px;
    }
    .section-{{ section.id }} .feature-svg svg{
        width: 100%;
        height: auto;
    }
    .section-{{ section.id }} .feature-btn{
        display: inline-block;
        width: 100%;
        background: #1589DB;
        font-family: DIN;
        font-weight: 500;
        font-style: Medium;
        font-size: 30px;
        line-height: 100%;
        letter-spacing: 0%;
        color: #fff;
        border-radius: 4px;
        margin-top: 46px;
        padding: 16px 0;
        line-height: normal;
        text-align: center;
    }


    .section-{{ section.id }} .feature-btn-1{
        display: none;
    }

    .section-{{ section.id }} .prod-item-left-0 .feature-btn-1,
    .section-{{ section.id }} .prod-item-left-1 .feature-btn-0{
        display: none;
    }

    .section-{{ section.id }} .prod-item-left-0 .feature-btn-0,
    .section-{{ section.id }} .prod-item-left-1 .feature-btn-1{
        display: block;
    }
   
    .section-{{ section.id }} .feature-btn-1{
        background: #fff;
        color: #00050E;
    }

    .section-{{ section.id }} .feature-list .feature-item .prod-feature-descont{
        position: absolute;
        padding: 20px;
        background: #fff;
        left: 0;
        width: 280px;
        top: calc(100% + 10px);
        border-radius: 5px;
        opacity: 0;
        z-index: -1;
        transition: opacity 0.3s ease;
    }
    .section-{{ section.id }} .feature-list .feature-item .prod-feature-descont.active{
        opacity: 1;
        z-index: 2;
    }
    .prod-feature-descont::before {
        content: '';
        position: absolute;
        top: -20px;
        left: 20px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 10px; 
        border-color: transparent transparent #ffffff transparent;
    }
    .section-{{ section.id }} .feature-item .title-text,
    .section-{{ section.id }} .feature-item .sub-title-text{
        font-family: Poppins;
        font-weight: 600;
        font-style: SemiBold;
        font-size: 10px;
        line-height: 100%;
        letter-spacing: 0%;
        color: #262629;
    }
    .section-{{ section.id }} .feature-item .sub-title-text{
        margin-top: 6px;
    }
    .section-{{ section.id }} .feature-item .line-center{
        display: block;
        width: 100%;
        height: 1px;
        background: #E5E5E5;
        margin: 10px 0;
    }
    .section-{{ section.id }} .feature-item .desc-text{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 10px;
        line-height: inherit;
        letter-spacing: 0%;
        color: #262629;
        opacity: 0.7;
    }
    {% comment %} 购买跟随 {% endcomment %}
    .sticky-dom-chair{
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: #f5f5f5;
        transform: translateZ(0);
        transition: all .3s ease-in-out;
        box-shadow: -.15625vw -.15625vw .15625vw #dfdfdf40;
        padding: 13px 7.34375vw;
        opacity: 0;
        z-index: -1;
        max-width: 100%;
        overflow: hidden;
    }
    .sticky-dom-chair .prod-info{
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .sticky-dom-chair .prod-info .prod-img .sticky_prod_variant_image{
        height: 100%;
        background-color: #e5e5e5;
        object-fit: contain;
        object-position: center center;
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        right: 0;
        opacity: 0;
    }
    .sticky-dom-chair .prod-info .prod-img .sticky_prod_variant_image.sticky_prod_variant_image_active{
        opacity: 1;
    }
    .sticky-dom-chair .prod-info .prod-img .sticky_prod_variant_image.sticky_prod_variant_image_hidden{
        opacity: 0;
    }
    .sticky-dom-chair .prod-info .left-cont{
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .sticky-dom-chair .prod-info .left-cont .prod-img{
        position: relative;
        width: 60px;
        height: 60px;
        border-radius: 10px;
        overflow: hidden;
    }
    .sticky-dom-chair .prod-info .prod-title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: clamp(16px, .833vw, .833vw);
        leading-trim: NONE;
        line-height: 100%;
        letter-spacing: 0%;
        vertical-align: middle;
        color: #262629;
    }
    .sticky-dom-chair .prod-info .price-sale-cont{
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }
    .sticky-dom-chair .prod-info .discount-price-info{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: clamp(20px, 1.25vw, 1.25vw);
        leading-trim: NONE;
        line-height: 100%;
        letter-spacing: 0%;
        vertical-align: middle;
        color: #262629;
    }
    .sticky-dom-chair .prod-info .origa-price{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: clamp(20px, 1.25vw, 1.25vw);
        leading-trim: NONE;
        line-height: clamp(14px, .729167vw, .729167vw);
        letter-spacing: 0%;
        vertical-align: middle;
        color: #262629;
        margin-left: .3125vw;
    }
    .sticky-dom-chair .prod-info .origa-price-discount{
        text-decoration: line-through;
        font-size: clamp(12px, .625vw, .625vw);
        color: #26262980;
    }
    .sticky-dom-chair .prod-info .save-tag{
        padding: 0 .3125vw;
        background: #af1c1c;
        border-radius: .15625vw;
        color: #fff;
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: clamp(12px, .625vw, .625vw);
        leading-trim: NONE;
        letter-spacing: 0%;
        display: flex;
        align-items: center;
        height: 1.145833vw;
        min-height: 22px;
        margin-left: .46875vw;
    }
    .sticky-dom-chair .price-cont{
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .sticky-dom-chair .price-cont .price-container-left{
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .sticky-dom-chair .price-cont .payment-info{
        display: flex;
        align-items: baseline;
    }
    .sticky-dom-chair .price-cont .payment-text-info{
        display: flex;
        align-items: baseline;
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: clamp(14px, .7291667vw, .7291667vw);
        leading-trim: NONE;
        line-height: clamp(18px, .9375vw, .9375vw);
        letter-spacing: 0%;
        vertical-align: middle;
        color: #262629b3;
        margin-top: .15625vw;
        white-space: nowrap;
    }
    .sticky-dom-chair .price-cont .payment-logo img{
        min-width: 42px;
        width: 2.1875vw;
        height: auto;
        margin-left: .15625vw;
    }
    .sticky-dom-chair .prod-buy-it-now{
        background: #262629;
        color: #fff;
        border: none;
        position: relative;
        width: 10.15625vw;
        flex: 0 0 auto;
        height: 2.65625vw;
        min-height: 38px;
        border-radius: 3.28125vw;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: clamp(14px, .7291667vw, .7291667vw);
        line-height: 100%;
        letter-spacing: 0%;
        transition: all .4s ease-out;
        text-transform: uppercase;
    }
    .sticky-dom-chair .prod-buy-it-now:hover{
        box-shadow: 0 0 10px #262629;
        opacity: 0.95;
    }
    .sticky-dom-chair .prod-buy-it-now:before{
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(120deg, #fff3 49.9%, #fff0 50%) no-repeat 100% 100%;
        background-size: 300% 100%;
        border-radius: 90px;
        transition: background-position .4s ease-out;
    }

    @media(max-width: 767px){
