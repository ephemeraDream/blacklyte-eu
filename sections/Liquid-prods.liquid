<section class="section-{{ section.id }} section-liquid-prods" id="{{ section.id }}" data-section-id="{{ section.id }}">
    {%- liquid
        assign bgImage = section.settings.sectionBgImage
        assign bgImageMb = section.settings.sectionBgImage_mb
    -%}

    <style>
        .section-{{ section.id }} {
            background-color: #00050E;
            background-image: url({{ bgImage | img_url: 'master' }});
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        @media (max-width: 767px) {
            .section-{{ section.id }} {
                background-image: url({{ bgImageMb | img_url: 'master' }});
            }
        }
    </style>
    <div class="container-full">
        <div class="head-container">
            <div class="title">{{ section.settings.sectionTitle }}</div>
            <div class="descripetion">{{ section.settings.sectionDesc }}</div>
        </div>
    
        {% comment %} 自定义swiper pagination {% endcomment %}
        <div class="swiper-pagination-cont">
            {% for block in section.blocks %}
                {% if block.type == "itemBtn" %}
                    <div class="btn-item-dot">
                        {% if block.settings.itemBtnSvg != blank %}
                            <span class="static-svg">{{ block.settings.itemBtnSvg }}</span>
                            <span class="active-svg">{{ block.settings.itemBtnSvgActive }}</span>
                        {% else %}
                        <img class="static-imag" src="{{ block.settings.itemBtnImage | img_url: 'master' }}"
                            width="{{ block.settings.itemBtnImage.width }}"
                            height="{{ block.settings.itemBtnImage.height }}"
                            alt="{{ block.settings.itemBtnImage.alt }}" />
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
        <div class="prod-list">
            {% for block in section.blocks %}
                {% if block.type == 'itemProd' %}
                    <div class="prod-item">
                        {% assign product = block.settings.product_item %}
                        {% assign productItem = block.settings.product_item_1 %}
                        <div class="prod-item-left">
                            <div class="prod-head">
                                <div class="prod-sub-title">{{ block.settings.prod_sub_title }}</div>
                                <div class="prod-title">{{ block.settings.prod_title }}</div>
                                <div class="prod-desc">{{ block.settings.prod_desc }}</div>
                            </div>
                            <div class="feature-svg">
                                <svg width="437" height="31" viewBox="0 0 437 31" fill="none" xmlns="http://www.w3.org/2000/svg">
