<script>
    $(document).ready(function() {
        const btnItems = document.querySelectorAll('.btn-item-dot');
        const desktopBackgrounds = [
            'url(https://cdn.shopify.com/s/files/1/0716/1341/5637/files/liquid-prods-bgImage.png?v=1763970247)',
            'url(https://cdn.shopify.com/s/files/1/0716/1341/5637/files/liquid-prods-bgImage-1.png?v=1763976157)'
        ];

        const mobileBackgrounds = [
            'url(https://cdn.shopify.com/s/files/1/0716/1341/5637/files/liquid-prods-bgImage-mb.png?v=1763970246)',
            'url(https://cdn.shopify.com/s/files/1/0716/1341/5637/files/liquid-prods-bgImage-1-mb.png?v=1763976156)'
        ];

        const isMobile = window.innerWidth <= 768;

        const backgrounds = isMobile ? mobileBackgrounds : desktopBackgrounds;

        const section = document.querySelector('.section-liquid-prods');

        const prodItemLeft = document.querySelectorAll('.prod-item-left')

        if (btnItems.length > 0) {
            btnItems[0].classList.add('btn-item-dot-active');
        }

        btnItems.forEach(function(item, index) {
            item.addEventListener('click', function() {
                const rihImgs = document.querySelectorAll('.prod-item-right .rih-img');
                
                
                rihImgs.forEach(function(img, imgIndex) {
                    if (imgIndex === index) {
                        img.classList.add('rih-img-active');
                        img.classList.remove('rih-img-hidden');
                    } else {
                        img.classList.add('rih-img-hidden');
                        img.classList.remove('rih-img-active');
                    }
                });

                
                section.style.backgroundImage = backgrounds[index];
                
                btnItems.forEach(function(item) {
                    item.classList.remove('btn-item-dot-active');
                });
                
                btnItems[index].classList.add('btn-item-dot-active');
                
                prodItemLeft.forEach(function(itemLeft) {
                    
                    itemLeft.classList.forEach(function(className) {
                        if (className.startsWith('prod-item-left-')) {
                            itemLeft.classList.remove(className);
                        }
                    });

                    
                    itemLeft.classList.add('prod-item-left-' + index);
                });

                const prodVariant = document.querySelectorAll('.sticky-dom-chair .prod-info .left-cont .prod-img .sticky_prod_variant_image')
                prodVariant.forEach(function(item, itemIndex){
                    if(itemIndex == index){
                        item.classList.add('sticky_prod_variant_image_active');
                        item.classList.remove('sticky_prod_variant_image_hidden');
                    }else{
                        item.classList.remove('sticky_prod_variant_image_active');
                        item.classList.add('sticky_prod_variant_image_hidden');
                    }
                })
                
            });
        });

        document.querySelectorAll('.feature-list .feature-item').forEach(function(item) {
        
            item.addEventListener('mouseover', function() {

                if (item.classList.contains('feature-item-active')) {
                    item.classList.remove('feature-item-active');
                } else {
                    document.querySelectorAll('.feature-list .feature-item').forEach(function(featureItem) {
                        featureItem.classList.remove('feature-item-active');
                    });
                    item.classList.add('feature-item-active');
                }

                
                var target = item.querySelector('.prod-feature-descont');
                if (!target) return;

                if (target.classList.contains('active')) {
                    target.classList.remove('active');
                    return;
                }

                document.querySelectorAll('.prod-feature-descont.active').forEach(function(desc){
                    desc.classList.remove('active');
                });

                target.classList.add('active');
            });

            item.addEventListener('mouseout', function() {
                var target = item.querySelector('.prod-feature-descont');
                if (target) {
                    target.classList.remove('active');
                }

                item.classList.remove('feature-item-active');
            });

        });

        (function() {
            const chair = document.querySelector('.sticky-dom-chair');
            if (!chair) return;

            chair.style.opacity = '0';
            chair.style.zIndex = '0';
            chair.style.transition = 'opacity 0.35s ease';

            let windowHeight = window.innerHeight;
            let ticking = false;

            function updateWindowHeight() {
                windowHeight = window.innerHeight;
            }

            function onScroll() {
                if (!ticking) {
                window.requestAnimationFrame(() => {
                    const scrollTop = window.scrollY || document.documentElement.scrollTop;
                    if (scrollTop >= 2 * windowHeight) {
                        chair.style.opacity = '1';
                        chair.style.zIndex = '10';
                    
                    } else {
                        chair.style.opacity = '0';
                        chair.style.zIndex = '0';

                    }
                    ticking = false;
                });
                ticking = true;
                }
            }

            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', () => {
                updateWindowHeight();
                onScroll();
            });

            updateWindowHeight();
            onScroll();
        })();

        (function() {
            $('.sticky-dom-chair .prod-buy-it-now').on('click', function(e){
                e.preventDefault();
                e.stopPropagation();
                const url = $(this).data('href')
                const variantId = $('.sticky-dom-chair .sticky_prod_variant_image_active').data('variant')
                window.location.href = `${url}?variant=${variantId}`
            })
        })()
    
    })

</script>

