          },
          {
            "type": "text",
            "id": "blockProdSalePrice",
            "label": "block Product Sale Price"
          },
          {
            "type": "text",
            "id": "blockProdPrice",
            "label": "block Product Price"
          },
          {
            "type": "text",
            "id": "blockProdButton",
            "label": "block Product Button",
            "default": "Shop Now"
          },
          {
            "type": "url",
            "id": "blockLink",
            "label": "block Link URL"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "EWC Event Collection"
      }
    ]
  }
