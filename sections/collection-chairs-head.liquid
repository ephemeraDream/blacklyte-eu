    },
    {
      "type": "text",
      "id": "item2",
      "label": "Header Item second",
      "default": "Gaming Chair"
    },
    {
      "type": "url",
      "id": "item2Link",
      "label": "Header Item 2 Link"
    },
    {
      "type": "text",
      "id": "item3",
      "label": "Header Item third",
      "default": "Desks"
    },
    {
      "type": "url",
      "id": "item3Link",
      "label": "Header Item 3 Link"
    },
    {
      "type": "text",
      "id": "item4",
      "label": "Header Item fourth",
      "default": "All Lighting"
    },
    {
      "type": "url",
      "id": "item4Link",
      "label": "Header Item 4 Link"
    },
    {
      "type": "text",
      "id": "item5",
