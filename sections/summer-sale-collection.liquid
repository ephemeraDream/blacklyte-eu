<style>
  .show_image_loading .media--loading-effect{
    background: none !important;
  }
  .hltv-event{
    background-color: #E3E3E3;
    position: relative;
  }

  .hltv-event-container{
    padding-bottom: 400px;
  }
  .hltv-event:before{
    display: inline-block;
    content: '';
    background: url('https://cdn.shopify.com/s/files/1/0716/1341/5637/files/halloweenEvent-bgIcon.webp?v=1758965087') no-repeat;
    background-size: contain;
    position: absolute;
    top: 60px;
    left: 0;
    width: 488px;
    height: 488px;
  }
  .hltv-event:after{
    display: inline-block;
    content: '';
    background: url('https://cdn.shopify.com/s/files/1/0716/1341/5637/files/halloweenEvent-bgIcon.webp?v=1758965087') no-repeat;
    background-size: contain;
    position: absolute;
    bottom: 0;
    right: 0;
    width: 488px;
    height: 488px;
    transform: rotate(180deg);
  }
  .target-lists{
    display: flex;
    gap: 160px;
    background-color: #E3E3E3;
    justify-content: center;
    position: sticky;
    top: 100px;
    z-index: 100;
  }
  .target-lists:after{
    display: inline-block;
    content: '';
    width: 100%;
    height: 2px;
    background: #C7C7C7;
    position: absolute;
    left: 0;
    bottom: 0;
  }
  .target-lists .target-item{
    font: 600 20px var(--font-family-1);
    color: #262629;
    padding: 19px 10px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }
  .target-lists .target-item::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    width: 100%;
    height: 2px;
    background: #262629;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .3s cubic-bezier(.4,0,.2,1);
    z-index: 10;
  }
  
  .target-lists .target-item.target-item-active::after {
    transform: scaleX(1);
  }
  .header-title.desk-header-title{
    margin: 100px auto 60px;
    position: relative;
  }
  .prod-list-subtitle{
    font: 400 24px var(--font-family-1);
    line-height: 40px;
    color: #262629;
  }
  .chairs-list-module{
    display: flex;
    gap: 18px;
    margin-top: 76px;
  }
  .chairs-list-module .block-chair-cont.chairs-block-chairs-cont{
    width: calc((100% - 18px) / 2);
    position: relative;
    display: flex;
  }
  .prod_lists.chairs_prod_lists{
    position: relative;
    margin-top: 50px;
    z-index: 10;
  }
  .prod_lists.chairs_prod_lists#chairsProdCont{
    margin-top: 93px;
  }
  .chairs_title-image-block{
    width: 80%;
    height: auto;
    margin: 0 auto;
  }
  .chairs_title-image-block.desks_title-image-block {
    width: 60%;
  }
  .block-chair-cont .top_pick{
    display: flex;
    background-color: #D9D9D9;
    padding: 30px;
    cursor: pointer;
    border-radius: 10px;
    position: relative;
    width: 100%;
    justify-content: center;
    border: 1px solid #999999;
  }
  .block-chair-cont-save-tag{
    font: 600 13px var(--font-family-1);
    position: absolute;
    left: 0;
    top: 0;
    background: url('https://cdn.shopify.com/s/files/1/0716/1341/5637/files/hollow-bundleTag.png?v=1758714267') no-repeat;
    background-size: contain;
    color: #262629;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    flex-direction: column;
    z-index: 10;
  }
  .flashSale-block-chair-cont-save-tag.block-chair-cont-save-tag{
    background: url('https://cdn.shopify.com/s/files/1/0579/0839/6145/files/halloween-flashSale-icon.webp?v=1758949645') no-repeat;
    background-size: contain;
    width: 68px;
    height: 45px;
  }
  .block-chair-cont-save-tag .block-chair-cont-save-tag-price{
    margin-top: 3px;
  }
  .block-chair-cont-save-tag .block-chair-cont-save-tag-price:before{
    content: '€';
  }
  .block-chair-cont .top_pick .left{
    width: 300px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .block-chair-cont .top_pick .right{
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }
  .block-chair-cont .top_pick .right .top_pick_subtitle{
    font: 500 14px var(--font-family-1);
    color: #262629;
    line-height: 1.2;
  }
  .block-chair-cont .top_pick .right .top_pick_title{
    font: 500 26px var(--font-family-1);
    color: #262629;
    line-height: 1.4;
  }
  .block-chair-cont .top_pick .right .top_pick_desc{
    font: 400 20px var(--font-family-1);
    color: rgba(38, 38, 41, 0.7);
    line-height: 1.4;
    margin-top: 6px;
