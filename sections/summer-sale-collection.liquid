  .prod_lists.chairs_prod_lists .prod_item .container{
    display: flex !important;
    flex-direction: column;
    height: 100%;
    padding: 20px 10px;
  }
  .prod_lists .prod_items .prod_item .prod_card_info{
    {% comment %} padding: 0 26px 27px 27px; {% endcomment %}
