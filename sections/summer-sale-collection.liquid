<script>
  $(document).ready(function() {
    $('.prod_lists .prod_item').each(function() {
      let titleElement = $(this).find('.prod_item_title');
      const itemVariantVal = $(this).find('.prod_item-variants');
  
      let title = titleElement.text().trim();

      let partsVal = title.split('-');
  
      if (partsVal[1]) {
        const partsVal1 = partsVal[1].split('/')[0]?.trim();
        const partsVal2 = partsVal[1].split('/')[1]?.trim();

        let prependTex = ''
        if (partsVal1) {
          if(partsVal2) {
            prependTex = partsVal1 + ' / ' + partsVal2
          } else {
            prependTex = partsVal1 + '   '
          }
          itemVariantVal.text(prependTex)
          titleElement.text(partsVal[0].trim())
        } else {
          itemVariantVal.text(partsVal2)
          titleElement.text(partsVal[0].trim())
        }
      }
    });
    setTimeout(function() {
      $('.prod_item_title').each(function() {
        // 获取原文本
        var txt = $(this).text().trim();
        // 去掉最后的 ' Gaming Chair'，区分大小写
        if (txt.endsWith(' Gaming Chair')) {
          txt = txt.replace(/ Gaming Chair$/, '');
          $(this).text(txt);
        }
      });
    }, 0)

    $('.top_pick_btn').on('click', function(){
      let url = $(this).data('href')
      targetLink(url)
    })
    $('.block-chair-cont').on('click', function() {
      let url = $(this).data('href')
      targetLink(url)
    })
    $('.bundle-cont-link').on('click', function() {
      let url = $(this).data('href')
      targetLink(url)
    })
    // 跳转方法
    function targetLink(url) {
      if(url) {
        window.location.href = url
      }
    }
    $('.target-lists').on('click', '.target-item', function() {
      // 移除所有兄弟的 active 类
      $(this).siblings('.target-item').removeClass('target-item-active');
      // 当前点击的 item 添加 active 类
      $(this).addClass('target-item-active');
  
      var index = $(this).index();
      var targetId = '';
      {% comment %} if(index === 0){
        targetId = '#volumesProdCont';
      }else {% endcomment %}
      if(index === 0){
        targetId = '#bundleItemConte';
      } else if(index === 1){
        targetId = '#chairsProdCont';
      } else if(index === 2){
        targetId = '#accessoriesCont';
      }
      if(targetId){
        // 兼容有吸顶导航时可以加个 offset，比如 80
        var offset = $(targetId).offset().top - 200; 
        $('html, body').animate({ scrollTop: offset }, 600);
      }
    });

    {% comment %} $('[data-variant-id="46846302945529"] .prod_item_discount_price').text('439,00');
    $('[data-variant-id="46846302978297"] .prod_item_discount_price').text('439,00');
    $('[data-variant-id="46846303011065"] .prod_item_discount_price').text('439,00');
    $('[data-variant-id="46846303043833"] .prod_item_discount_price').text('469,00'); {% endcomment %}
    
  });

  function updateTargetActiveOnScroll() {
    {% comment %} var volumeTop = $('#volumesProdCont').offset()?.top - 200 ?? 99999; {% endcomment %}
    var chairsTop = $('#chairsProdCont').offset()?.top - 200 ?? 99999;
    var bundleTop = $('#bundleItemConte').offset()?.top - 200 ?? 99999;
    var accessoriesTop = $('#accessoriesCont').offset()?.top - 200 ?? 99999;
    var scrollY = $(window).scrollTop();
    var offset = 80;
  
    {% comment %} volumeTop -= offset; {% endcomment %}
    chairsTop -= offset;
    bundleTop -= offset;
    accessoriesTop -= offset;
  
    var items = $('.target-item');
    var activeIndex = 0;
    {% comment %} if (scrollY >= volumeTop && scrollY < chairsTop) {
      activeIndex = 0;
    } else {% endcomment %}
    if (scrollY >= bundleTop && scrollY < chairsTop) {
      activeIndex = 0;
    } else if(scrollY >= chairsTop && scrollY < accessoriesTop){
      activeIndex = 1;
    } else if (scrollY >= accessoriesTop) {
      activeIndex = 2;
    }
  
    items.removeClass('target-item-active');
    items.eq(activeIndex).addClass('target-item-active');
  }
  $(window).on('scroll', updateTargetActiveOnScroll);
  $(function(){ updateTargetActiveOnScroll(); });


  $('.prod_lists .prod_items .prod_item .prod_item_price .prod_item_discount_price').each(function(){
    let text = $(this).text();
    let newText = text.trim().replace(/\s+/g, '');
    $(this).text(newText);
  });

  $('.block-chair-cont-save-tag .block-chair-cont-save-tag-price').each(function(){
    let text = $(this).text();
    let newText = text.trim().replace(/\s+/g, '');
    $(this).text(newText);
  })
  

</script>



