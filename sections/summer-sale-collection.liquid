  .block-chair-cont .top_pick .right .top_pick_prices{
    margin-top: 8px;
  }
  .block-chair-cont .top_pick .right .top_pick_prices .discount-price{
    font: 500 26px var(--font-family-1);
    color: rgba(38, 38, 41, 1);
  }
  .block-chair-cont .top_pick .right .top_pick_prices .sale-price{
    font: 400 20px var(--font-family-1);
    color: rgba(38, 38, 41, 0.5);
    text-decoration: line-through;
    margin-left: 6px;
  }
  
  .block-chair-cont .top_pick .right .top_pick_btn{
    font-family: var(--font-family-1);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0;
    padding: 15px 0;
    border-radius: 30px;
    background: #262629;
    max-width: 130px;
    text-align: center;
    color: #fff;
    margin-top: 10px;
    border: 1px solid transparent;
    transition: border-color 0.5s ease, color 0.5s ease, background 0.5s ease;
  }
  .block-chair-cont .top_pick .right .top_pick_btn:hover{
    background: none;
    border: 1px solid #262629;
    color: #262629;
    
  }
  .prod_lists .prod_items{
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .prod_lists .prod_items .prod_item{
