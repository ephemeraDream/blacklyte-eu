<section class="hltv-event">
  <div class="target-lists">
    {% for block in section.blocks %}
      {% if block.type == 'targetItem' %}
        <span class="target-item {% if forloop.index == 1 %}target-item-active{% endif %}">{{ block.settings.targetItemTitle }}</span>
      {% endif %}
    {% endfor %}
  </div>
  <div class="container-1570 hltv-event-container">
    <div class="event-cont">
      {% comment %} <div class="module-title" id="volumesProdCont">
        <div class="prod-list-title">
          {% if collection.metafields.custom.isvolumedate != 'unvolume-date' %}
            <span>{{ section.settings.flashProductTitle }}</span>
          {% else %}
            <span>{{ section.settings.productTitle }}</span>
          {% endif %}
        </div>
        {% if collection.metafields.custom.isvolumedate != 'unvolume-date' %}
          <div class="prod-list-subtitle">{{ section.settings.flashProductSubTitle }}</div>
        {% endif %}
        <div class="prod-list-desc">
