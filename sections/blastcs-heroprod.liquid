<style>
    .section-{{ section.id }}{
        padding-top: 100px;
        padding-bottom: 0;
        overflow: hidden;
    }
    .section-{{ section.id }} .container-full{
        padding-left: 16%;
        padding-right: 16%;
        padding-bottom: 100px;
        position: relative;
    }

    .section-{{ section.id }} .container-full .container-sticky-image{
        width: 100%;
        max-height: 50px;
        position: absolute;
        bottom: 0;
        left: 0;
    }
    .section-{{ section.id }} .container-full .container-sticky-image img{
        width: 100%;
        height: auto;
    }
    .section-{{ section.id }} .btn-item-dot{
        cursor: pointer;
        width: 190px;
    }
    
    .section-{{ section.id }} .btn-item-dot svg{
        width: 100%;
        height: auto;
    }
    .section-{{ section.id }} .btn-item-dot span{
        width: 100%;
        max-width: 100%;
    }

    .section-{{ section.id }} .btn-item-dot.btn-item-dot-active .static-svg,
    .section-{{ section.id }} .btn-item-dot .active-svg{
        display: none;
    }
    .section-{{ section.id }} .btn-item-dot.btn-item-dot-active .active-svg{
        display: block;
    }

    .section-{{ section.id }} .head-container{
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        text-align: center;
    }
    .section-{{ section.id }} .head-container .title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 40px;
        line-height: 30px;
        letter-spacing: 0%;
        text-align: center;
        text-transform: uppercase;
        color: #8D959E;
    }

    .section-{{ section.id }} .head-container .sub-title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 24px;
        line-height: 30px;
        letter-spacing: 40%;
        text-align: center;
        text-transform: uppercase;
        color: #8D959E;
    }
    .section-{{ section.id }} .head-container .descripetion{
        font-family: Poppins;
        font-weight: 400;
        font-size: 20px;
        line-height: 120%;
        letter-spacing: 0%;
        color: #8D959E;
        margin-top: 22px;
    }
    .section-{{ section.id }} .swiper-pagination-cont{
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 20px;
        margin-top: 23px;
    }
    .section-{{ section.id }} .swiper-pagination-cont .swiper-pre-icon svg,
    .section-{{ section.id }} .swiper-pagination-cont .swiper-next-icon svg{
        width: 190px;
        height: auto;
    }
    .section-{{ section.id }} .btn-item-dot img{
        height: auto;
    }
    
    .section-{{ section.id }} .prod-item{
        display: flex;
        gap: 40px;
        justify-content: space-between;
        align-items: center;
    }
    .section-{{ section.id }} .prod-item-left{
        padding: 0 10px;
        width: calc(45% - 20px);
    }
    
    .section-{{ section.id }} .prod-item-right{
        width: calc(55% - 20px);
        display: flex;
        align-items: flex-end;
    }

    .section-{{ section.id }} .prod-item-right img{
        height: auto;
    }
    .section-{{ section.id }} .prod-item-right .prod-item-right-imgs{
        position: relative;
    }
    .section-{{ section.id }} .prod-item-right .rih-img{
        transform: translate(-10%);
        transition: all .5s ease;
    }
    
    .section-{{ section.id }} .prod-item-right .rih-img.rih-img-active{
        opacity: 1;
        transform: translate(0);
        position: absolute;
        top: 0;
    }
    .section-{{ section.id }} .prod-item-right .rih-img.rih-img-hidden{
        opacity: 0;
        position: relative;
    }
    .section-{{ section.id }} .prod-sub-title{
        font-family: Poppins;
        font-weight: 500;
        font-size: 24px;
        line-height: 100%;
        letter-spacing: 0%;
        color: #fff;
    }
    .section-{{ section.id }} .prod-title{
        font-family: Poppins;
        font-weight: 600;
        font-size: 36px;
        line-height: 1.2;
        letter-spacing: 0%;
        color: #FFFFFF;
        margin-top: 17px;
        transition: all .35s ease;
        white-space: nowrap;
    }


    .section-liquid-and-spirit-prods .prod-desc{
        font-family: Poppins;
        font-weight: 500;
        font-size: 18px;
        line-height: 1.4;
        letter-spacing: 0%;
        color: #fff;
        margin-top: 20px;
    }


    .section-{{ section.id }} .feature-item svg{
        width: 100%;
        height: auto;
    }


    .section-{{ section.id }} .feature-svg{
        font-family: Poppins;
        font-weight: 300;
        font-style: Light;
        font-size: 16px;
        line-height: 120%;
        letter-spacing: 0%;
        text-align: center;
        color: #8D959E;
        text-align: left;
        margin-top: 50px;
    }
   
    .section-{{ section.id }} .feature-btn{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 18px;
        letter-spacing: 0%;
        text-align: center;
        text-transform: uppercase;
        display: inline-block;
        width: 100%;
        letter-spacing: 0%;
        color: #fff;
        border-radius: 4px;
        margin-top: 46px;
        padding: 16px 0;
        line-height: normal;
        border: 1px solid #FFFFFF;
        border-bottom-width: 4px;
        color: #FFFFFF;
        transition: all .35s ease;
        width: 400px;
    }


    .section-{{ section.id }} .feature-btn-1{
        display: none;
    }

    .section-{{ section.id }} .prod-item-left-0 .feature-btn-1,
    .section-{{ section.id }} .prod-item-left-1 .feature-btn-0{
        display: none;
    }

    .section-{{ section.id }} .prod-item-left-0 .feature-btn-0,
    .section-{{ section.id }} .prod-item-left-1 .feature-btn-1{
        display: block;
    }
   
    .section-{{ section.id }} .feature-btn-1{
        border-color: #FFFFFF;
        color: #FFFFFF;
    }


    .section-{{ section.id }} .prod-feature-descont::before {
        content: '';
        position: absolute;
        top: -18px;
        left: 20px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 10px; 
        border-color: transparent transparent #ffffff transparent;
    }
    .section-{{ section.id }} .feature-item .title-text,
    .section-{{ section.id }} .feature-item .sub-title-text{
        font-family: Poppins;
        font-weight: 600;
        font-size: 12px;
        line-height: 1.2;
        letter-spacing: 0%;
        color: #262629;
    }
    .section-{{ section.id }} .feature-item .sub-title-text{
        margin-top: 6px;
    }
    .section-{{ section.id }} .feature-item .line-center{
        display: block;
        width: 100%;
        height: 1px;
        background: #E5E5E5;
        margin: 10px 0;
    }
    .section-{{ section.id }} .feature-item .desc-text{
        font-family: Poppins;
        font-weight: 500;
        font-size: 12px;
        line-height: 1.5;
        letter-spacing: 0%;
        color: #8D959E;
    }

    .section-liquid-and-spirit-prods .feature-item.feature-item-active svg path{
        stroke: #FFFFFF;
    }
    .section-liquid-and-spirit-prods.section-r6Siege-10thEdition .feature-item.feature-item-active svg path{
        stroke: #FFFFFF;
    }
    
    .section-liquid-and-spirit-prods .feature-btn:hover{
        box-shadow: 0 0 20px #ffffff;
    }

    .section-liquid-and-spirit-prods.section-r6Siege-10thEdition .feature-btn:hover{
        box-shadow: 0 0 20px #FFFFFF;
    }

    .section-liquid-and-spirit-prods .feature-title-text{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 24px;
        line-height: 100%;
        letter-spacing: 0%;
        color: #fff;
        margin-top: 50px;
    }

    .section-{{ section.id }} .mobile-buttons{
        display: none;
    }

    @media(max-width: 767px){
        .section-{{ section.id }} {
            padding-top: 50px;
            padding-bottom: 0;
        }
        .section-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
            padding-bottom: 0;
        }
        .section-{{ section.id }} .head-container .title,
        .section-{{ section.id }} .head-container .sub-title{
            font-size: 20px;
        }

        .section-{{ section.id }} .head-container .descripetion{
            font-size: 16px;
            margin-top: 10px;
        }
       
        .section-{{ section.id }} .swiper-pagination-cont{
            gap: 20px;
        }
        
        .section-{{ section.id }} .prod-item{
            flex-direction: column;
            padding-bottom: 90px;
            gap: 0;
        }
        .section-{{ section.id }} .prod-sub-title{
            font-size: 14px;
            text-align: center;
        }
        .section-{{ section.id }} .prod-title{
            font-size: 26px;
            line-height: normal;
            white-space: normal;
            text-align: center;
            margin-top: 12px;
        }

        .section-liquid-and-spirit-prods .feature-title-text{
            margin-top: 40px;
            font-size: 20px;
            text-align: center;
        }

        .section-{{ section.id }} .prod-desc{
            font-size: 18px;
            margin-top: 12px;
            text-align: center;
        }
        .section-{{ section.id }} .feature-svg{
            font-size: 16px;
            line-height: 1.2;
            margin-top: 22px;
        }
       
        .section-{{ section.id }} .feature-btn{
            font-size: 18px;
            margin-top: 30px;
            padding: 10px 0;
            width: 100%;
        }

        .section-{{ section.id }} .prod-item-left .feature-btn{
            display: none;
        }
       
        .section-{{ section.id }} .prod-feature-descont::before{
            border-width: 5px;
            top: auto;
            left: 10px;
            bottom: -9px;
            transform: rotate(180deg);
        }
       
        .section-{{ section.id }} .feature-item .title-text,
        .section-{{ section.id }} .feature-item .sub-title-text{
            font-size: 8px;
        }
        .section-{{ section.id }} .feature-item .line-center{
            margin: 5px 0;
        }  
        .section-{{ section.id }} .feature-item .desc-text{
            font-size: 9px;
        }
        
        .section-{{ section.id }} .prod-item-left,
        .section-{{ section.id }} .prod-item-right{
            width: 100%;
        }
        .section-{{ section.id }} .btn-item-dot{
            width: calc((100% - 20px) / 2);
        }

        .section-{{ section.id }} .btn-item-dot span{
            display: block;
        }

        .section-{{ section.id }} .swiper-pagination-cont .swiper-pre-icon svg,
        .section-{{ section.id }} .swiper-pagination-cont .swiper-next-icon svg{
            width: 80px;
        }

        .section-{{ section.id }} .prod-list{
            margin-top: 30px;
        }

        .section-{{ section.id }} .mobile-buttons{
            display: block;
            width: 100%;
        }


    }

     {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-{{ section.id }}{
            padding-top: 50px;
            padding-bottom: 50px;
        }
        .section-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
            
        }
        .section-{{ section.id }} .prod-sub-title{
            font-size: 16px;
        }
        .section-{{ section.id }} .prod-title{
            font-size: 30px;
            line-height: 1.2;
        }
        .section-{{ section.id }} .prod-desc{
            font-size: 12px;
        }
        .section-{{ section.id }} .feature-list{
            gap: 10px;
        }
        .section-{{ section.id }} .feature-btn{
            width: 94%;
            font-size: 20px;
            padding: 10px 0;
            margin-top: 30px;
        }

        .section-{{ section.id }} .prod-list{
            margin-top: 30px;
        }
        
    }

    {% comment %} small screen {% endcomment %}
    @media(min-width: 1025px) and (max-width: 1480px){
        .section-{{ section.id }} .container-full{
            padding-left: 60px;
            padding-right: 60px;
        }
        
    }

</style>

<div class="section-{{ section.id }} section-liquid-and-spirit-prods" id="{{ section.id }}" data-section-id="{{ section.id }}">
    {%- liquid
        assign bg_image = section.settings.sectionBgImage
        assign bg_image_mb = section.settings.sectionBgImage_mb
        assign section_bg_image_sec = section.settings.sectionBgImageSec
        assign section_bg_image_sec_mb = section.settings.sectionBgImageSec_mb
    -%}

    <style>
        .section-liquid-and-spirit-prods {
            background-color: #00050E;
            background-image: url({{ bg_image | image_url: width: 1920 }});
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .section-liquid-and-spirit-prods.section-r6Siege-10thEdition {
            background-image: url({{ section_bg_image_sec | image_url: width: 1920 }})
        }

        @media (max-width: 767px){
            .section-liquid-and-spirit-prods {
                background-image: url({{ bg_image_mb | image_url: width: 768 }});
            }
            .section-liquid-and-spirit-prods.section-r6Siege-10thEdition {
                background-image: url({{ section_bg_image_sec_mb | image_url: width: 768 }})
            }
        }



    </style>
    <div class="container-full">
        <div class="head-container">
            {% if section.settings.sectionTitle != blank %}
                <div class="title">{{ section.settings.sectionTitle }}</div>
            {% endif %}
            
            {% if section.settings.sectionSubTitle != blank %}
                <div class="sub-title">{{ section.settings.sectionSubTitle }}</div>
            {% endif %}
            
            {% if section.settings.sectionDesc != blank %}
                <div class="descripetion">{{ section.settings.sectionDesc }}</div>
            {% endif %}
            
        </div>
    
        
        <div class="prod-list">
            {% for block in section.blocks %}
                {% if block.type == 'itemProd' %}
                    <div class="prod-item">
                        {% assign product = block.settings.product_item %}
                        {% assign product_item = block.settings['product_item_1'] %}
                        <div class="prod-item-left">
                            <div class="prod-head">
                                {% if block.settings.prod_sub_title != blank %}
                                    <div class="prod-sub-title">{{ block.settings.prod_sub_title }}</div>
                                {% endif %}

                                {% if block.settings.prod_title != blank or block.settings.prod_title-cap != blank %}
                                    <div class="prod-title">
                                        {{ block.settings.prod_title }}
                                        <br />
                                        {{ block.settings.prod_title-cap }}
                                    </div>
                                {% endif %}
                                
                                {% if block.settings.prod_desc != blank %}
                                    <div class="prod-desc">{{ block.settings.prod_desc }}</div>
                                {% endif %}
                                
                            </div>
                            {% if block.settings.feature_title != blank %}
                                <div class="feature-title-text">{{ block.settings.feature_title }}</div>
                            {% endif %}

                            <div class="swiper-pagination-cont">
                                <div class="btn-item-dot">
                                    <span class="static-svg">
                                        <img src="{{ block.settings.spiritStatic | img_url: 'master' }}"
                                            width="{{ block.settings.spiritStatic.width }}"
                                            height="{{ block.settings.spiritStatic.height }}"
                                            alt="{{ block.settings.spiritStatic.alt }}" />
                                    </span>
                                    <span class="active-svg">
                                        <img src="{{ block.settings.spiritActive | img_url: 'master' }}"
                                            width="{{ block.settings.spiritActive.width }}"
                                            height="{{ block.settings.spiritActive.height }}"
                                            alt="{{ block.settings.spiritActive.alt }}" />
                                    </span>
                                </div>
                                <div class="btn-item-dot">
                                    <span class="static-svg">
                                        <img src="{{ block.settings.liquidStatic | img_url: 'master' }}"
                                            width="{{ block.settings.liquidStatic.width }}"
                                            height="{{ block.settings.liquidStatic.height }}"
                                            alt="{{ block.settings.liquidStatic.alt }}" />
                                    </span>
                                    <span class="active-svg">
                                        <img src="{{ block.settings.liquidActive | img_url: 'master' }}"
                                            width="{{ block.settings.liquidActive.width }}"
                                            height="{{ block.settings.liquidActive.height }}"
                                            alt="{{ block.settings.liquidActive.alt }}" />
                                    </span>
                                </div>
                            </div>
                            

                            <a href="{{ product.url }}" class="feature-btn feature-btn-0">{{ block.settings.button }}</a>
                            <a href="{{ product_item.url }}" class="feature-btn feature-btn-1">{{ block.settings.button }}</a>
                        </div>
                        <div class="prod-item-right">
                            <div class="prod-item-right-imgs">
                                <div class="rih-img rih-img-active">
                                    <img src="{{ block.settings.prod_image | image_url: width: 1400 }}"
                                        width="{{ block.settings.prod_image.width }}"
                                        height="{{ block.settings.prod_image.height }}"
                                        alt="{{ block.settings.prod_image.alt }}" />
                                </div>
                                <div class="rih-img rih-img-hidden">
                                    <img src="{{ block.settings.prod_image_1 | image_url: width: 1400 }}"
                                        width="{{ block.settings.prod_image_1.width }}"
                                        height="{{ block.settings.prod_image_1.height }}"
                                        alt="{{ block.settings.prod_image_1.alt }}" />
                                </div>
                            </div>
                        </div>

                        <div class="mobile-buttons">
                            <a href="{{ product.url }}" class="feature-btn feature-btn-0">{{ block.settings.button }}</a>
                            <a href="{{ product_item.url }}" class="feature-btn feature-btn-1">{{ block.settings.button }}</a>
                        </div>
                        
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</div>

<script>
    const btnItems = document.querySelectorAll('.section-liquid-and-spirit-prods .btn-item-dot');

    const section = document.querySelector('.section-liquid-and-spirit-prods');

    const prodItemLeft = document.querySelectorAll('.section-liquid-and-spirit-prods .prod-item-left')
    

    if (btnItems.length > 0) {
        btnItems[0].classList.add('btn-item-dot-active');
    }

    btnItems.forEach(function(item, index) {
        item.addEventListener('click', function() {
            const rihImgs = document.querySelectorAll('.section-liquid-and-spirit-prods .prod-item-right .rih-img');
            
            
            rihImgs.forEach(function(img, imgIndex) {
                if (imgIndex === index) {
                    img.classList.add('rih-img-active');
                    img.classList.remove('rih-img-hidden');
                } else {
                    img.classList.add('rih-img-hidden');
                    img.classList.remove('rih-img-active');
                }
            });

           
            if(index == 0){
                section.classList.remove('section-r6Siege-10thEdition')

                $('.mobile-buttons .feature-btn.feature-btn-0').css('display', 'block')
                $('.mobile-buttons .feature-btn.feature-btn-1').css('display', 'none')

            } else {
                section.classList.add('section-r6Siege-10thEdition')

                $('.mobile-buttons .feature-btn.feature-btn-0').css('display', 'none')
                $('.mobile-buttons .feature-btn.feature-btn-1').css('display', 'block')

            }
            
            btnItems.forEach(function(item) {
                item.classList.remove('btn-item-dot-active');
            });
            
            btnItems[index].classList.add('btn-item-dot-active');
            
            prodItemLeft.forEach(function(itemLeft) {
                
                itemLeft.classList.forEach(function(className) {
                    if (className.startsWith('prod-item-left-')) {
                        itemLeft.classList.remove(className);
                    }
                });

                
                itemLeft.classList.add('prod-item-left-' + index);
            });

            const prodVariant = document.querySelectorAll('.section-liquid-and-spirit-prods .sticky-dom-chair .prod-info .left-cont .prod-img .sticky_prod_variant_image')
            prodVariant.forEach(function(item, itemIndex){
                if(itemIndex == index){
                    item.classList.add('sticky_prod_variant_image_active');
                    item.classList.remove('sticky_prod_variant_image_hidden');
                }else{
                    item.classList.remove('sticky_prod_variant_image_active');
                    item.classList.add('sticky_prod_variant_image_hidden');
                }
            })
            
        });
    });

</script>

