<style>
    .section-{{ section.id }} .container-full{
        position: relative;
    }
    .section-{{ section.id }} .large-image-container .large-image-pc{
        display: block;
    }
    .section-{{ section.id }} .large-image-container .large-image-mb{
        display: none;
    }
    .section-{{ section.id }} .large-image-container{
        position: relative;
        overflow: hidden;
    }
    .section-{{ section.id }} .large-image-container .large-image img{
        position: absolute;
        top: 0;
        left: 0;
        height: auto;
    }
    .section-{{ section.id }} .brand-cont{
        position: absolute;
        top: 50%;
        left: 16%;
        transform: translateY(-50%);
        max-width: 40%;
    }
    .section-{{ section.id }} .brand-cont .section-title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 40px;
        line-height: 55px;
        letter-spacing: 0%;
        color: #fff;
        width: 70%;
    }
    .section-{{ section.id }} .brand-cont img{
        height: auto;
    }
    .section-{{ section.id }} .brands-lists{
        display: flex;
        gap: 30px;
        margin-top: 20px;
    }
    .section-{{ section.id }} .brands-lists .brand-item{
        width: calc((100% - 60px) / 3);
    }
    .section-{{ section.id }} .brands-lists .item-title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 18px;
        line-height: 30px;
        letter-spacing: 0%;
        text-align: center;
        text-transform: capitalize;
        color: #ECC699;
    }

    {% comment %} iPhone {% endcomment %}
    @media(max-width: 767px){
        .section-{{ section.id }} .large-image-container .large-image-pc{
            display: none;
        }
        .section-{{ section.id }} .large-image-container .large-image-mb{
            display: block;
        }
        .section-{{ section.id }} .brand-cont .section-title{
            font-size: 26px;
            line-height: normal;
            padding-left: 20px;
            width: 100%;
        }
        .section-{{ section.id }} .brands-lists{
            flex-direction: column;
            gap: 10px;
            margin-top: 10px;
        }
        .section-{{ section.id }} .brands-lists .brand-item{
            width: 75%;
        }
        .section-{{ section.id }} .brands-lists .item-title{
            font-size: 14px;
            line-height: normal;
        }
        .section-{{ section.id }} .brand-cont{
            max-width: 60%;
            left: 10px;
        }
    
    }
    {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-{{ section.id }} .brand-cont .section-title{
            font-size: 30px;
            line-height: normal;
        }
        .section-{{ section.id }} .brands-lists{
            gap: 10px;
        }
        .section-{{ section.id }} .brands-lists .item-title{
            font-size: 14px;
            line-height: normal;
        }
        .section-{{ section.id }} .brand-cont{
            max-width: 100%;
            left: 10px;
        }
    }

    @media(min-width: 1025px) and (max-width: 1480px){
        .section-{{ section.id }} .brand-cont{
            left: 60px;
            max-width: 48%;
        }
        .section-{{ section.id }} .brand-cont .section-title{
            font-size: 35px;
            line-height: normal;
            width: 100%;
        }
    }
    
</style>

<section class="section-{{ section.id }}" data-section-id="{{ section.id }}" id="{{ section.id }}">
    <div class="container-full">
        {% for block in section.blocks %}
            {% if block.type == "largeImage" %}
                <div class="large-image-container">
                    <div class="large-image large-image-pc" style="padding-top: {% unless block.settings.image.presentation.focal_point == '50.0% 50.0%' %}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 120 }}%{% else %}{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%{% endunless %}">
                        <img
                            src="{{ block.settings.image | img_url: 'master' }}"
                            alt="{{ block.settings.image.alt }}"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}" />
                    </div>
                    <div class="large-image large-image-mb" style="padding-top: {% unless block.settings.image_mb.presentation.focal_point == '50.0% 50.0%' %}{{ 1 | divided_by: block.settings.image_mb.aspect_ratio | times: 120 }}%{% else %}{{ 1 | divided_by: block.settings.image_mb.aspect_ratio | times: 100 }}%{% endunless %}">
                        <img
                            src="{{ block.settings.image_mb | img_url: 'master' }}"
                            alt="{{ block.settings.image_mb.alt }}"
                            width="{{ block.settings.image_mb.width }}"
                            height="{{ block.settings.image_mb.height }}" />
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        <div class="brand-cont">
            {% if section.settings.sectionTitle != blank %}
                <div class="section-title">{{ section.settings.sectionTitle }}</div>
            {% endif %}
            <div class="brands-lists">
                {% for block in section.blocks %}
                    {% if block.type == "brandItem" %}
                        <div class="brand-item">
                            <div class="img">
                                <img srcset="{{ block.settings.brandLogo | img_url: 'master' }}"
                                    width="{{ block.settings.brandLogo.width }}"
                                    height="{{ block.settings.brandLogo.height }}"
                                    alt="{{ block.settings.brandLogo.alt }}" />
                            </div>
                            <div class="item-title">{{ block.settings.brandText }}</div>
                        </div>
                    {% endif %}
                    
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{% schema %}
{
    "name": "aboutus awards",
    "settings": [
        {
            "type": "text",
            "id": "sectionTitle",
            "label": "section Title"
        }
    ],
    "blocks": [
        {
            "type": "largeImage",
            "name": "largeImage",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "large Main Image"
                },
                {
                    "type": "image_picker",
                    "id": "image_mb",
                    "label": "large Main Image Mobile"
                }
            ]
        },
        {
            "type": "brandItem",
            "name": "brandItem",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "brandLogo",
                    "label": "brand Logo"
                },
                {
                    "type": "text",
                    "id": "brandText",
                    "label": "brand Text"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "aboutus awards"
        }
    ]
}
{% endschema %}