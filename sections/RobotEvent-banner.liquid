<style>

    #conversation-badge,
    .halo-recently-viewed-popup.is-show{
        z-index: -99;
    }
    
    
    .robotevent-banner-section .robotevent-subscribe-item,
    .robotevent-banner-section .robotevent-items {
        position: relative;
        width: 100%;
        background-color: #000000;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-sizing: border-box;
    }


    .robotevent-banner-section .robotevent-subscribe-item .robot-background,
    .robotevent-banner-section .robotevent-items .online-background{
        width: 100%;
        aspect-ratio: 375 / 750;
    }

   
    .robotevent-banner-section .coming-soon-header,
    .robotevent-banner-section .online-header {
        text-align: center;
        z-index: 2;
        margin-bottom: 5vw;
        position: absolute;
        top: 80px;
    }

    .robotevent-banner-section .coming-soon-header{
        top: 60px;
    }

    .robotevent-banner-section .coming-soon-text,
    .robotevent-banner-section .online-text {
        font-family: 'The 2K12';
        font-weight: normal;
        font-size: 10vw;
        line-height: normal;
        color: #FFFFFF;
