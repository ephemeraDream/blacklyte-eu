        letter-spacing: 1vw;
    }

    .robotevent-banner-section .coming-soon-text{
        letter-spacing: 0;
    }

    .robotevent-banner-section .coming-soon-countdown-time{
        font-family: 'The 2K12';
        font-weight: 400;
        font-size: 5.43vw;
        line-height: 1.2;
        letter-spacing: 0%;
        text-align: center;
        vertical-align: middle;
        color: transparent;
        background: linear-gradient(90deg, #19D9C6 0%, #42A3FF 100%);
        -webkit-background-clip: text;
        background-clip: text;
        
    }

    .robotevent-banner-section .coming-soon-sub-text{
        font-family: 'The 2K12';
        font-weight: 400;
        font-size: 5.33vw;
