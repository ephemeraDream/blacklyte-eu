{{ 'ergonomics-section-five.css' | asset_url | stylesheet_tag }}

<div class="ergonomics_section_five">
  {%- for block in section.blocks -%}
    <div class="ergonomics_section_five_item">
      {% assign poster_image = block.settings.cover | image_url %}
      {{
        block.settings.video
        | video_tag:
          class: 'ergonomics_section_five_item_video',
          loop: true,
          muted: true,
          playsinline: true,
          preload: 'none',
          poster: poster_image,
          autoplay: true
      }}
      <div>
        <div class="ergonomics_section_five_item_title">{{ block.settings.title }}</div>
        <div class="ergonomics_section_five_item_text">{{ block.settings.text }}</div>
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "ergonomics section five",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "textarea",
          "id": "title",
          "label": "title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "text"
        },
        {
          "type": "image_picker",
          "id": "cover",
          "label": "cover"
        },
        {
          "type": "video",
          "id": "video",
          "label": "video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ergonomics section five"
    }
  ]
}
{% endschema %}
