{{ 'ergonomics-section-eight.css' | asset_url | stylesheet_tag }}

<div class="ergonomics_section_eight">
  <div class="ergonomics_section_eight_head">
    <div class="ergonomics_section_eight_title">{{ section.settings.title }}</div>
    <div class="ergonomics_section_eight_text">{{ section.settings.text }}</div>
  </div>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {% when 'first_part' %}
        <div class="first_part">
          <div class="first_part_title">{{ block.settings.title }}</div>
          <div class="first_part_contain">
            <div class="first_part_contain_item">
              <div class="first_part_contain_item_img">
                {{-
                  block.settings.image_one
                  | image_url: width: block.settings.image_one.width
                  | image_tag: alt: block.settings.image_one.alt
                -}}
              </div>
              <div class="first_part_contain_item_title">{{ block.settings.title_one }}</div>
              <div class="first_part_contain_item_text">{{ block.settings.text_one }}</div>
            </div>
            <div class="first_part_contain_item">
              <div class="first_part_contain_item_img">
                {{-
                  block.settings.image_two
                  | image_url: width: block.settings.image_two.width
                  | image_tag: alt: block.settings.image_two.alt
                -}}
              </div>
              <div class="first_part_contain_item_title">{{ block.settings.title_two }}</div>
              <div class="first_part_contain_item_text">{{ block.settings.text_two }}</div>
            </div>
            <div class="first_part_contain_item">
              <div class="first_part_contain_item_img">
                {{-
                  block.settings.image_three
                  | image_url: width: block.settings.image_three.width
                  | image_tag: alt: block.settings.image_three.alt
                -}}
              </div>
              <div class="first_part_contain_item_title">{{ block.settings.title_three }}</div>
              <div class="first_part_contain_item_text">{{ block.settings.text_three }}</div>
            </div>
            <div class="first_part_contain_item">
              <div class="first_part_contain_item_img">
                {{-
                  block.settings.image_four
                  | image_url: width: block.settings.image_four.width
                  | image_tag: alt: block.settings.image_four.alt
                -}}
              </div>
              <div class="first_part_contain_item_title">{{ block.settings.title_four }}</div>
              <div class="first_part_contain_item_text">{{ block.settings.text_four }}</div>
            </div>
          </div>
        </div>
      {%- when 'second_part' -%}
        <div class="second_part">
          <div class="second_part_title">{{ block.settings.title }}</div>
          <div class="second_part_contain">
            <div class="second_part_contain_item">
              <div class="second_part_contain_item_img">
                {{-
                  block.settings.image_one
                  | image_url: width: block.settings.image_one.width
                  | image_tag: alt: block.settings.image_one.alt
                -}}
              </div>
              <div class="second_part_contain_item_title">{{ block.settings.title_one }}</div>
              <div class="second_part_contain_item_text">{{ block.settings.text_one }}</div>
            </div>
            <div class="second_part_contain_item">
              <div class="second_part_contain_item_img">
                {{-
                  block.settings.image_two
                  | image_url: width: block.settings.image_two.width
                  | image_tag: alt: block.settings.image_two.alt
                -}}
              </div>
              <div class="second_part_contain_item_title">{{ block.settings.title_two }}</div>
              <div class="second_part_contain_item_text">{{ block.settings.text_two }}</div>
            </div>
            <div class="second_part_contain_item">
              <div class="second_part_contain_item_img">
                {{-
                  block.settings.image_three
                  | image_url: width: block.settings.image_three.width
                  | image_tag: alt: block.settings.image_three.alt
                -}}
              </div>
              <div class="second_part_contain_item_title">{{ block.settings.title_three }}</div>
              <div class="second_part_contain_item_text">{{ block.settings.text_three }}</div>
            </div>
            <div class="second_part_contain_item">
              <div class="second_part_contain_item_img">
                {{-
                  block.settings.image_four
                  | image_url: width: block.settings.image_four.width
                  | image_tag: alt: block.settings.image_four.alt
                -}}
              </div>
              <div class="second_part_contain_item_title">{{ block.settings.title_four }}</div>
              <div class="second_part_contain_item_text">{{ block.settings.text_four }}</div>
            </div>
            <div class="second_part_contain_item">
              <div class="second_part_contain_item_img">
                {{-
                  block.settings.image_five
                  | image_url: width: block.settings.image_five.width
                  | image_tag: alt: block.settings.image_five.alt
                -}}
              </div>
              <div class="second_part_contain_item_title">{{ block.settings.title_five }}</div>
              <div class="second_part_contain_item_text">{{ block.settings.text_five }}</div>
            </div>
          </div>
        </div>
    {%- endcase -%}
  {% endfor %}
</div>

