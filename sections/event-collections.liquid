    <div class="top-pick-module">
      {% for block in section.blocks %}
        {% if block.type == "AccessoryTopPickItem" %}
            {% render 'top-pick-component', block: block %}
        {% endif %}
      {% endfor %}
    </div>
    {% for block in section.blocks %}
      {% if block.type == 'AccessoryCollection' %}
        {% render 'Accessories-component', block: block %}
      {% endif %}
    {% endfor %}
  </div>
</section>

<script>
  $(document).ready(function() {
    // chairs
    setTimeout(() => {
      $('.prod_lists .prod_item.chairs-prod-item').each(function() {
        let titleElement = $(this).find('.prod_item_title')
        const itemVariantVal = $(this).find('.prod_item-variants')
        let title = titleElement.text().trim()
        let partsVal = title.split('-')
          
        if (partsVal[1]) {
          const partsVal1 = partsVal[1].split('/')[0]?.trim()
          const partsVal2 = partsVal[1].split('/')[1]?.trim()
          
          let prependTex = ''
          if (partsVal1) {
            if(partsVal2) {
             
              prependTex = partsVal1 + ' / '
              itemVariantVal.append(' / ' + partsVal2);
            } else {
              prependTex = partsVal1 + '   '
            }
            itemVariantVal.prepend(prependTex)
            titleElement.text(partsVal[0].trim())
          } else {
            itemVariantVal.prepend(partsVal2)
            titleElement.text(partsVal[0].trim())
          }
        }
      })
    }, 0)
    // desks
    setTimeout(() => {
      $('.prod_lists .prod_item.desk-prod-item').each(function() {
        let titleElement = $(this).find('.prod_item_title')
        const itemVariantVal = $(this).find('.prod_item-variants')
        let title = titleElement.text().trim()
        let partsVal = title.split('-')
        if (partsVal[1]) {
          itemVariantVal.prepend(partsVal[1])
          titleElement.text(partsVal[0].trim())
        }
      })
    }, 0)
    
    setTimeout(function() {
      $('.prod_item_title').each(function() {
        // old
        var txt = $(this).text().trim();
        // new
        if (txt.endsWith(' Gaming Chair')) {
          txt = txt.replace(/ Gaming Chair$/, '');
          $(this).text(txt);
        }
      });
    }, 0)
    // replace ' '
    setTimeout(() => {
      $('.prod_lists .prod_item .prod_item_price .prod_item_discount_price').each(function() {
        const originalText = $(this).text();
        const noSpaces = originalText.replace(/\s+/g, '');
        $(this).text(noSpaces);
      })
    }, 0)

     // link
    $('.but-link').on('click', function() {
      const url = $(this).data('href')
      window.location.href = url
    })
    $('.bundle-prod-items.bundle-cont-link').on('click', function() {
      const url = $(this).data('href')
      window.location.href = url
    })
  })
</script>

