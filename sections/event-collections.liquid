<style>
  .event-page-collections{
    padding: 100px 0 200px;
    background: #EFEFEF;
  }
  .event-page-collections .module-title{
    font: 700 50px var(--font-family-1);
    color: #262626;
    margin: 0 auto 45px;
    text-align: center;
  }
  .module-title.edition-module-title,
  .module-title.desk-module-title,
  .module-title.bundle-module-title,
  .module-title.accessory-module-title{
    margin-top: 100px;
    display: flex;
    flex-direction: column;
  }

  /* IPhone */
  @media(max-width: 767px) {
    .event-page-collections{
      padding: 50px 0 100px;
    }
    .event-page-collections .module-title{
      font-size: 20px;
      margin-bottom: 20px;
    }
    .module-title.edition-module-title,
    .module-title.desk-module-title,
    .module-title.bundle-module-title,
    .module-title.accessory-module-title{
      margin-top: 50px;
    }
  }
  @media(min-width: 1025px) and (max-width: 1600px) {
    .module-title.chairs-module-title span:after{
      width: 45px;
      height: 45px;
    }
  
  }
</style>


<section class="event-page-collections" id="{{ section.id }}">
  {% if section.settings.customHTMLCSS != blank %}
      {{ section.settings.customHTMLCSS }}
  {% endif %}
  <div class="container-1570">
    <!-- chairs -->
    <div class="module-title chairs-module-title">
      {% if section.settings.SectionTitlePre != blank %}
        <img src="{{ section.settings.SectionTitlePre | img_url: 'master' }}" class="section-title-pre-icons" />
      {% endif %}
      {% if section.settings.sectionTitle != blank %}
        <span>{{ section.settings.sectionTitle }}</span>
      {% endif %}
      {% if section.settings.sectionTitleNext != blank %}
        <img src="{{ section.settings.sectionTitleNext | img_url: 'master' }}" class="section-title-next-icons" />  
      {% endif %}
      {% if section.settings.sectionDesc != blank %}
        <span>{{ section.settings.sectionDesc }}</span>
      {% endif %}
    </div>
    <div class="top-pick-module">
      {% for block in section.blocks %}
        {% if block.type == "topPickItem" %}
            {% render 'top-pick-component', block: block %}
        {% endif %}
      {% endfor %}
    </div>
    {% for block in section.blocks %}
      {% if block.type == 'chairCollection' %}
        {% render 'chairs-component', block: block %}
      {% endif %}
    {% endfor %}
    <!-- edition Chairs -->
    <div class="module-title edition-module-title">
