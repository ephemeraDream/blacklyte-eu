<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">

<style>
    .robot-event-imgs-section{
        background: #000;
        margin-top: -1px;
    }
    .subsc-middle-image-container .middle-image-title{
        font-family: 'The 2K12';
        font-weight: 400;
        font-size: 10.67vw;
        line-height: 1.4;
        letter-spacing: 0%;
        text-align: center;
        vertical-align: middle;
        color: #FFFFFF;
        margin-bottom: 20px;
    }
</style>

<div class="robot-event-imgs-section">
    <div class="container-full">
        {% for block in section.blocks %}
            {% if block.type == "middleImageItem" %}
                <div class="subsc-middle-image-container">
                    {% if block.settings.middleImageItemTitle != blank %}
                        <div class="middle-image-title">{{ block.settings.middleImageItemTitle }}</div>
                    {% endif %}
                    {% if block.settings.middleImageItemMainImage != blank %}
                        <div class="middle-image-cont">
                            {% render 'picture-simple',
                                image: block.settings.middleImageItemMainImage,
                                image_mobile: block.settings.middleImageItemMainImage,
                                mobile_dpr: 2,
                                loading: "eager"
                            %}
                        </div>
                    {% endif %}
                    
                </div>
            {% endif %}
        {% endfor %}
                
    </div>
</div>

{% schema %}
{
    "name": "Robot Event Imgs",
    "tag": "section",
    "settings": [],
    "blocks": [
        {
            "type": "middleImageItem",
            "name": "middleImageItem",
            "settings": [
                {
                    "type": "text",
                    "id": "middleImageItemTitle",
                    "label": "middle Image Item Title"
                },
                {
                    "type": "image_picker",
                    "id": "middleImageItemMainImage",
                    "label": "middle Image Item Main Image"
                }
            ]
        }
    ],
    "presets": [{ "name": "Robot Event Imgs" }]
}
{% endschema %}