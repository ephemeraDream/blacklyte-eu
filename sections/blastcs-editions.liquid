                    "label": "middle Main Image 2 Link"
                },
                {
                    "type": "text",
                    "id": "itemProdTitle",
                    "label": "item Product Title"
                },
                {
                    "type": "text",
                    "id": "itemProdTitleSec",
                    "label": "item Product Title 2"
                },
                {
                    "type": "text",
                    "id": "itemProdButtonTitle",
                    "label": "item Product Button Title"
                }
            ]
        },
        {
            "type": "largeImage",
            "name": "largeImage",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "largeMainImage",
                    "label": "large Main Image"
                },
                {
                    "type": "url",
                    "id": "largeMainImageLink",
                    "label": "large Main Image Link"
                },
                {
                    "type": "image_picker",
                    "id": "largeMainImageBottom",
                    "label": "large Main Image 2"
                },
                {
                    "type": "url",
                    "id": "largeMainImageBottomLink",
                    "label": "large Main Image 2 Link"
                },
                {
                    "type": "text",
                    "id": "itemProdTitle",
                    "label": "item Product Title"
                },
                {
                    "type": "text",
                    "id": "itemProdTitleSec",
                    "label": "item Product Title 2"
                },
                {
                    "type": "text",
                    "id": "itemProdButtonTitle",
                    "label": "item Product Button Title"
                }
            ]
        },
        {
            "type": "smallImageMobile",
            "name": "smallImageMobile",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "mobileSmallImage",
                    "label": "mobile Small Image Swiper"
                },
                {
                    "type": "url",
                    "id": "mobileSmallImageLink",
