<div class="ai-robot-subscribe-section">
    {% liquid
      assign section_bg_image = section.settings.sectionBgImage
      assign section_bg_image_mb = section.settings.sectionBgImage_mb
    %}

    <style>
        .ai-robot-subscribe-section .container-full{
            {% if section_bg_image != blank %}
                background-image: url('{{ section_bg_image | img_url: "1920x" }}');
            {% else %}
                background-color: #000;
            {% endif %}
            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;
            width: 100%;
            position: relative;
            aspect-ratio: 1920 / 1820;
            
        }

        @media(max-width: 767px){
            .ai-robot-subscribe-section .container-full{
                {% if section_bg_image_mb != blank %}
                    background-image: url('{{ section_bg_image_mb | img_url: "800x" }}');
                {% elsif section_bg_image != blank %}
                    background-image: url('{{ section_bg_image | img_url: "800x" }}');
                {% endif %}
                background-size: cover;
                background-position: center;
                
            }
        }

    </style>
    <div class="container-full">
        {% if section.settings.sectionTitle != blank or section.settings.sectionDescription != blank %}
            <div class="subsc-head-cont">
                {% if section.settings.sectionTitle != blank %}
                    <div class="subsc-section-title">{{ section.settings.sectionTitle }}</div>
                {% endif %}

                {% if section.settings.sectionDescription != blank %}
                    <div class="subsc-section-desc">{{ section.settings.sectionDescription }}</div>
                {% endif %}
            </div>
        {% endif %}

        {% for block in section.blocks %}
            {% if block.type == "item" %}
                <div class="subsc-large-image-container">
                    {% if block.settings.itemMainImage != blank or block.settings.itemMainImage_mb != blank %}
                        <div class="subsc-image-left">
                            {% render 'picture-simple',
                                image: block.settings.itemMainImage,
                                image_mobile: block.settings.itemMainImage_mb,
                                mobile_dpr: 2,
                                loading: "eager"
                            %}
                        </div>
                    {% endif %}
                    <div class="subsc-image-right">
                        {% if block.settings.itemTitle != blank %}
                            <div class="right-title">{{ block.settings.itemTitle }}</div>
                        {% endif %}
                        {% if block.settings.itemDescription != blank %}
                            <div class="right-desc">{{ block.settings.itemDescription }}</div>
                        {% endif %}
                        {% if block.settings.itemDiscountPrice != blank or block.settings.itemOriginalPrice != blank %}
                            <div class="right-prices-cont">
                                {% if block.settings.itemDiscountPrice != blank %}
                                    <span class="right-discount-price">{{ block.settings.itemDiscountPrice }}</span>
                                {% endif %}
                                {% if block.settings.itemOriginalPrice != blank %}
                                    <span class="right-original-price{% if block.settings.itemDiscountPrice != blank %} right-original-discount-price{% endif %}">{{ block.settings.itemOriginalPrice }}</span>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if block.settings.countdownTitle != blank or block.settings.countdownTime != blank %}
                            <div class="right-count-down-cont">
                                {% if block.settings.countdownTitle != blank %}
                                    <div class="right-countdown-title">{{ block.settings.countdownTitle }}</div>
                                {% endif %}

                                {% if block.settings.countdownTime != blank %}
                                    <div class="right-countdown-times" data-countdown-time="{{ block.settings.countdownTime }}"></div>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if block.settings.itemButton != blank %}
                            <div class="right-buttons">{{ block.settings.itemButton }}</div>
                        {% endif %}
                    </div>
                    {% if block.settings.itemTagText != blank %}
                        <div class="subsc-item-tag">{{ block.settings.itemTagText }}</div>
                    {% endif %}

                    {% if block.settings.itemFeatureInfoFir != blank %}
                        <div class="feature-list">
                            <div class="feature-item">
                                <h3 class="item-title">{{ block.settings.itemFeatureInfoFir }}</h3>
                                <div class="item-desc">
                                    {{ block.settings.itemFeatureInfoFirDesc }}
                                </div>
                            </div>

                            <div class="feature-item">
                                <h3 class="item-title">{{ block.settings.itemFeatureInfoSec }}</h3>
                                <div class="item-desc">
                                    {{ block.settings.itemFeatureInfoSecDesc }}
                                </div>
                            </div>

                            <div class="feature-item">
                                <h3 class="item-title">{{ block.settings.itemFeatureInfoThird }}</h3>
                                <div class="item-desc">
                                    {{ block.settings.itemFeatureInfoThirdDesc }}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>

            {% elsif block.type == "smallImageItem" %}
                <div class="subsc-small-image-container">
                    {% if block.settings.smallItemMainImage != blank or block.settings.smallItemMainImage_mb != blank %}
                        {% render 'picture-simple',
                            image: block.settings.smallItemMainImage,
                            image_mobile: block.settings.smallItemMainImage_mb,
                            mobile_dpr: 2,
                            loading: "eager"
                        %}
                    {% endif %}
                </div>

            {% endif %}
        {% endfor %}

    </div>
</div>

<div id="subscribe-modal-overlay" class="modal-overlay">
    <div class="subscribe-modal-content">
        <button class="modal-close-btn" id="close-subscribe-modal">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6L18 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>

        <h2 class="modal-title">{{ section.settings.itemSubscTitle }}</h2>
        <p class="modal-desc">{{ section.settings.itemSubscDescripe }}</p>

        {% form 'customer', class: 'modal-form' %}
            <div class="input-group">
                <input type="hidden" name="contact[tags]" value="AiRobot">
                <input type="email" name="contact[email]" placeholder="Enter your email address" required>
                <button type="submit" class="subscribe-btn">{{ section.settings.itemSubscButton }}</button>
            </div>
        {% endform %}
    </div>
</div>

<script>
    (function() {

        function initCountdown() {
            const countdownElements = document.querySelectorAll('.right-countdown-times');

            countdownElements.forEach(container => {
                const endTimeStr = container.getAttribute('data-countdown-time');
                if (!endTimeStr) return;

                const endTime = new Date(endTimeStr).getTime();

                const update = () => {
                const now = new Date().getTime();
                const distance = endTime - now;

                if (distance < 0) {
                    container.innerHTML = "EXPIRED";
                    return;
                }

            
                const hours = Math.floor((distance / (1000 * 60 * 60)));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            
                const fH = hours.toString().padStart(2, '0');
                const fM = minutes.toString().padStart(2, '0');
                const fS = seconds.toString().padStart(2, '0');

                
                container.innerHTML = `
                    <div class="countdown-wrapper">
                    <div class="time-group">
                        <span class="num">${fH}</span>
                        <span class="label">Hour</span>
                    </div>
                    <span class="separator">:</span>
                    <div class="time-group">
                        <span class="num">${fM}</span>
                        <span class="label">Minums</span>
                    </div>
                    <span class="separator">:</span>
                    <div class="time-group">
                        <span class="num">${fS}</span>
                        <span class="label">Secords</span>
                    </div>
                    </div>
                `;
                };

                update();
                {% comment %} setInterval(update, 1000); {% endcomment %}
            });
        }

        const modal = document.getElementById('subscribe-modal-overlay');
        const openBtn = document.querySelector('.ai-robot-subscribe-section .subsc-image-right .right-buttons');
        const closeBtn = document.getElementById('close-subscribe-modal');


        if(!modal) return false;
        if(!openBtn) return false;
        if(!closeBtn) return false;

    
        openBtn.addEventListener('click', () => {
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        });

        
        const hideModal = () => {
            modal.style.display = 'none';
            document.body.style.overflow = '';
        };

        closeBtn.addEventListener('click', hideModal);

    
        window.addEventListener('click', (e) => {
            if (e.target === modal) {
                hideModal();
            }
        });
    })();

</script>


