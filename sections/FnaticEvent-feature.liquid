<style>
  .section-{{ section.id }} {
      background: #060708;
  }
  .section-{{ section.id }} .container-full{
      padding: 47px 16% 70px;
  }

  .section-{{ section.id }} .container-full .head-cont{
      width: 100%;
      padding: 75px 160px 67px;
      position: relative;
      z-index: 1;
      border-radius: 67px;
      overflow: hidden;
  }

  .section-{{ section.id }} .container-full .head-cont::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: -1;
      padding: 1px;
      background: linear-gradient(85.57deg, #2C2C2C 9.88%, rgba(255, 255, 255, 0.5) 54.4%, #FF5900 78.18%, rgba(255, 255, 255, 0.5) 99.79%);

      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;

      border-radius: 67px;
  }
  .section-{{ section.id }} .container-full .section-sub-title{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: 20px;
      line-height: 1.2;
      letter-spacing: 0%;
      text-align: center;
      color: #fff;
  }
  .section-{{ section.id }} .container-full .section-title{
      font-family: Poppins;
      font-weight: 600;
      font-style: SemiBold;
      font-size: 30px;
      line-height: 1.2;
      letter-spacing: 0%;
      text-align: center;
      color: #E25301;
      margin: 10px 0 10px;
  }
  .section-{{ section.id }} .container-full .section-desc{
      font-family: Poppins;
      font-weight: 400;
      font-style: Regular;
      font-size: 16px;
      line-height: 26px;
      letter-spacing: 0%;
      text-align: center;
      color: #FFFFFF;
  }

  .section-{{ section.id }} .container-full .item-head-cont{
      font-family: Poppins;
      font-weight: 600;
      font-style: SemiBold;
      font-size: 36px;
      line-height: 100%;
      letter-spacing: 0%;
      text-align: center;
      color: #fff;
  }

  .section-{{ section.id }} .container-full .feature-lists{
      padding-top: 135px;
  }

  .section-{{ section.id }} .container-full .feature-lists img{
      height: auto;
  }
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts{
      margin-top: 100px;
      display: flex;
      align-items: center;
  }

  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-left,
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right{
      width: 50%;
  }
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right{
      padding: 58px 50px 100px;
      border-radius: 10px;
      position: relative;
      z-index: 1;
      background: linear-gradient(360deg, rgba(0, 0, 0, 0.5) 0%, #000000 100%);
  }
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right:before{
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: -1;
      padding: 1px;
      background: linear-gradient(85.57deg, #2C2C2C 9.88%, rgba(255, 255, 255, 0.5) 54.4%, #FF5900 78.18%, rgba(255, 255, 255, 0.5) 99.79%);

      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;

      border-radius: 10px;
  }


  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-prod-title{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: 36px;
      line-height: 100%;
      letter-spacing: 0%;
      color: #fff;
  }

  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-prod-desc{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: 16px;
      line-height: normal;
      letter-spacing: 0%;
      text-transform: capitalize;
      color: #fff;
      margin-top: 10px;
  }

  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-svg svg{
      width: 90%;
      height: auto;
      margin-top: 50px;
  }
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists{
      display: flex;
      gap: 18px;
      margin-top: 13px;
  }
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items{
      width: calc((100% - 54px) / 4);
      cursor: pointer;
      position: relative;
  }
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items svg{
      height: 100%;
      width: 100%;
  }

  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-button{
      display: block;
      font-family: DIN;
      font-weight: 500;
      font-style: Medium;
      font-size: 30px;
      line-height: 100%;
      letter-spacing: 0%;
      color: #fff;
      padding: 16px 0;
      width: 100%;
      background: #E25301;
      margin-top: 63px;
      text-align: center;
      border-radius: 60px;
      transition: all .35s ease;
  }
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-button[aria-disabled="true"]{
      opacity: 0.3;
      pointer-events: none;
  }

  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-button:hover{
      box-shadow: 0 0 10px #e25301;
  }

  .section-{{ section.id }} .container-full .feature-lists .icon-items .feature-info-cont{
      position: absolute;
      padding: 20px;
      background: #fff;
      left: 0;
      width: 280px;
      top: calc(100% + 10px);
      border-radius: 5px;
      opacity: 0;
      z-index: -5;
      transition: opacity 0.3s ease;
  }

  .section-{{ section.id }} .container-full .feature-lists .icon-items .feature-info-cont.active{
      opacity: 1;
      z-index: 2;
  }

  .feature-info-cont::before {
      content: '';
      position: absolute;
      top: -20px;
      left: 20px;
      width: 0;
      height: 0;
      border-style: solid;
      border-width: 10px;
      border-color: transparent transparent #ffffff transparent;
  }

  .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .info-title,
  .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .info-sub-title{
      font-family: Poppins;
      font-weight: 600;
      font-style: SemiBold;
      font-size: 10px;
      line-height: 100%;
      letter-spacing: 0%;
      color: #262629;
  }

  .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .info-sub-title{
      margin-top: 6px;
  }

  .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .line-center{
      line-height: 0;
      margin: 10px 0;
  }

  .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .info-desc{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: 10px;
      line-height: inherit;
      letter-spacing: 0%;
      color: #262629;
      opacity: 0.7;
  }

  .section-{{ section.id }} .container-full .feature-lists .icon-items.feature-item-active{
      box-shadow: 1px 1px 6.5px 5px #E25301;
  }

  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(3) .feature-info-cont,
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(4) .feature-info-cont{
      right: 0;
      left: auto;
  }

  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(3) .feature-info-cont::before,
  .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(4) .feature-info-cont::before{
      left: auto;
      right: 20px;
  }

  .section-{{ section.id }} .item-prod-tag{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: 20px;
      line-height: 26px;
      letter-spacing: 0%;
      text-align: center;
      color: #fff;
      padding: 2px 13px;
      background: #E25301;
      margin-bottom: 50px;
      width: max-content;
  }

  {% comment %} 购买跟随 {% endcomment %}
  .sticky-dom-chair{
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background-color: #f5f5f5;
      transform: translateZ(0);
      transition: all .3s ease-in-out;
      box-shadow: -.15625vw -.15625vw .15625vw #dfdfdf40;
      padding: 13px 7.34375vw;
      opacity: 0;
      z-index: -1;
      max-width: 100%;
      overflow: hidden;
  }
  .sticky-dom-chair .prod-info{
      display: flex;
      align-items: center;
      justify-content: space-between;
  }
  .sticky-dom-chair .prod-info .prod-img .sticky_prod_variant_image{
      width: 100%;
      height: 100%;
      background-color: #e5e5e5;
      object-fit: contain;
      object-position: center center;
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      right: 0;
      opacity: 0;
  }
  .sticky-dom-chair .prod-info .prod-img .sticky_prod_variant_image.sticky_prod_variant_image_active{
      opacity: 1;
  }
  .sticky-dom-chair .prod-info .prod-img .sticky_prod_variant_image.sticky_prod_variant_image_hidden{
      opacity: 0;
  }
  .sticky-dom-chair .prod-info .left-cont{
      display: flex;
      align-items: center;
      gap: 5px;
  }
  .sticky-dom-chair .prod-info .left-cont .prod-img{
      position: relative;
      width: 60px;
      height: 60px;
      border-radius: 10px;
      overflow: hidden;
  }
  .sticky-dom-chair .prod-info .prod-title{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(16px, .833vw, .833vw);
      leading-trim: NONE;
      line-height: 100%;
      letter-spacing: 0%;
      vertical-align: middle;
      color: #262629;
  }
  .sticky-dom-chair .prod-info .price-sale-cont{
      display: flex;
      align-items: center;
      justify-content: flex-end;
  }
  .sticky-dom-chair .prod-info .discount-price-info,
  .sticky-dom-chair .prod-info .origa-price{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(20px, 1.25vw, 1.25vw);
      leading-trim: NONE;
      line-height: 100%;
      letter-spacing: 0%;
      vertical-align: middle;
      color: #262629;
  }
  .sticky-dom-chair .prod-info .discount-price-info+.origa-price{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(12px, .625vw, .625vw);
      leading-trim: NONE;
      line-height: clamp(14px, .729167vw, .729167vw);
      letter-spacing: 0%;
      vertical-align: middle;
      text-decoration: line-through;
      color: #26262980;
      margin-left: .3125vw;
  }
  .sticky-dom-chair .prod-info .save-tag{
      padding: 0 .3125vw;
      background: #af1c1c;
      border-radius: .15625vw;
      color: #fff;
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(12px, .625vw, .625vw);
      leading-trim: NONE;
      letter-spacing: 0%;
      display: flex;
      align-items: center;
      height: 1.145833vw;
      min-height: 22px;
      margin-left: .46875vw;
  }
  .sticky-dom-chair .price-cont{
      display: flex;
      align-items: center;
      gap: 10px;
  }
  .sticky-dom-chair .price-cont .price-container-left{
      display: flex;
      flex-direction: column;
      gap: 6px;
  }
  .sticky-dom-chair .price-cont .payment-info{
      display: flex;
      align-items: baseline;
  }
  .sticky-dom-chair .price-cont .payment-text-info{
      display: flex;
      align-items: baseline;
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(14px, .7291667vw, .7291667vw);
      leading-trim: NONE;
      line-height: clamp(18px, .9375vw, .9375vw);
      letter-spacing: 0%;
      vertical-align: middle;
      color: #262629b3;
      margin-top: .15625vw;
      white-space: nowrap;
  }
  .sticky-dom-chair .price-cont .payment-logo img{
      min-width: 42px;
      width: 2.1875vw;
      height: auto;
      margin-left: .15625vw;
  }
  .sticky-dom-chair .prod-buy-it-now{
      background: #262629;
      color: #fff;
      border: none;
      position: relative;
      width: 10.15625vw;
      flex: 0 0 auto;
      height: 2.65625vw;
      min-height: 38px;
      border-radius: 3.28125vw;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(14px, .7291667vw, .7291667vw);
      line-height: 100%;
      letter-spacing: 0%;
      transition: all .4s ease-out;
      text-transform: uppercase;
  }
  .sticky-dom-chair .prod-buy-it-now:hover{
      box-shadow: 0 0 10px #262629;
      opacity: 0.95;
  }
  .sticky-dom-chair .prod-buy-it-now:before{
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      background: linear-gradient(120deg, #fff3 49.9%, #fff0 50%) no-repeat 100% 100%;
      background-size: 300% 100%;
      border-radius: 90px;
      transition: background-position .4s ease-out;
  }

  {% comment %} iPhone {% endcomment %}
  @media(max-width: 767px){
      .section-{{ section.id }} .container-full-2{
          padding-top: 34px;
      }
      .section-{{ section.id }} .container-full{
          padding-left: 10px;
          padding-right: 10px;
      }
      .section-{{ section.id }} .container-full .head-cont{
          padding: 30px 19px 24px;
      }
      .section-{{ section.id }} .container-full .section-sub-title{
          font-size: 16px;
      }
      .section-{{ section.id }} .container-full .section-title{
          font-size: 20px;
          line-height: 30px;
      }
      .section-{{ section.id }} .container-full .section-desc{
          font-size: 14px;
          line-height: 24px;
      }
      .section-{{ section.id }} .container-full .head-cont{
          border-radius: 30px;
      }
      .section-{{ section.id }} .container-full .head-cont::before{
          border-radius: 30px;
      }

      .section-{{ section.id }} .container-full .feature-lists .item-item-conts{
          flex-direction: column;
          margin-top: 20px;
      }

      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-left,
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right{
          width: 100%;
      }
      .section-{{ section.id }} .container-full .feature-lists{
          margin-top: 0;
          padding-top: 0;
      }
      .section-{{ section.id }} .container-full .item-head-cont{
          font-size: 22px;
          line-height: 30px;
      }
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right{
          padding: 27px;
      }
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-prod-title{
          font-size: 20px;
          line-height: 30px;
      }
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-prod-desc{
          font-size: 14px;
          line-height: 22px;
      }
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-svg svg{
          margin-top: 23px;
      }
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .item-button{
          font-size: 20px;
          line-height: normal;
          padding-top: 10px;
          padding-bottom: 10px;
          margin-top: 35px;
      }

      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(2) .feature-info-cont{
          transform: translateX(-60px);
      }
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(2) .feature-info-cont::before{
          left: 90px;
      }

      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(3) .feature-info-cont{
          transform: translateX(60px);
          right: 0;
          left: auto;
      }
      .section-{{ section.id }} .container-full .feature-lists .item-item-conts .item-right .feature-icon-lists .icon-items:nth-of-type(3) .feature-info-cont::before{
          right: calc(10% + 60px);
      }

      .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .info-title,
      .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .info-sub-title{
          font-size: 8px;
      }

      .section-{{ section.id }} .container-full .feature-lists .feature-info-cont .info-desc{
          font-size: 9px;
      }
      .section-{{ section.id }} .container-full .feature-lists .icon-items .feature-info-cont{
          top: auto;
          bottom: calc(100% + 10px);
      }
      .feature-info-cont::before{
          border-width: 5px;
          top: auto;
          bottom: -9px;
          transform: rotate(180deg);
      }
      .section-{{ section.id }} .item-prod-tag{
          font-size: 14px;
          line-height: 26px;
          padding: 4px;
          margin-bottom: 10px;
      }

      {% comment %} 购买跟随 {% endcomment %}
      .sticky-dom-chair{
          padding: 10px;
      }
      .sticky-dom-chair .prod-info .prod-title{
          font-size: 10px;
          width: 110px;
          line-height: 1.3;
      }
      .sticky-dom-chair .prod-info .discount-price-info{
          font-size: clamp(16px, 1.25vw, 1.25vw);
      }
      .sticky-dom-chair .prod-info .origa-price{
          font-size: clamp(10px, .625vw, .625vw);
      }
      .sticky-dom-chair .prod-info .save-tag{
          font-size: clamp(10px, .625vw, .625vw);
      }
      .sticky-dom-chair .price-cont{
          flex-direction: column;
          gap: 5px;
      }
      .sticky-dom-chair .price-cont .price-container-left{
          gap: 6px;
      }
      .sticky-dom-chair .price-cont .payment-info{
          display: none;
      }
      .sticky-dom-chair .price-cont .payment-text-info{
          font-size: clamp(10px, .7291667vw, .7291667vw);
          white-space: normal;
      }
      .sticky-dom-chair .price-cont .payment-logo img{
          min-width: 36px;
          width: 1.1vw;
      }
      .sticky-dom-chair .prod-buy-it-now{
          width: 100%;
          height: 2vw;
          font-size: 10px;
          border-radius: 100px;
      }
      .sticky-dom-chair .prod-info .price-sale-cont{
          gap: 4px;
      }
  }

  {% comment %} iPad {% endcomment %}
  @media(min-width: 768px) and (max-width: 1024px){
      .section-{{ section.id }} .container-full{
          padding-left: 10px;
          padding-right: 10px;
      }
      .section-{{ section.id }} .container-full .head-cont{
          padding: 50px 50px 60px;
      }

      {% comment %} 购买跟随 {% endcomment %}
      .sticky-dom-chair{
          padding: 10px;
      }
  }

  {% comment %} small screen {% endcomment %}
  @media(min-width: 1025px) and (max-width: 1480px){
      .section-{{ section.id }} .container-full{
          padding-left: 60px;
          padding-right: 60px;
      }

      {% comment %} 购买跟随 {% endcomment %}
      .sticky-dom-chair{
          padding-left: 60px;
          padding-right: 60px;
      }
  }
</style>

<section class="section-{{ section.id }}" data-section-id="{{ section.id }}" id="{{ section.id }}">
  <div class="container-full">
    <div class="head-cont">
      {% if section.settings.sectionSubTitle != blank %}
        <div class="section-sub-title">{{ section.settings.sectionSubTitle }}</div>
      {% endif %}
      {% if section.settings.sectionTitle != blank %}
        <div class="section-title">{{ section.settings.sectionTitle }}</div>
      {% endif %}
      {% if section.settings.sectionDesc != blank %}
        <div class="section-desc">{{ section.settings.sectionDesc }}</div>
      {% endif %}
    </div>
  </div>
  <div class="container-full-2 container-full">
    <div class="feature-lists">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          {% if block.settings.blockItemBgImage != blank or block.settings.blockItemBgImage_mb != blank %}
            <style>
              .container-full-2{
                  background-image: url({{ block.settings.blockItemBgImage | img_url: 'master' }});
                  background-size: cover;
                  background-position: center;
                  background-repeat: no-repeat;
              }

              @media(max-width: 767px){
                  .container-full-2{
                      background-image: url({{ block.settings.blockItemBgImage_mb | img_url: 'master' }});
                  }
              }
            </style>
          {% endif %}
          <div class="feature-item">
            {% if block.settings.blockItemTitle != blank %}
              <div class="item-head-cont">{{ block.settings.blockItemTitle }}</div>
            {% endif %}
            <div class="item-item-conts">
              <div class="item-left" data-url="{{ block.settings.blockItemProd.url }}">
                <picture>
                  <source
                    media="(max-width: 768px)"
                    srcset="{{ block.settings.blockItemFeature_img_mb | image_url: width: 800 }}"
                    data-srcset="{{ block.settings.blockItemFeature_img_mb | image_url: width: 800 }}"
                  >

                  <img
                    {% render 'lazyload',
                      preview_img: block.settings.blockItemFeature_img,
                      class: true,
                      enable_rtl: settings.enable_layout_rtl
                    %}
                    width="{{ block.settings.blockItemFeature_img.width }}"
                    height="{{ block.settings.blockItemFeature_img.height }}"
                    alt="{{ block.settings.blockItemFeature_img.alt | escape }}"
                    loading="lazy"
                    decoding="async"
