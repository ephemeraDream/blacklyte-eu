<script>
  (function () {
    const chair = document.querySelector('.sticky-dom-chair');
    if (!chair) return;

    chair.style.opacity = '0';
    chair.style.zIndex = '0';
    chair.style.transition = 'opacity 0.35s ease';

    let windowHeight = window.innerHeight;
    let ticking = false;

    function updateWindowHeight() {
      windowHeight = window.innerHeight;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          if (scrollTop >= 1.5 * windowHeight) {
            console.log('scrollTop');
            chair.style.opacity = '1';
            chair.style.zIndex = '999';
          } else {
            chair.style.opacity = '0';
            chair.style.zIndex = '0';
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      updateWindowHeight();
      onScroll();
    });

    updateWindowHeight();
    onScroll();
  })();

  (function () {
    $('.sticky-dom-chair .prod-buy-it-now').on('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      const url = $(this).data('href');
      const variantId = $('.sticky-dom-chair .sticky_prod_variant_image_active').data('variant');
      window.location.href = `${url}?variant=${variantId}`;
    });
  })();

  $(document).ready(function () {
    document.querySelectorAll('.feature-icon-lists .icon-items').forEach(function (item) {
      const isMobile = window.matchMedia('only screen and (max-width: 768px)').matches;

      function handleMouseOver() {
        if (item.classList.contains('feature-item-active')) {
          item.classList.remove('feature-item-active');
        } else {
          document.querySelectorAll('.feature-icon-lists .icon-items').forEach(function (featureItem) {
            featureItem.classList.remove('feature-item-active');
          });
          item.classList.add('feature-item-active');
        }

        var target = item.querySelector('.feature-info-cont');
        if (!target) return;

        if (target.classList.contains('active')) {
          target.classList.remove('active');
          return;
        }

        document.querySelectorAll('.feature-info-cont.active').forEach(function (desc) {
          desc.classList.remove('active');
        });

        target.classList.add('active');
      }

      function handleMouseOut() {
        var target = item.querySelector('.feature-info-cont');
        if (target) {
          target.classList.remove('active');
        }

        item.classList.remove('feature-item-active');
      }

      if (isMobile) {
        item.addEventListener('click', function () {
          handleMouseOver();
        });
      } else {
        item.addEventListener('mouseover', handleMouseOver);
        item.addEventListener('mouseout', handleMouseOut);
      }
    });
  });

  $(document).ready(function () {
    $('.feature-item .item-left').click(function () {
      const url = $(this).data('url');
      if (url) {
        window.location.href = url;
      }
    });
  });
</script>

