  "name": "ergonomics section six",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "title"
    }
  ],
  "blocks": [
    {
      "type": "first_part",
      "name": "first part",
      "settings": [
        {
          "type": "textarea",
          "id": "title",
          "label": "title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "image"
        }
      ]
    },
    {
      "type": "second_part",
      "name": "second part",
      "settings": [
        {
          "type": "textarea",
          "id": "title",
          "label": "title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "text"
        },
        {
          "type": "image_picker",
          "id": "left_image",
          "label": "left image"
        },
        {
          "type": "textarea",
          "id": "right_title_one",
          "label": "right title one"
        },
        {
          "type": "textarea",
          "id": "right_text_one",
          "label": "right text one"
        },
        {
          "type": "textarea",
          "id": "right_title_two",
          "label": "right title two"
        },
        {
          "type": "textarea",
          "id": "right_text_two",
          "label": "right text two"
        },
        {
          "type": "textarea",
          "id": "right_title_three",
          "label": "right title three"
        },
        {
          "type": "textarea",
          "id": "right_text_three",
          "label": "right text three"
        },
        {
          "type": "image_picker",
          "id": "bottom_image",
          "label": "bottom image"
        },
        {
          "type": "textarea",
          "id": "bottom_title",
          "label": "bottom title"
        },
        {
          "type": "textarea",
          "id": "bottom_text",
          "label": "bottom text"
        }
      ]
    },
    {
      "type": "third_part",
      "name": "third part",
      "settings": [
        {
          "type": "textarea",
          "id": "title",
          "label": "title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "text"
        },
        {
          "type": "image_picker",
          "id": "left_image",
          "label": "left image"
        },
        {
          "type": "image_picker",
          "id": "bottom_image",
          "label": "bottom image"
        },
        {
          "type": "textarea",
          "id": "bottom_title",
          "label": "bottom title"
        },
        {
          "type": "textarea",
          "id": "bottom_text",
          "label": "bottom text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ergonomics section six"
    }
  ]
}
{% endschema %}
