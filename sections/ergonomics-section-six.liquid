{{ 'ergonomics-section-six.css' | asset_url | stylesheet_tag }}

<div class="ergonomics_section_six">
  <div class="ergonomics_section_six_title">{{ section.settings.title }}</div>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {% when 'first_part' %}
        <div class="first_part">
          <div>
            <div class="first_part_title">{{ block.settings.title }}</div>
            <div class="first_part_text">{{ block.settings.text }}</div>
          </div>
          {{-
            block.settings.image
            | image_url: width: block.settings.image.width
            | image_tag: alt: block.settings.image.alt, class: 'first_part_img'
          -}}
        </div>
      {%- when 'second_part' -%}
        <div class="second_part">
          <div class="second_part_title">{{ block.settings.title }}</div>
          <div class="second_part_text">{{ block.settings.text }}</div>
          <div class="second_part_contain">
            {{-
              block.settings.left_image
              | image_url: width: block.settings.left_image.width
              | image_tag: alt: block.settings.left_image.alt, class: 'second_part_leftimg'
            -}}
            <div>
              <div class="second_part_contain_item">
                <div class="second_part_contain_item_title">{{ block.settings.right_title_one }}</div>
                <div class="second_part_contain_item_text">{{ block.settings.right_text_one }}</div>
              </div>
              <div class="second_part_contain_item">
                <div class="second_part_contain_item_title">{{ block.settings.right_title_two }}</div>
                <div class="second_part_contain_item_text">{{ block.settings.right_text_two }}</div>
              </div>
              <div class="second_part_contain_item">
                <div class="second_part_contain_item_title">{{ block.settings.right_title_three }}</div>
                <div class="second_part_contain_item_text">{{ block.settings.right_text_three }}</div>
              </div>
            </div>
          </div>
          <div class="second_part_bottom">
            {{-
              block.settings.bottom_image
              | image_url: width: block.settings.bottom_image.width
              | image_tag: alt: block.settings.bottom_image.alt, class: 'second_part_bottomimg'
            -}}
            <div>
              <div class="second_part_bottom_title">{{ block.settings.bottom_title }}</div>
              <div class="second_part_bottom_text">{{ block.settings.bottom_text }}</div>
            </div>
          </div>
        </div>
      {%- when 'third_part' -%}
        <div class="third_part">
          <div class="third_part_title">{{ block.settings.title }}</div>
          <div class="third_part_contain">
            {{-
              block.settings.left_image
              | image_url: width: block.settings.left_image.width
              | image_tag: alt: block.settings.left_image.alt, class: 'third_part_leftimg'
            -}}
            <div class="third_part_text">{{ block.settings.text }}</div>
          </div>
          <div class="third_part_bottom">
            {{-
              block.settings.bottom_image
              | image_url: width: block.settings.bottom_image.width
              | image_tag: alt: block.settings.bottom_image.alt, class: 'third_part_bottomimg'
            -}}
            <div>
              <div class="third_part_bottom_title">{{ block.settings.bottom_title }}</div>
              <div class="third_part_bottom_text">{{ block.settings.bottom_text }}</div>
            </div>
          </div>
        </div>
    {%- endcase -%}
  {% endfor %}
</div>

{% schema %}
