<style>
    .section-{{ section.id }}{
        padding-top: 100px;
        padding-bottom: 174px;
    }
    .section-{{ section.id }} .container-full{
        padding-left: 16%;
        padding-right: 16%;
    }
    .section-{{ section.id }} .cont{
        text-align: center;
    }
    .section-{{ section.id }} .cont .cont-title{
        font: 700 50px 'DIN';
        color: #FFB321;
    }
    .section-{{ section.id }} .cont .cont-desc{
        font: 700 50px 'DIN';
        color: #FFF;
    }
    .section-{{ section.id }} .part-logos{
        display: flex;
        gap: 60px;
        justify-content: center;
        margin-top: 68px;
    }
    .section-{{ section.id }} .event-images{
        display: flex;
        gap: 30px;
        justify-content: center;
        margin-top: 100px;
    }
    .section-{{ section.id }} .event-image-item{
        width: calc((100% - 120px) / 5);
    }
    .section-{{ section.id }} .event-image-item:nth-of-type(2n + 1){
        margin-top: 78px;
    }

    {% comment %} iPhone {% endcomment %}
    @media(max-width: 767px) {
        .section-{{ section.id }} {
            padding-top: 100px;
            padding-bottom: 100px;
        }
        .section-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
        }
        .section-{{ section.id }} .cont .cont-title,
        .section-{{ section.id }} .cont .cont-desc{
            font-size: 17px;
        }
        .section-{{ section.id }} .part-logos{
            gap: 0;
            margin-top: 10px;
        }
        .section-{{ section.id }} .part-logos .part-logo-item{
            width: calc((100% - 60px) / 5)
        }
        .section-{{ section.id }} .event-images{
            gap: 10px;
            margin-top: 30px;
        }
        .section-{{ section.id }} .event-image-item:nth-of-type(2n + 1){
            margin-top: 30px;
        }
        .section-{{ section.id }} .event-image-item{
            width: calc((100% - 50px) / 5);
        }
    
    }
    {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-{{ section.id }} .container-full{
            padding-left: 10px;
            padding-right: 10px;
        }
        .section-{{ section.id }} .cont .cont-title,
        .section-{{ section.id }} .cont .cont-desc{
            font-size: 40px;
        }
    
    }

    @media(min-width: 1025px) and (max-width: 1480px){
        .section-{{ section.id }} .container-full{
            padding-left: 60px;
            padding-right: 60px;
        }
    }
</style>

<section class="section-{{ section.id }}" id="{{ section.id }}" data-section-id="{{ section.id }}">
    {%- liquid
        assign bgImage = section.settings.sectionBgImage
        assign bgImageMb = section.settings.sectionBgImageMb
    -%}

    <style>
        .section-{{ section.id }} {
            background-image: url({{ bgImage | img_url: 'master' }});
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        @media (max-width: 767px) {
            .section-{{ section.id }} {
                background-image: url({{ bgImageMb | img_url: 'master' }});
                background-position: top;
            }
        }
    </style>
    <div class="container-full">
        <div class="cont">
            <div class="cont-title">{{ section.settings.sectionTitle }}</div>
            <div class="cont-desc">{{ section.settings.sectionDesc }}</div>
        </div>
        <div class="part-logos">
            {% for block in section.blocks %}
                {% if block.type == 'iconItem' %}
                    <div class="part-logo-item">
                        <img src="{{ block.settings.logoIcon | img_url: 'master' }}" />
                    </div>
                {% endif %}
            {% endfor %}
        </div>
        <div class="event-images">
            {% for block in section.blocks %}
                {% if block.type == 'eventItem' %}
                    <div class="event-image-item">
                        <img src="{{ block.settings.eventItemImage | img_url: 'master' }}" />
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "r6 Tournament",
    "settings": [
        {
            "type": "image_picker",
            "id": "sectionBgImage",
            "label": "Section Background Image"
        },
        {
            "type": "image_picker",
            "id": "sectionBgImageMb",
            "label": "Section Background Image Mobile"
        },
        {
        
            "type": "text",
            "id": "sectionTitle",
            "label": "Section Title",
            "default": "Open up the path to victory "
        },
        {
            "type": "text",
            "id": "sectionDesc",
            "label": "Section Descripe",
            "default": "in the most prestigious esports tournament"
        }
    ],
    "blocks": [
        {
            "type": "iconItem",
            "name": "iconItem",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "logoIcon",
                    "label": "logo Icon"
                }
            ]
        },
        {
            "type": "eventItem",
            "name": "eventItem",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "eventItemImage",
                    "label": "event Item Image"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "r6 Tournament"
        }
    ]
}
{% endschema %}