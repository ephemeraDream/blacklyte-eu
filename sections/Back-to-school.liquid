{% comment %}
  HLTV Collection
{% endcomment %}
<style>
  .hltv-event{
    background: #f5f5f5 url('https://cdn.shopify.com/s/files/1/0716/1341/5637/files/backToSchool-cont-bgImg.webp?v=1753164657') repeat;
    background-size: contain;
    padding: 200px 0;
  }
  .header-title{
    font: 700 60px var(--font-family-1);
    color: #F57220;
    text-align: center;
    margin-bottom: 80px;
  }
  .header-title.desk-header-title{
    margin: 100px auto 60px;
    position: relative;
  }
  .chairs_title-image-block{
    width: 80%;
    height: auto;
    margin: 0 auto;
  }
  .chairs_title-image-block.desks_title-image-block {
    width: 60%;
  }
  .block-chair-cont .top_pick{
    display: flex;
    background-color: #fff;
    padding: 20px 100px;
    cursor: pointer;
    border-radius: 16px;
    gap: 40px;
  }
  .block-chair-cont .top_pick .left{
    max-width: 400px;
  }
  .block-chair-cont .top_pick .right{
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    /* margin-left: 100px; */
  }
  .block-chair-cont .top_pick .right .top_pick_subtitle{
    font: 500 14px var(--font-family-1);
    color: #262629;
    line-height: 1.2;
  }
  .block-chair-cont .top_pick .right .top_pick_title{
    font: 500 40px var(--font-family-1);
    color: #262629;
    line-height: 1.4;
  }
  .block-chair-cont .top_pick .right .top_pick_desc{
    font: 400 20px var(--font-family-1);
    color: #262629;
    line-height: 1.6;
  }
  .block-chair-cont .top_pick .right .top_pick_prices{
    margin-top: 8px;
  }
  .block-chair-cont .top_pick .right .top_pick_prices .discount-price{
    font: 600 30px var(--font-family-1);
    color: #262626;
  }
  .block-chair-cont .top_pick .right .top_pick_prices .sale-price{
    font: 400 24px var(--font-family-1);
    color: #262626;
    text-decoration: line-through;
    margin-left: 6px;
  }
  
  .block-chair-cont .top_pick .right .top_pick_btn{
    font-family: var(--font-family-1);
    font-weight: 600;
    font-size: 24px;
    line-height: 26px;
    letter-spacing: 0;
    padding: 15px 0;
    border-radius: 30px;
    background: #FF7A25;
    max-width: 220px;
    text-align: center;
    color: #fff;
    margin-top: 20px;
    transition: all ease .3s;
    border: 1px solid #FF7A25;
  }
  .block-chair-cont .top_pick .right .top_pick_btn:hover,
  .prod_lists .prod_item .prod_item_price .shop_now_btn:hover {
    background: #fff;
    border-color: #FF7A25;
    color: #FF7A25;
  }
  .prod_lists {
    display: flex;
    gap: 17px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .prod_lists .prod_item{
    width: calc((100% - 51px) / 4);
    background-color: #fff;
    border-radius: 16px;
    position: relative;
  }
  .prod_lists .prod_item .container{
    display: flex !important;
    flex-direction: column;
    height: 100%;
  }
  .prod_lists .prod_item .prod_card_info{
    padding: 0 5px 27px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .prod_lists .prod_item .prod_item_title{
    font: 500 20px var(--font-family-1);
    color: #262629;
    line-height: 1.4;
  }
  .prod_lists .prod_item .prod_item-variants{
    font: 400 12px var(--font-family-1);
    color: #262629;
    margin-top: 6px;
  }
  .flex-1{
    display: block !important;
    flex: 1;
  }
  .prod_lists .prod_item .prod_item_price{
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 8px;
  }
  .prod_lists .prod_item .prod_item_price .price{ }
  .prod_lists .prod_item .prod_item_price .prod_item_discount_price{
    font: 500 22px var(--font-family-1);
    color: #262629;
    margin-right: 5px;
  }
  .prod_lists .prod_item .prod_item_price .prod_item_discount_price:before{
    display: inline-block;
    content: '$';
  }
  .prod_lists .prod_item .prod_item_price .prod_item_sale_price{
    font: 400 22px var(--font-family-1);
    color: #262629;
  }
  .prod_lists .prod_item .prod_item_price .prod_item_sale_price.prod_item_sale_price_new{
    text-decoration: line-through;
    font-size: 14px;
  }
  .prod_lists .prod_item .prod_item_price .shop_now_btn{
    font: 500 18px var(--font-family-1);
    color: #fff;
    width: 120px;
    line-height: 40px;
    text-align: center;
    border-radius: 30px;
    background: #FF7A25;
    transition: all ease .3s;
    border: 1px solid #FF7A25;
  }

  /* bundle */
  .module-title.bundle-title {
      margin: 100px auto 80px;
      font: 700 60px var(--font-family-1);
      color: #F57220;
      text-align: center;
  }
  .bundle-prod-lists {
    display: flex;
    gap: 40px;
    flex-direction: column;
  }
  .bundle-prod-lists .bundle-prod-items{
    flex: 1;
    padding: 38px 30px;
    border-radius: 16px;
    display: flex;
    background-color: #fff;
    align-items: center;
    cursor: pointer;
    position: relative;
  }
  .bundle-prod-lists .bundle-prod-items .bundle-middle-icon{
    margin: auto;
  }
  .bundle-prod-lists .bundle-prod-items .bundle-middle-icon svg{
    width: 54px;
    height: 54px;
    fill: none;
    stroke: none;
  }
  .bundle-prod-item-right-cont{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .bundle-prod-items-cont-left{
    display: flex;
    justify-content: space-between;
    width: calc(100% - 300px);
  }
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-left,
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-center{
    height: auto;
    background-color: #EFEFEF;
    border-radius: 16px;
    padding: 30px;
    flex: 1;
  }

  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-left .image-bundle,
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-center .image-bundle{
    width: 90%;
    margin: auto;
  }
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right{
    flex: 1;
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
  }
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-sale-price{
    font: 900 40px var(--font-family-1);
    color: #102E4A;
  }
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-discount-price{
    font: 900 30px var(--font-family-1);
    text-decoration: line-through;
    color: #262629;
    opacity: 0.5;
  }
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-shopnow-btn{
    margin-top: 20px;
    background-color: #FD9300;
    color: #fff;
    padding: 15px 59px;
    font: 600 26px var(--font-family-1);
    border-radius: 30px;
    cursor: pointer;
    border: 1px solid #FD9300;
    transition: all .3s ease;
  }
  .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-shopnow-btn:hover{
    background-color: rgba(0,0,0,0);
    border: 1px solid #FD9300;
    color: #FD9300;
  }
  .bundle-item-title{
    font: 500 20px var(--font-family-1);
    color: #262629;
    line-height: 1.4;
    text-align: center;
    margin-top: 20px;
  }

  
  
  
  /* IPhone */
  @media(max-width: 767px) {
    .hltv-event{
      padding: 50px 0;
    }
    .prod_lists {
      gap: 10px;
    }
    .header-title,.header-title.desk-header-title{
      font-size: 20px;
      margin: 40px auto 20px;
    }
    .header-title{
      margin-top: 0;
    }
    .block-chair-cont .top_pick{
      padding: 40px 10px;
      flex-direction: column;
      gap: 30px;
      border-radius: 8px;
    }
    .block-chair-cont .top_pick .left{
      max-width: 80%;
      margin: 0 auto;
    }
    .block-chair-cont .top_pick .right{
      margin-left: 0;
      padding: 0 10px;
    }
    .block-chair-cont .top_pick .right .top_pick_subtitle{
      font-size: 10px;
    }
    .block-chair-cont .top_pick .right .top_pick_title{
      font-size: 18px;
    }
    .block-chair-cont .top_pick .right .top_pick_desc{
      font-size: 10px;
    }
    .block-chair-cont .top_pick .right .top_pick_prices .discount-price{
      font-size: 18px;
    }
    .block-chair-cont .top_pick .right .top_pick_prices .sale-price{
      font-size: 16px;
    }
    .block-chair-cont .top_pick .right .top_pick_btn{
      font-size: 14px;
      line-height: 10px;
      max-width: none;
    }
    .prod_lists .prod_item{
      width: calc((100% - 10px) / 2);
      border-radius: 8px;
    }
    .prod_lists .prod_item .prod_card_info{
      padding: 0 0 20px;
    }
    .prod_lists .prod_item .prod_item_title{
      font-size: 14px;
    }
    .prod_lists .prod_item .prod_item-variants{
      font-size: 10px;
    }
    .prod_lists .prod_item .prod_item_price .price{ }
    .prod_lists .prod_item .prod_item_price .discount-price{
      font-size: 12px;
    }
    
    .prod_lists .prod_item .prod_item_price .shop_now_btn{
      font-size: 8px;
      width: 60px;
      line-height: 22px;
    }
  
    .prod_lists .prod_item .prod_item_price .prod_item_sale_price{
      font-size: 14px;
    }
    .prod_lists .prod_item .prod_item_price .prod_item_discount_price{
      font-size: 14px;
      margin-right: 2px;
    }
    .prod_lists .prod_item .prod_item_price .prod_item_sale_price.prod_item_sale_price_new{
      font-size: 12px;
    }
    /* bundle */
    .module-title.bundle-title{
      font-size: 20px;
      margin: 40px auto 20px;
    }
    .bundle-prod-lists .bundle-prod-items{
      flex-direction: column;
      padding: 50px 15px 20px;
    }
    .bundle-prod-items-cont-left{
      width: 100%;
      align-items: normal;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-middle-icon{
      margin: auto;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-left,
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-center{
      width: calc((100% - 30px) / 2);
      padding: 10px 0;
      border-radius: 8px;
    }
    .bundle-item-title{
      margin-top: 0;
      font-size: 10px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-middle-icon svg{
      width: 30px;
      height: 30px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right{
      width: 90%;
      margin: 20px auto 0;
    }
    .bundle-prod-item-right-cont {
      display: flex;
      align-items: anchor-center;
      gap: 12px;
      flex-direction: row;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-sale-price{
      font-size: 20px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-discount-price{
      font-size: 12px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-shopnow-btn{
        margin-top: 10px;
        padding: 10px;
        font-size: 14px;
        width: 100%;
        text-align: center;
    }
    
  }
  /* IPad */
  @media(min-width: 768px) and (max-width: 991px) {
    .prod_lists{
      gap: 20px;
    }
    .prod_lists .prod_item{
      width: calc((100% - 40px) / 3);
    }
    .prod_lists .prod_item .prod_item_price .shop_now_btn{
      font-size: 14px;
    }
    .prod_lists .prod_item .prod_card_info{
      padding: 0 0 10px 0;
    }
    .block-chair-cont .top_pick{
      padding: 20px 10px;
    }
    .block-chair-cont .top_pick .right{
      margin-left: 0;
    }
    .prod_lists .prod_item .prod_item_price .prod_item_sale_price:before{
      font-size: 16px;
    }
  }
  /* small screen */
  @media(min-width: 992px) and (max-width: 1600px) {
    .prod_lists{
      gap: 20px;
    }
    .prod_lists .prod_item{
      width: calc((100% - 40px) / 3);
    }
    .prod_lists .prod_item .prod_card_info{
      padding: 0 15px 27px 15px;
    }
    .prod_lists .prod_item .prod_item_price .shop_now_btn{
      font-size: 16px;
    }
    .prod_lists .prod_item .prod_item_price .prod_item_discount_price{
      font-size: 18px;
      margin-right: 2px;
    }
    .prod_lists .prod_item .prod_item_price .prod_item_sale_price{
      font: 500 16px var(--font-family-1);
    }
    .block-chair-cont .top_pick{
      gap: 10px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-middle-icon{
      margin: auto;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-middle-icon svg{
      width: 30px;
      height: 30px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-sale-price{
      font-size: 30px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-discount-price{
      font-size: 20px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-right .bundle-item-shopnow-btn{
      padding: 10px 45px;
      font-size: 16px;
    }
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-left,
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-center{
      width: 340px;
      height: auto;
    }
  }
  @media(min-width: 768px) and (max-width: 1024px) {
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-left,
    .bundle-prod-lists .bundle-prod-items .bundle-prod-item-center{
      padding: 10px 0;
      flex: auto;
    }
    .bundle-item-title{
      font-size: 18px;
    }
  }
</style>

<section class="hltv-event">
  <div class="container-1570 hltv-event-container">
    <div class="event-cont">
      {% for block in section.blocks %}
        {% if block.type == 'chairsItem' %}
          <div class="header-title">
            {% if block.settings.chairs_title_image != blank %}
              <div class="chairs_title-image-block">
                <img src="{{ block.settings.chairs_title_image | img_url:'master' }}" />
              </div>
            {% else %}
              <span class="text">{{ block.settings.charis_title }}</span>
            {% endif %}
          </div>
          <div class="block-chair-cont" data-href="{{ block.settings.chairs_top_pick_LINK }}">
            <div class="top_pick">
              <div class="left image-zoom">
                <img src="{{ block.settings.chairs_top_pick | img_url:'master' }}">
              </div>
              <div class="right">
                <div class="top_pick_subtitle">
                  <span>{{ block.settings.chairs_top_pick_subtitle }}</span>
                </div>
                <div class="top_pick_title">
                  <span>{{ block.settings.chairs_top_pick_title }}</span>
                </div>
                <div class="top_pick_desc">
                  <span>{{ block.settings.chairs_top_pick_descripe }}</span>
                </div>
                <div class="top_pick_prices">
                  <span class="discount-price">{{ block.settings.chairs_top_pick_discount_price }}</span>
                  <span class="sale-price" {% if block.settings.chairs_top_pick_discount_price == blank %}style="text-decoration: none;"{% endif %}>{{ block.settings.chairs_top_pick_sale_price }}</span>
                </div>
                <div data-href="{{ block.settings.chairs_top_pick_LINK }}" class="top_pick_btn">
                  <span>{{ block.settings.chairs_top_pick_shopnow }}</span>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
      <div class="prod_lists chairs_prod_lists">
        {%- for product_card_product in collection.products -%}
          {%-liquid
            assign variant_img = ''
            for option in product_card_product.options_with_values
                for variant in product_card_product.variants limit: 1
                    if variant.image != null  
                        assign variant_img = variant.image
                    endif
                endfor
            endfor
          -%}
           <div class="prod_item" data-product-id="{{ product_card_product.id }}" style="{% if product_card_product.metafields.custom.product_type == 'chairs' %}display: block; {% else %} display: none; {% endif %}">
              <div class="container">
               <div class="card-product">
                 {% render 'product-badge', product: product_card_product, class: 'card__badge', badge_detail: true, serial: serial %}
                 <div class="card-media card-media--adapt {% if product_card_product.media[1] != nil and settings.show_image_swap %} media--hover-effect{% endif%} media--loading-effect" style="padding-bottom: {{ 1.1 | times: 100 }}%;">
                    {% render 'image-product-card', product_card_product: product_card_product, variant_img: variant_img, has_video: false, loading: true %}
                    <a class="card-link" href="{{ product_card_product.url }}" title="{{ product_card_product.title | escape }}"></a>
                 </div>
               </div>
               <div class="prod_card_info">
                 <div class="prod_item_title">
                   <span>{{ product_card_product.title }}</span>
                 </div>
                 <div class="prod_item-variants">
                    {{ product_card_product.selected_or_first_available_variant.option3 }}
                 </div>
                 <div class="flex-1"></div>
                 <div class="prod_item_price">
                   <div class="price">
                     {% comment %} {% if product_card_product.selected_or_first_available_variant.metafields.custom.discount_price.value %}
                       <span class="prod_item_discount_price">
                         {{
                            product_card_product.price
                            | minus: product_card_product.selected_or_first_available_variant.metafields.custom.discount_price.value
                            | money_without_currency
                          }}
                       </span>
                     {% endif %} {% endcomment %}
                     <span class="prod_item_sale_price">{{ product_card_product.selected_or_first_available_variant.price | money }}</span>
                   </div>
                   <a class="shop_now_btn" href="{{ product_card_product.url }}">{{ 'products.product.shop_now' | t }}</a>
                 </div>
                </div>
             </div>
           </div>
        {% endfor %}
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'desksItem' %}
          <div class="header-title desk-header-title">
            {% if block.settings.desks_title_image != blank %}
              <div class="chairs_title-image-block desks_title-image-block">
                <img src="{{ block.settings.desks_title_image | img_url:'master' }}" />
              </div>
            {% else %}
              <span>{{ block.settings.desks_title }}</span>
            {% endif %}
          </div>
          <div class="block-chair-cont" data-href="{{ block.settings.desks_top_pick_LINK }}">
            <div class="top_pick">
              <div class="left image-zoom">
                <img src="{{ block.settings.desks_top_pick | img_url:'master' }}">
              </div>
              <div class="right">
                <div class="top_pick_subtitle">
                  <span>{{ block.settings.desks_top_pick_subtitle }}</span>
                </div>
                <div class="top_pick_title">
                  <span>{{ block.settings.desks_top_pick_title }}</span>
                </div>
                <div class="top_pick_desc">
                  <span>{{ block.settings.desks_top_pick_descripe }}</span>
                </div>
                <div class="top_pick_prices">
                  <span class="discount-price">{{ block.settings.desks_top_pick_discount_price }}</span>
                  <span class="sale-price" {% if block.settings.desks_top_pick_discount_price == blank %}style="text-decoration: none;"{% endif %}>{{ block.settings.desks_top_pick_sale_price }}</span>
                </div>
                <div data-href="{{ block.settings.desks_top_pick_LINK }}" class="top_pick_btn">
                  <span>{{ block.settings.desks_top_pick_shopnow }}</span>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
      <div class="prod_lists">
        {%- for product_card_product in collection.products -%}
          {%-liquid
            assign variant_img = ''
            for option in product_card_product.options_with_values
                for variant in product_card_product.variants limit: 1
                    if variant.image != null  
                        assign variant_img = variant.image
                    endif
                endfor
            endfor
          -%}
          
           <div class="prod_item" data-product-id="{{ product_card_product.id }}" style="{% if product_card_product.metafields.custom.product_type == 'desk' %}display: block; {% else %} display: none; {% endif %}">
             <div class="container">
               <div class="card-product">
                 {% render 'product-badge', product: product_card_product, class: 'card__badge', badge_detail: true, serial: serial %}
                 <div class="card-media card-media--adapt {% if product_card_product.media[1] != nil and settings.show_image_swap %} media--hover-effect{% endif%} media--loading-effect" style="padding-bottom: {{ 1.1 | divided_by: 1 | times: 100 }}%;">
                    {% render 'image-product-card', product_card_product: product_card_product, variant_img: variant_img, has_video: false, loading: true %}
                    <a class="card-link" href="{{ product_card_product.url }}" title="{{ product_card_product.title | escape }}"></a>
                 </div>
               </div>
               <div class="prod_card_info">
                 <div class="prod_item_title">
                   <span>{{ product_card_product.title }}</span>
                 </div>
                 <div class="prod_item-variants">
                    {{ product_card_product.selected_or_first_available_variant.option3 }}
                 </div>
                 <div class="flex-1"></div>
                 <div class="prod_item_price">
                   <div class="price">
                     {% comment %} {% if product_card_product.selected_or_first_available_variant.metafields.custom.discount_price.value %}
                       <span class="prod_item_discount_price">
                         {{
                            product_card_product.price
                            | minus: product_card_product.selected_or_first_available_variant.metafields.custom.discount_price.value
                            | money_without_currency
                          }}
                       </span>
                     {% endif %} {% endcomment %}
                     <span class="prod_item_sale_price">{{ product_card_product.selected_or_first_available_variant.price | money }}</span>
                   </div>
                   <a class="shop_now_btn" href="{{ product_card_product.url }}">{{ 'products.product.shop_now' | t }}</a>
                 </div>
               </div>
             </div>
           </div>
        {% endfor %}
      </div>
      <!-- bundle -->
      <div class="module-title bundle-title" id="bundleItemConte">
        <div class="prod-list-title">{{ section.settings.bundleTitle }}</div>
        <div class="prod-list-desc">{{ section.settings.bundleDescripe }}</div>
      </div>
      <div class="bundle-prod-lists">
        {% for block in section.blocks %}
          {% if block.type == 'bundleItem' %}
            <div class="bundle-prod-items bundle-cont-link" data-href="{{ block.settings.bundleItemLink }}">
              <div class="bundle-prod-items-cont-left">
                <div class="bundle-prod-item-left">
                  <div class="image-bundle image-zoom">
                    <img src="{{ block.settings.bundleItemChair | img_url:'master' }}" width="100%" height="100%">
                  </div>
                  <div class="bundle-item-title">{{ block.settings.bundleItemTitle }}</div>
                </div>
                <div class="bundle-middle-icon">
                  <svg width="54" height="54" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="54" height="54" rx="27" fill="#FFC179"/>
                    <path d="M17 27H37" stroke="white" stroke-opacity="0.99" stroke-width="3"/>
                    <path d="M27 17L27 37" stroke="white" stroke-opacity="0.99" stroke-width="3"/>
                  </svg>
                </div>
    
                <div class="bundle-prod-item-center">
                  <div class="image-bundle image-zoom">
                    <img src="{{ block.settings.bundleItemDesk | img_url:'master' }}" width="100%" height="100%">
                  </div>
                  <div class="bundle-item-title">{{ block.settings.bundleItemDeskTitle }}</div>
                </div>
              </div>
              
              <div class="bundle-prod-item-right">
                <div class="bundle-prod-item-right-cont">
                  <div class="bundle-item-sale-price">{{ block.settings.bundleItemSalePrice }}</div>
                  <div class="bundle-item-discount-price">{{ block.settings.bundleItemDiscountPrice }}</div>
                </div>
                <div class="bundle-item-shopnow-btn bundle-cont-link" data-href="{{ block.settings.bundleItemLink }}">{{ 'products.product.shop_now' | t }}</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  $(document).ready(function() {
    setTimeout(() => {
      $('.prod_lists .prod_item').each(function() {
        let titleElement = $(this).find('.prod_item_title')
        const itemVariantVal = $(this).find('.prod_item-variants')
        let title = titleElement.text().trim()
        let partsVal = title.split('-')
          
        if (partsVal[1]) {
          const partsVal1 = partsVal[1].split('/')[0]?.trim()
          const partsVal2 = partsVal[1].split('/')[1]?.trim()
  
          let prependTex = ''
          if (partsVal1) {
            if(partsVal2) {
              prependTex = partsVal1 + ' / '
              itemVariantVal.append(' / ' + partsVal2);
            } else {
              prependTex = partsVal1 + '   '
            }
            itemVariantVal.prepend(prependTex)
            titleElement.text(partsVal[0].trim())
          } else {
            itemVariantVal.prepend(partsVal2)
            titleElement.text(partsVal[0].trim())
          }
        }
      })
    }, 0)
    
    
    // 异步处理product title
    setTimeout(function() {
      $('.prod_item_title').each(function() {
        // 获取原文本
        var txt = $(this).text().trim();
        // 去掉最后的 ' Gaming Chair'，区分大小写
        if (txt.endsWith(' Gaming Chair')) {
          txt = txt.replace(/ Gaming Chair$/, '');
          $(this).text(txt);
        }
      });
    }, 0)
    
  });
  $('.top_pick_btn').on('click', function(){
    let url = $(this).data('href')
    if(url) {
      window.location.href = url
    }
  })
  $('.block-chair-cont').on('click', function() {
    let url = $(this).data('href')
    if(url) {
      window.location.href = url
    }
  })

  setTimeout(() => {
    $('.prod_item_discount_price').each(function() {
      const originalText = $(this).text();
      const noSpaces = originalText.replace(/\s+/g, '');
      $(this).text(noSpaces);
    });

  }, 0)
  $('.bundle-cont-link').on('click', function() {
      let url = $(this).data('href')
      if(url) {
        window.location.href = url
      }
   })
</script>



