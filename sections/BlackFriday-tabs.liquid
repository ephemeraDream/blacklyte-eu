                {
                    "type": "text",
                    "id": "tabItemDesc",
                    "label": "Tab Item Descripe"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "BlackFriday Tabs Progress"
        }
    ]
}
{% endschema %}