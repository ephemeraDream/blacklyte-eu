  {% comment %} sticky container {% endcomment %}
  {% if section.settings.stickyProduct != blank %}
    <div class="sticky-dom-chair">
      <div class="prod-info">
        <div class="left-cont">
          <div class="prod-img">
            <img src="{{ section.settings.stickyProduct.selected_or_first_available_variant.featured_image | img_url: 'master' }}">
          </div>
          <div class="prod-title">{{ section.settings.stickyProduct.title }}</div>
        </div>
        <div class="right-info">
          <div class="price-cont">
            <div class="price-container-left">
              <div class="price-sale-cont">
                {% if section.settings.stickyProduct.selected_or_first_available_variant.metafields.custom.discount_price.value
                    != blank
                %}
                  <div class="discount-price-info">
                    <span>
                      {{
                        section.settings.stickyProduct.selected_or_first_available_variant.price
                        | minus: section.settings.stickyProduct.selected_or_first_available_variant.metafields.custom.discount_price.value
                        | money_without_trailing_zeros
                      }}
                    </span>
                  </div>
                {% endif %}
                <div class="origa-price">
                  {{
                    section.settings.stickyProduct.selected_or_first_available_variant.price
                    | money_without_trailing_zeros
                  }}
                </div>
                {% if section.settings.stickyProduct.selected_or_first_available_variant.metafields.custom.discount_price.value
                    != blank
                %}
                  <div class="save-tag">
                    Save
                    {{
                      section.settings.stickyProduct.selected_or_first_available_variant.metafields.custom.discount_price.value
                      | money_without_trailing_zeros
                    }}
                  </div>
                {% endif %}
              </div>
              <div class="payment-info">
                <div class="payment-text-info">
                  {{
                    section.settings.stickyProduct.selected_or_first_available_variant.price
                    | minus: section.settings.stickyProduct.selected_or_first_available_variant.metafields.custom.discount_price.value
                    | divided_by: 12.0
                    | round: 2
                    | money_without_trailing_zeros
                  }}
                  {{ section.settings.paymentInfo }}
                  {{
                    section.settings.stickyProduct.selected_or_first_available_variant.price
                    | minus: section.settings.stickyProduct.selected_or_first_available_variant.metafields.custom.discount_price.value
                    | divided_by: 6.0
                    | round: 2
                    | money_without_trailing_zeros
                  }}
                  with
                </div>
                <span class="payment-logo">
                  <img
                    src="{{ section.settings.paymentLogo | img_url: 'master' }}"
                    alt="{{ section.settings.paymentLogo.alt }}"
                  >
                </span>
              </div>
            </div>
            <a href="{{ section.settings.stickyProduct.url }}" class="prod-buy-it-now">
              {{- section.settings.paymentButton -}}
            </a>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</section>

<script>
  (function () {
    const chair = document.querySelector('.sticky-dom-chair');
    if (!chair) return;

    chair.style.opacity = '0';
    chair.style.zIndex = '0';
    chair.style.transition = 'opacity 0.35s ease';

    let windowHeight = window.innerHeight;
    let ticking = false;

    function updateWindowHeight() {
      windowHeight = window.innerHeight;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          if (scrollTop >= 1 * windowHeight) {
            chair.style.opacity = '1';
            chair.style.zIndex = '10';
          } else {
            chair.style.opacity = '0';
            chair.style.zIndex = '0';
          }
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      updateWindowHeight();
      onScroll();
    });

    updateWindowHeight();
    onScroll();
  })();
</script>

