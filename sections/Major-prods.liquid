<style>
  .section-{{ section.id }}{
      padding-top: 80px;
      padding-bottom: 100px;
      overflow: hidden;
  }
  .section-{{ section.id }} .container-full{
      padding-left: 16%;
      padding-right: 16%;
  }

  .section-{{ section.id }} .container-full .product-collection{
      display: flex;
      gap: 200px;
      justify-content: space-between;
  }

  .section-{{ section.id }} .container-full .product-collection .left-cont,
  .section-{{ section.id }} .container-full .product-collection .right-cont{
      display: flex;
      align-items: center;
      flex-direction: column;
      width: calc((100% - 200px) / 2);
  }
  .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image{ }
  .section-{{ section.id }} .container-full .product-collection .cont-title{
      font: 700 46px 'DIN';
      color: #fff;
      flex: 1;
      text-align: center;
      position: relative;
      z-index: 1;
  }
  .section-{{ section.id }} .container-full .product-collection .cont-title .cont-title-svg{
      position: absolute;
      top: 10px;
      left: 50%;
      z-index: -1;
      transform: translateX(-50%);
      width: max-content;
  }
  .section-{{ section.id }} .container-full .product-collection .cont-title .cont-title-svg svg{
      width: 60%;
      height: auto;
      fill: none;
      stroke: none;
  }
  .section-{{ section.id }} .container-full .product-collection .cont-desc{
      font: 400 36px 'DIN';
      color: #fff;
  }

  .section-{{ section.id }} .container-full .product-collection .cont-button{
      font: 500 26px 'DIN';
      color: #fff;
      padding: 12px 70px;
      width: fit-content;
      white-space: nowrap;
      margin-top: 24px;
      background: linear-gradient(89.88deg, rgba(255, 61, 1, 0) 0.1%, #ED1C24 49.24%, rgba(255, 61, 1, 0) 98.37%);
  }

  .section-{{ section.id }} .container-full .product-collection .cont-button:hover{
      background: linear-gradient(89.88deg, rgba(255, 61, 1, 0) 0.1%, rgba(237, 28, 36, 0.65) 49.24%, rgba(255, 61, 1, 0) 98.37%);
  }
  .section-{{ section.id }} .container-full .product-collection .Features-conts svg{
      width: 100%;
      height: auto;
  }

  {% comment %} sticky product {% endcomment %}
  .sticky-dom-chair{
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background-color: #f5f5f5;
      transform: translateZ(0);
      transition: all .3s ease-in-out;
      box-shadow: -.15625vw -.15625vw .15625vw #dfdfdf40;
      padding: 13px 7.34375vw;
      opacity: 0;
      z-index: -1;
      max-width: 100%;
      overflow: hidden;
  }
  .sticky-dom-chair .prod-info{
      display: flex;
      align-items: center;
      justify-content: space-between;
  }
  .sticky-dom-chair .prod-info .prod-img img{
      width: 60px;
      height: 60px;
      border-radius: 10px;
      background-color: #e5e5e5;
      object-fit: contain;
      object-position: center center;
  }
  .sticky-dom-chair .prod-info .left-cont{
      display: flex;
      align-items: center;
      gap: 5px;
  }
  .sticky-dom-chair .prod-info .prod-title{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(16px, .833vw, .833vw);
      leading-trim: NONE;
      line-height: 100%;
      letter-spacing: 0%;
      vertical-align: middle;
      color: #262629;
  }
  .sticky-dom-chair .prod-info .price-sale-cont{
      display: flex;
      align-items: center;
      justify-content: flex-end;
  }
  .sticky-dom-chair .prod-info .discount-price-info,
  .sticky-dom-chair .prod-info .origa-price{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(20px, 1.25vw, 1.25vw);
      leading-trim: NONE;
      line-height: 100%;
      letter-spacing: 0%;
      vertical-align: middle;
      color: #262629;
  }
  .sticky-dom-chair .prod-info .discount-price-info+.origa-price{
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(12px, .625vw, .625vw);
      leading-trim: NONE;
      line-height: clamp(14px, .729167vw, .729167vw);
      letter-spacing: 0%;
      vertical-align: middle;
      text-decoration: line-through;
      color: #26262980;
      margin-left: .3125vw;
  }
  .sticky-dom-chair .prod-info .save-tag{
      padding: 0 .3125vw;
      background: #af1c1c;
      border-radius: .15625vw;
      color: #fff;
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(12px, .625vw, .625vw);
      leading-trim: NONE;
      letter-spacing: 0%;
      display: flex;
      align-items: center;
      height: 1.145833vw;
      min-height: 22px;
      margin-left: .46875vw;
  }
  .sticky-dom-chair .price-cont{
      display: flex;
      align-items: center;
      gap: 10px;
  }
  .sticky-dom-chair .price-cont .price-container-left{
      display: flex;
      flex-direction: column;
      gap: 6px;
  }
  .sticky-dom-chair .price-cont .payment-info{
      display: flex;
      align-items: baseline;
  }
  .sticky-dom-chair .price-cont .payment-text-info{
      display: flex;
      align-items: baseline;
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(14px, .7291667vw, .7291667vw);
      leading-trim: NONE;
      line-height: clamp(18px, .9375vw, .9375vw);
      letter-spacing: 0%;
      vertical-align: middle;
      color: #262629b3;
      margin-top: .15625vw;
      white-space: nowrap;
  }
  .sticky-dom-chair .price-cont .payment-logo img{
      min-width: 42px;
      width: 2.1875vw;
      height: auto;
      margin-left: .15625vw;
  }
  .sticky-dom-chair .prod-buy-it-now{
      background: #262629;
      color: #fff;
      border: none;
      position: relative;
      width: 10.15625vw;
      flex: 0 0 auto;
      height: 2.65625vw;
      min-height: 38px;
      border-radius: 3.28125vw;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Poppins;
      font-weight: 500;
      font-style: Medium;
      font-size: clamp(14px, .7291667vw, .7291667vw);
      line-height: 100%;
      letter-spacing: 0%;
      transition: all .4s ease-out;
      text-transform: uppercase;
      white-space: nowrap;
  }
  .sticky-dom-chair .prod-buy-it-now:before{
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      background: linear-gradient(120deg, #fff3 49.9%, #fff0 50%) no-repeat 100% 100%;
      background-size: 300% 100%;
      border-radius: 90px;
      transition: background-position .4s ease-out;
  }

  {% comment %} iPhone {% endcomment %}
  @media(max-width: 767px){
      .section-{{ section.id }} {
          padding-top: 50px;
          padding-bottom: 20px;
      }
      .section-{{ section.id }} .container-full{
          padding-left: 10px;
          padding-right: 10px;
      }
      .section-{{ section.id }} .container-full .product-collection{
          gap: 50px;
          flex-direction: column;
      }
      .section-{{ section.id }} .container-full .product-collection .left-cont,
      .section-{{ section.id }} .container-full .product-collection .right-cont{
          width: 100%;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-title{
          font-size: 25px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-desc {
          font-size: 18px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-button{
          font-size: 14px;
          padding: 5px 30px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-prod-featured-image img{
          width: 80%;
          margin: auto;
      }
      .sticky-dom-chair{
          padding: 10px;
      }
      .sticky-dom-chair .prod-info .prod-title{
          font-size: 10px;
          width: 110px;
          line-height: 1.3;
      }
      .sticky-dom-chair .prod-info .discount-price-info{
          font-size: clamp(16px, 1.25vw, 1.25vw);
      }
      .sticky-dom-chair .prod-info .origa-price{
          font-size: clamp(10px, .625vw, .625vw);
      }
      .sticky-dom-chair .prod-info .save-tag{
          font-size: clamp(10px, .625vw, .625vw);
      }
      .sticky-dom-chair .price-cont{
          flex-direction: column;
          gap: 5px;
      }
      .sticky-dom-chair .price-cont .price-container-left{
          gap: 6px;
      }
      .sticky-dom-chair .price-cont .payment-info{
          display: none;
      }
      .sticky-dom-chair .price-cont .payment-text-info{
          font-size: clamp(10px, .7291667vw, .7291667vw);
          white-space: normal;
      }
      .sticky-dom-chair .price-cont .payment-logo img{
          min-width: 36px;
          width: 1.1vw;
      }
      .sticky-dom-chair .prod-buy-it-now{
          width: 100%;
          height: 2vw;
          font-size: 10px;
          border-radius: 100px;
      }
      .sticky-dom-chair .prod-info .price-sale-cont{
          gap: 4px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-title .cont-title-svg{
          top: calc(50% - 10px);
      }
      .section-{{ section.id }} .container-full .product-collection .Features-conts svg{
          width: 90%;
          margin-left: 5%;
      }

  }

  {% comment %} iPad {% endcomment %}
  @media(min-width: 768px) and (max-width: 1024px){
      .section-{{ section.id }} {
          padding-top: 50px;
          padding-bottom: 50px;
      }
      .section-{{ section.id }} .container-full{
          padding-left: 10px;
          padding-right: 10px;
      }
      .sticky-dom-chair{
          padding: 10px;
      }
      .section-{{ section.id }} .container-full .product-collection{
          gap: 50px;
      }
      .section-{{ section.id }} .container-full .product-collection .left-cont,
      .section-{{ section.id }} .container-full .product-collection .right-cont{
          width: calc((100% - 50px) / 2);
      }
      .section-{{ section.id }} .container-full .product-collection .cont-title{
          font-size: 30px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-desc{
          font-size: 20px;
      }
      .section-{{ section.id }} .container-full .product-collection .cont-button{
          font-size: 16px;
      }
  }

  {% comment %} small screen {% endcomment %}
  @media(min-width: 1025px) and (max-width: 1480px){
      .section-{{ section.id }} .container-full{
          padding-left: 60px;
          padding-right: 60px;
      }
      .sticky-dom-chair{
          padding-left: 60px;
          padding-right: 60px;
      }
      .section-{{ section.id }} .container-full .product-collection{
          gap: 100px;
      }
      .section-{{ section.id }} .container-full .product-collection .left-cont,
      .section-{{ section.id }} .container-full .product-collection .right-cont{
          width: calc((100% - 100px) / 2);
      }
  }
</style>

<section class="section-{{ section.id }}" id="{{ section.id }}" data-section-id="{{ section.id }}">
  {%- liquid
    assign bgImage = section.settings.webBgImage
    assign bgImageMb = section.settings.MobileBgImage
  -%}

  <style>
    .section-{{ section.id }} {
        background-color: #050505;
        background-image: url({{ bgImage | img_url: 'master' }});
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    @media (max-width: 767px) {
        .section-{{ section.id }} {
            background-image: url({{ bgImageMb | img_url: 'master' }});
        }
    }
  </style>
  <div class="container-full">
    <div class="product-collection">
      {% for block in section.blocks %}
        {% if block.type == 'prodItemLeft' %}
          {% assign variant = blank %}
          {% for variant in block.settings.product.variants %}
            {% if variant.title contains 'Budapest' %}
              {% assign variant = variant %}
            {% endif %}
          {% endfor %}
          <div class="left-cont">
            <div class="cont-title">
              <span class="cont-title-svg">
                <svg width="438" height="35" viewBox="0 0 438 35" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g opacity="0.7" filter="url(#filter0_f_6028_63728)">
                  <path d="M432 29H13.7341L6 6H432V29Z" fill="#ED1C24"/>
                  </g>
                  <defs>
                  <filter id="filter0_f_6028_63728" x="0" y="0" width="438" height="35" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
                  <feFlood flood-opacity="0" result="BackgroundImageFix"/>
                  <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
                  <feGaussianBlur stdDeviation="3" result="effect1_foregroundBlur_6028_63728"/>
                  </filter>
                  </defs>
                </svg>
              </span>
              {{ block.settings.prodTitle }}
            </div>
            <div class="cont-desc">{{ block.settings.prodDesc }}</div>
            <a class="cont-button" href="{{ variant.url }}">{{ block.settings.prodBtn }}</a>
            <a href="{{ variant.url }}" class="cont-prod-featured-image">
              <img src="{{ variant.featured_image | img_url: 'master' }}">
            </a>
            <div class="Features-conts">
