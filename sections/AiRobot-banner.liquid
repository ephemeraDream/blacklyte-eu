<style>
    .airobot-banner-section {
        position: relative;
    }

    .airobot-banner-section .item-container-image {
        width: 100%;
        aspect-ratio: 1920 / 910;
        object-fit: cover;
        object-position: center;
        display: block;
        vertical-align: middle;
    }

    .airobot-banner-section .item-texts-cont {
        position: absolute;
        top: 50%;
        left: 16%;
        transform: translateY(-50%);
    }

    .airobot-banner-section .item-texts-cont .item-sub-title {
        font-family: Poppins;
        font-weight: 500;
        font-size: 1.354vw;
        line-height: 1;
        letter-spacing: 0;
        vertical-align: middle;
        color: #FFFFFF;
        margin-bottom: 14px;
    }

    .airobot-banner-section .item-texts-cont .item-title {
        font-family: Poppins;
        font-weight: 500;
        font-size: 3.8718vw;
        line-height: 4vw;
        letter-spacing: 0;
        vertical-align: middle;
        color: #FFFFFF;
    }

    .airobot-banner-section .item-texts-cont .item-cont-desc {
        font-family: Poppins;
        font-weight: 500;
        font-size: 0.833vw;
        line-height: 1.25vw;
        letter-spacing: 0.016vw;
        vertical-align: middle;
        color: #FFFFFF;
        margin-top: 14px;
        opacity: 0.7;
        position: relative;
    }

    .airobot-banner-section .item-texts-cont .item-cont-desc:before{
        display: block;
        content: "";
        width: 1px;
        height: 30px;
        background: #fff;
        position: absolute;
        left: -20px;
        top: 50%;
        transform: translateY(-50%);
    }

    .airobot-banner-section .item-texts-cont .newsletter-form-container {
        display: flex;
        margin-top: 1.5625vw;
        gap: 0.625vw;
    }
    .airobot-banner-section .item-texts-cont .newsletter-form-container .field{
        width: 20vw;
    }
    .airobot-banner-section .item-texts-cont .newsletter-form-container .custom-field__input {
        padding: 1.045vw 0.9375vw;
        border: none;
        background: #FFFFFF;
        width: 100%;
        border-radius: 60px;
        font-size: 0.833vw;
    }

    .airobot-banner-section .item-texts-cont .newsletter-form-container .custom-newsletter-button {
        background-color: #4f46e5;
        color: #ffffff;
        border: none;
        border-radius: 60px;
        padding: 0.78125vw 2.083vw;
        font-size: 0.833vw;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

    .airobot-banner-section .item-texts-cont .item-email-input-desc {
        font-family: Poppins;
        font-weight: 500;
        font-size: 0.833vw;
        line-height: 1.0416vw;
        letter-spacing: 0;
        vertical-align: middle;
        color: #FFFFFF;
        opacity: 0.7;
        margin: 0.729vw auto 1.5625vw;
    }

    .airobot-banner-section .item-texts-cont .item-cont-coupons {
        display: flex;
        padding: 0.3125vw 0.729vw;
        background: #fff;
        border-radius: 0.52vw;
        font-family: Poppins;
        font-weight: 500;
        font-size: 1.354vw;
        line-height: 1.5625vw;
        color: #000000;
        width: max-content;
        align-items: center;
        cursor: pointer;
        gap: 0.3125vw;
    }

    .airobot-banner-section .item-texts-cont .item-cont-coupons svg {
        width: 1.875vw;
        height: 1.875vw;
    }

    .newsletter-success-modal.halo-popup .halo-popup-wrapper button.close{
        top: 50%;
        transform: translateY(-50%);
    }



    @media(max-width: 767px) {
        .airobot-banner-section .item-container-image {
            aspect-ratio: 375 / 667;
        }

        .airobot-banner-section .item-texts-cont {
            width: 100%;
            left: 0;
            top: 50%;
            padding: 0 8vw;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 88%;
        }

        .airobot-banner-section .item-texts-cont .item-sub-title {
            font-size: 0; 
            line-height: 1.2;
            margin-bottom: 10px;
        }

        .airobot-banner-section .item-texts-cont .item-title {
            font-size: 11.933vw;
            line-height: 1;
        }

        .airobot-banner-section .item-texts-cont .item-cont-desc{
            font-size: 3.803vw;
            line-height: normal;
        }

        .airobot-banner-section .item-texts-cont .item-cont-desc:before{
            display: none;
        }

        .airobot-banner-section .item-texts-cont .item-cont-desc p{
            display: inline;
        }

        .airobot-banner-section .item-texts-cont .newsletter-wrapper {
            width: 100%;
        }


        .airobot-banner-section .newsletter-form-container {
            flex-direction: row;
            gap: 10px;
            justify-content: center;
            width: 100%;
        }
        .airobot-banner-section .item-texts-cont .newsletter-form-container{
            display: flex;
            flex-direction: column;
            gap: 2.625vw;
        }

        .airobot-banner-section .item-texts-cont .newsletter-form-container .field{
            width: 100%;
        
        }

        .airobot-banner-section .item-texts-cont .newsletter-form-container .custom-field__input{
            width: 100%;
            padding: 0.533vw 2.5375vw;
            font-size: 3.833vw;
            border-radius: 10.208vw;
        }

        .airobot-banner-section .item-texts-cont .newsletter-form-container .custom-newsletter-button{
            border-radius: 10.5625vw;
            padding: 0.78125vw 6.083vw;
            font-size: 3.833vw;
            height: 12.8vw;
        }

        .airobot-banner-section .newsletter-form-container .field {
            flex: 1;
        }

        .airobot-banner-section .newsletter-form-container .custom-field__input {
            width: 100%;
            height: 12.8vw;
            padding: 0 20px;
            font-size: 3.733vw;
            border-radius: 24px;
        }

        .airobot-banner-section .newsletter-form-container .custom-newsletter-button {
            width: auto;
            height: 48px;
            padding: 0 25px;
            font-size: 14px;
            border-radius: 24px;
            margin-top: 0;
        }

        .airobot-banner-section .item-texts-cont .item-email-input-desc {
            font-size: 14px;
            line-height: 1.4;
            margin: 15px 0 0;
            opacity: 0.8;
        }

        .airobot-banner-section .item-texts-cont .item-email-input-desc p{
            display: inline;
        }

        .airobot-banner-section .newsletter-wrapper-container{
            margin-top: auto;
        }
       
        .airobot-banner-section .item-texts-cont .item-cont-coupons {
            font-size: 6.4vw;
            padding: 3.2vw 16vw;
            border-radius: 40px;
            margin-top: auto;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            gap: 2.3125vw;
        }

        .airobot-banner-section .item-texts-cont .item-cont-coupons svg {
            width: 28px;
            height: 28px;
        }
        
        .airobot-banner-section .item-container-image img {
            height: 100%;
            width: 100%;
            object-fit: cover;
        }
    }

    @media(min-width: 1025px) and (max-width: 1480px){
        .airobot-banner-section .item-texts-cont{
            left: 60px;
        }
    }


</style>

<div class="airobot-banner-section">
    <div class="container-full">
        {% for block in section.blocks %}
          {% if block.type == "item" %}
            <div class="item-containter">
                <div class="item-container-image">
                    {% render 'picture-simple',
                        image: block.settings.item_bg_image,
                        image_mobile: block.settings.item_bg_image_mb,
                        mobile_dpr: 2,
                        loading: "eager"
                    %}
                </div>
                <div class="item-texts-cont">
                    {% if block.settings.item_sub_title != blank %}
                        <div class="item-sub-title">{{ block.settings.item_sub_title }}</div>
                    {% endif %}
                    {% if block.settings.item_title != blank %}
                        <div class="item-title">{{ block.settings.item_title }}</div>
                    {% endif %}
                    {% if block.settings.item_description != blank %}
                        <div class="item-cont-desc">{{ block.settings.item_description }}</div>
                    {% endif %}
                    {% if block.settings.isShowSubscribeEmail %}
                        <div class="newsletter-wrapper-container">
                            <div class="newsletter-wrapper">
                                {%- form 'customer', id: 'ContactFooter', class: 'custom-newsletter-form' -%}
                                    <input type="hidden" name="contact[tags]" value="AiRobot">
                                    <div class="newsletter-form-container">
                                        <div class="field">
                                            <input
                                            id="NewsletterForm--{{ section.id }}"
                                            type="email"
                                            name="contact[email]"
                                            class="custom-field__input"
                                            value="{{ form.email }}"
                                            aria-required="true"
                                            autocorrect="off"
                                            autocapitalize="off"
                                            autocomplete="email"
                                            placeholder="Enter your email address"
                                            required
                                            >
                                        </div>
                                        <button type="submit" class="custom-newsletter-button" name="commit">
                                            {{ block.settings.item_email_submit }}
                                        </button>
                                    </div>
                                {%- endform -%}
                            </div>
                            {% if block.settings.item_email_input_descriptions != blank %}
                                <div class="item-email-input-desc">{{ block.settings.item_email_input_descriptions }}</div>
                            {% endif %}


                        </div>
                        
                    {% endif %}

                    {% if block.settings.item_coupons != blank %}
                        <div class="item-cont-coupons">
                            {{ block.settings.item_coupons }}
                            <span class="coupon-icon">
                                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M15.5195 18.8828H22.0649V20.9648H15.5195V18.8828ZM15.5195 23.5934H25.383V25.6754H15.5195V23.5934Z" fill="black"/>
                                    <path d="M24.1136 7.66535C24.0918 7.6425 24.069 7.62141 24.0458 7.60066L23.805 7.34824H23.4703C23.3965 7.34033 23.3222 7.34033 23.2484 7.34824H21.1415L21.2052 7.28742L18.1712 4.10156H7.7709C7.21023 4.10212 6.67269 4.32509 6.27623 4.72155C5.87978 5.118 5.65681 5.65554 5.65625 6.21621V26.0925C5.65681 26.6532 5.87978 27.1907 6.27623 27.5872C6.67269 27.9836 7.21023 28.2066 7.7709 28.2071H11.2904V29.3392C11.2909 29.8998 11.5139 30.4374 11.9104 30.8338C12.3068 31.2303 12.8444 31.4533 13.405 31.4538H28.9026C29.4633 31.4533 30.0008 31.2303 30.3973 30.8338C30.7937 30.4374 31.0167 29.8998 31.0173 29.3392V14.9093L26.2539 9.91711L24.1136 7.66535ZM27.4166 14.1584L24.1537 13.9987C24.1469 13.9967 24.141 13.9923 24.1371 13.9863C24.1332 13.9803 24.1316 13.9731 24.1326 13.9661L24.282 10.8646L24.7254 11.3293L27.4166 14.1584ZM7.7709 26.1241C7.76242 26.1236 7.75443 26.1199 7.74842 26.1139C7.74241 26.1079 7.73878 26.0999 7.7382 26.0914V6.21621C7.73878 6.20773 7.74241 6.19974 7.74842 6.19373C7.75443 6.18772 7.76242 6.18409 7.7709 6.18352H17.2789L18.3881 7.34824H13.405C12.8444 7.3488 12.3068 7.57177 11.9104 7.96822C11.5139 8.36468 11.2909 8.90222 11.2904 9.46289V26.1241H7.7709ZM28.903 29.3708H13.405C13.3966 29.3702 13.3886 29.3666 13.3826 29.3606C13.3765 29.3546 13.3729 29.3466 13.3723 29.3381V9.46289C13.3729 9.45441 13.3765 9.44642 13.3826 9.44041C13.3886 9.4344 13.3966 9.43077 13.405 9.43019H22.2669L22.0531 13.8694V13.8736C22.0018 15.038 22.9029 16.0269 24.057 16.0782L28.9353 16.3155V29.3392C28.9347 29.3477 28.9311 29.3556 28.9251 29.3617C28.9191 29.3677 28.9111 29.3713 28.9026 29.3719L28.903 29.3708Z" fill="black"/>
                                </svg>

                            </span>
                        </div>
                    {% endif %}
                </div>
            </div>
          {% endif %}
        {% endfor %}
    </div>
</div>

{% comment %} <script>
    document.addEventListener('DOMContentLoaded', function() {
        const couponContainer = document.querySelector('.item-cont-coupons');
        
        if (couponContainer) {
            const originalSvg = couponContainer.querySelector('.coupon-icon').innerHTML;
            
            const checkSvg = `<svg role="img" viewBox="0 0 512 512" class="icon icon-check" id="icon-check"><path d="M435.848 83.466L172.804 346.51l-96.652-96.652c-4.686-4.686-12.284-4.686-16.971 0l-28.284 28.284c-4.686 4.686-4.686 12.284 0 16.971l133.421 133.421c4.686 4.686 12.284 4.686 16.971 0l299.813-299.813c4.686-4.686 4.686-12.284 0-16.971l-28.284-28.284c-4.686-4.686-12.284-4.686-16.97 0z" fill="#428445"></path></svg>`;

            couponContainer.addEventListener('click', function() {
            
                const textToCopy = this.innerText.trim();
                const iconSpan = this.querySelector('.coupon-icon');

            
                navigator.clipboard.writeText(textToCopy).then(() => {
                
                    iconSpan.innerHTML = checkSvg;
                    
                    
                    setTimeout(() => {
                        iconSpan.innerHTML = originalSvg;
                    }, 2000);

                }).catch(err => {
                    console.error('Could not copy text: ', err);
                });
            });
        }
        });
</script> {% endcomment %}

{% schema %}
{
    "name": "AiRobot Banner",
    "tag": "section",
    "settings": [ ],
    "blocks": [
        {
            "type": "item",
            "name": "item",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "item_bg_image",
                    "label": "item Bg Image"
                },
                {
                    "type": "image_picker",
                    "id": "item_bg_image_mb",
                    "label": "item Bg Image Mobile"
                },
                {
                    "type": "text",
                    "id": "item_title",
                    "label": "item Title"
                },
                {
                    "type": "text",
                    "id": "item_sub_title",
                    "label": "item Sub Title"
                },
                {
                    "type": "richtext",
                    "id": "item_description",
                    "label": "item Description"
                },
                {
                    "type": "checkbox",
                    "id": "isShowSubscribeEmail",
                    "label": "show Subscribe Email"
                },
                {
                    "type": "text",
                    "id": "item_email_placeholder",
                    "label": "item Email Placeholder"
                },
                {
                   "type": "text",
                   "id": "item_email_submit",
                   "label": "item Email Submit",
                   "default": "Join the first drop"
                },
                {
                    "type": "richtext",
                    "id": "item_email_input_descriptions",
                    "label": "item Email Input Descriptions"
                },
                {
                    "type": "text",
                    "id": "item_coupons",
                    "label": "item Coupons"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "AiRobot Banner"
        }
    ]
}
{% endschema %}