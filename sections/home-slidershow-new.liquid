{% comment %}
  3.0 设计新版首页, banner.
  利用swiper实现
  支持视频, 图片
{% endcomment %}
{%- liquid
  assign preload_desktop_image = blank
  assign preload_mobile_image = blank
  assign preload_media_found = false

  for block in section.blocks
    if preload_media_found == false
      case block.type
        when 'largeImage'
          assign preload_desktop_image = block.settings.Image
          assign preload_mobile_image = block.settings.Image_mb
        when 'subscripe'
          assign preload_desktop_image = block.settings.subscripeImage
          assign preload_mobile_image = block.settings.subscripeImageMobile
        when 'productLargeImage'
          assign preload_desktop_image = block.settings.prodBackgroundImage
          assign preload_mobile_image = block.settings.prodBackgroundImageMobile
        when 'video'
          assign preload_desktop_image = block.settings['video-url_mb-img']
          assign preload_mobile_image = block.settings['video-url_mb-img']
      endcase

      if preload_desktop_image == blank
        assign preload_desktop_image = preload_mobile_image
      endif

      if preload_mobile_image == blank
        assign preload_mobile_image = preload_desktop_image
      endif

      if preload_desktop_image != blank or preload_mobile_image != blank
        assign preload_media_found = true
      endif
    endif
  endfor
-%}
{%- if preload_desktop_image != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ preload_desktop_image | image_url: width: 1500 }}"
    imagesrcset="{{ preload_desktop_image | image_url: width: 750 }} 750w, {{ preload_desktop_image | image_url: width: 1500 }} 1500w, {{ preload_desktop_image | image_url: width: 2000 }} 2000w"
    imagesizes="100vw"
    media="(min-width: 768px)"
    fetchpriority="high"
  >
{%- endif -%}
{%- if preload_mobile_image != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ preload_mobile_image | image_url: width: 750 }}"
    imagesrcset="{{ preload_mobile_image | image_url: width: 375 }} 375w, {{ preload_mobile_image | image_url: width: 750 }} 750w, {{ preload_mobile_image | image_url: width: 1100 }} 1100w"
    imagesizes="100vw"
    media="(max-width: 767px)"
    fetchpriority="high"
  >
{%- endif -%}
