<script>
  function isDesktopHeroVideo() {
    return window.innerWidth > 768;
  }

  function loadHeroHls(video) {
    if (!video || video.dataset.hlsLoaded === 'true' || !isDesktopHeroVideo()) {
      return;
    }

    var videoSrc = video.dataset.hlsSrc;
    if (!videoSrc) {
      return;
    }

    video.dataset.hlsLoaded = 'true';

    if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = videoSrc;
      video.load();
      return;
    }

    function attachHls() {
      if (window.Hls && window.Hls.isSupported()) {
        var hls = new window.Hls();
        hls.loadSource(videoSrc);
        hls.attachMedia(video);
      }
    }

    if (window.Hls) {
      attachHls();
      return;
    }

    var script = document.querySelector('script[data-hero-hls]');
    if (script) {
      script.addEventListener('load', attachHls, { once: true });
      return;
    }

    script = document.createElement('script');
    script.src = "{{ 'hls.js' | asset_url }}";
    script.defer = true;
    script.dataset.heroHls = 'true';
    script.onload = attachHls;
    document.head.appendChild(script);
  }

  function syncSlideVideos() {
    document.querySelectorAll('.slide-show-container .swiper-slide video').forEach(function (video) {
      var slide = video.closest('.swiper-slide');
      var isActive = slide && slide.classList.contains('swiper-slide-active');
      var isRenderable = video.getClientRects().length > 0;

      if (isActive && isRenderable) {
        loadHeroHls(video);
        var playPromise = video.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(function () {});
        }
      } else {
        video.pause();
      }
    });
  }
</script>
<script>
  const swiperSlide = new Swiper('.slide-show-container', {
    loop: true, // 无限循环
    slidesPerView: 1, // 一次显示几张（根据需要改）
    autoplay: {
      delay: 12000, // 每 3 秒切换一次
      disableOnInteraction: false, // 用户操作后是否停止自动播放
    },
    navigation: {
      nextEl: '.pagination_icons .right',
      prevEl: '.pagination_icons .left',
    },
  });

  // 监听真实索引变化（loop 模式下建议使用这个）
  swiperSlide.on('realIndexChange', function () {
    syncSlideVideos();

    const totalDots = $('.slick-dots .dot-item').length;

    $('.slick-dots .dot-item').each(function (index) {
      const $dot = $(this).find('.dot-item-active');

      if (index === swiperSlide.realIndex) {
        // 当前正在播放的 dot：重播动画
        $dot.css({
          animation: 'none',
          opacity: 1,
        });

        // 触发重绘
        void this.offsetWidth;

        // 重新播放动画
        $dot.css({
          animation: 'increaseProgress 12500ms ease-out forwards',
        });
      } else if (index < swiperSlide.realIndex) {
        // 已经播完的：显示100%进度条（不重播）
        $dot.css({
          animation: 'none',
          opacity: 1,
          transform: 'scaleX(1)',
        });
      } else {
        // 还未播放的：保持隐藏状态
        $dot.css({
          animation: 'none',
          opacity: 0,
          transform: 'scaleX(0)',
        });
      }
    });
  });

  swiperSlide.on('slideChangeTransitionEnd', syncSlideVideos);
  syncSlideVideos();

  function setDotAnimationPause(pause) {
    $('.slick-dots .dot-item .dot-item-active').each(function () {
      $(this).css('animation-play-state', pause ? 'paused' : 'running');
    });
  }

  // 获取输入框元素
  const newsletterInput = document.querySelector('.sub-cont-newsletter .field__input');

  if (newsletterInput) {
    // 聚焦时停止轮播
    newsletterInput.addEventListener('focus', () => {
      swiperSlide.autoplay.stop();
      setDotAnimationPause(true);
    });

    // 失焦时恢复轮播
    newsletterInput.addEventListener('blur', () => {
      swiperSlide.autoplay.start();
      setDotAnimationPause(false);
    });

    // 输入时做一些其他处理
    newsletterInput.addEventListener('input', (e) => {});
  }

  $('.slide-show-block-img').on('click', function () {
    const url = $(this).data('url');
    if (url) {
      window.location.href = url;
    }
  });

  $('.slide-show-block-video').on('click', function(){
    const url = $(this).data('url')
    if(url){
      window.location.href = url
    }
  })

  {% comment %} 新 block 样式 {% endcomment %}
  $('.slide-product-list-container').on('click', function(){
    const url = $(this).data('url')
    if(url) {
      window.location.href = url
    }
  })

  {% comment %} Black Friday hit Copy Code {% endcomment %}
  let copyTimer = null;
  $('.slide-show-block-img .slide-show-block-content.blackFriday-custom-className .black-friday-btn-container .black-friday-btn').on('click', function(){
    {% comment %} 每次点击前清除上一次的定时器 {% endcomment %}
    const $btn = $(this).find('.blackFriday-success-icons')
    const $btnCopyBtn = $(this).find('.blackFriday-icons')
    if (copyTimer) {
      $btn.css('display', 'none')
      $btnCopyBtn.css('display', 'block')
      clearTimeout(copyTimer);
      copyTimer = null;
    }
    const text = $(this).find('.blackFriday-text').text().trim()
    const codeText = text.split('CODE:')[1]

    {% comment %} 创建一个临时输入框，用于执行复制命令 {% endcomment %}
    const tempInput = $('<input>');
    $('body').append(tempInput);
    tempInput.val(codeText).select();

    {% comment %} 执行复制操作 {% endcomment %}
    document.execCommand('copy');

    {% comment %} 删除临时输入框 {% endcomment %}
    tempInput.remove();

    {% comment %} 可选：显示一个提示 {% endcomment %}
    {% comment %} alert('success:' + codeText); {% endcomment %}

    $btn.css('display', 'block')
    $btnCopyBtn.css('display', 'none')
    {% comment %} 5s后, success消失, 可以再次复制 {% endcomment %}
    copyTimer = setTimeout(()=>{
      $btn.css('display', 'none')
      $btnCopyBtn.css('display', 'block')
      copyTimer = null;
    }, 5000)
    
  })

  if (copyTimer) {
    clearTimeout(copyTimer);
  }

</script>

