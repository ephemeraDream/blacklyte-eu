<style>
    .section-{{ section.id }}{
        background: #EBEBEB;
    }
    .section-{{ section.id }} .container-full{
        padding: 120px 0 130px;
    }
    .section-{{ section.id }} .container-full .header-cont{
        padding-left: 16%;
        padding-right: 16%;
    }
    .section-{{ section.id }} .container-full .header-cont .section-title{
        font-family: Poppins;
        font-weight: 600;
        font-style: SemiBold;
        font-size: 36px;
        line-height: 46px;
        letter-spacing: 0%;
        text-align: center;
        color: #262629;
    }
    .section-{{ section.id }} .container-full .header-cont .section-link{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 24px;
        line-height: 34px;
        letter-spacing: 0%;
        vertical-align: middle;
        color: #262629;
        display: flex;
        gap: 6px;
        margin-top: 14px;
        justify-content: center;
        cursor: pointer;
    }
    .section-{{ section.id }} .container-full .header-cont .section-link .link-icon{
        transition: all .35s ease;
    }
    .section-{{ section.id }} .container-full .header-cont .section-link:hover .link-icon{
        transform: translateX(5px);
    }

    .section-{{ section.id }} .container-full .editions-list{
        margin-top: 28px;
        margin-left: 16%;
        display: flex;
        gap: 20px;
    }

    .section-{{ section.id }} .container-full .editions-list .edition-item{
        width: calc((100% - 20px) / 1.5);
        position: relative;
    }
    .section-{{ section.id }} .edition-item-cont-area{
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: max-content;
    }

    .section-{{ section.id }} .edition-item-cont-area .item-product-title{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 20px;
        line-height: 26px;
        letter-spacing: 0%;
        color: #fff;
        text-align: center;
    }


    .section-{{ section.id }} .editions-list .edition-item .edition-item-btns{
        display: flex;
        gap: 30px;
        color: #fff;
        margin-top: 8px;
        justify-content: center;
    }

    .section-{{ section.id }} .custom-pagination .pagination-icon{
        border-radius: 100%;
        transition: all .5s ease;
    }

    .section-{{ section.id }} .custom-pagination .pagination-icon svg{
        width: 56px;
        height: 56px;
    }
    .section-{{ section.id }} .custom-pagination .pagination-icon:hover{
        box-shadow: 0 0 10px #fff;
        
    }

    .section-{{ section.id }} .editions-list .edition-item .edition-item-btns svg{
        width: 30px;
        height: auto;
        transform: all .35s ease;
    }

    .section-{{ section.id }} .editions-list .edition-item .item-buttons{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 16px;
        line-height: 26px;
        letter-spacing: 0%;
        color: #fff;
    }

    .section-{{ section.id }} .editions-list .edition-item .item-buttons:hover svg{
        transform: translateX(5px);
    }

    .section-{{ section.id }} .cont-area{
        position: relative;
    }
    .section-{{ section.id }} .cont-area .left-pagina-icon{
        position: absolute;
        top: 50%;
        left: calc(16% + 20px);
        z-index: 10;
        transform: translateY(-50%);
        cursor: pointer;
    }
    .section-{{ section.id }} .cont-area .right-pagina-icon{
        position: absolute;
        right: calc(16% - 20px);
        top: 50%;
        z-index: 10;
        transform: translateY(-50%);
        cursor: pointer;
    }



    {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px) {
        .section-{{ section.id }} .container-full .header-cont{
            padding-left: 10px;
            padding-right: 10px;
        }
    }

    {% comment %} iPhone {% endcomment %}
    @media(max-width: 767px){
        .section-{{ section.id }} .container-full{
            padding: 30px 0 50px;
        }
        .section-{{ section.id }} .container-full .header-cont{
            padding-left: 10px;
            padding-right: 10px;
        }
        .section-{{ section.id }} .container-full .header-cont .section-title{
            font-size: 26px;
            line-height: 36px;
        }
        .section-{{ section.id }} .container-full .header-cont .section-link{
            font-size: 16px;
            line-height: 34px;
            margin-top: 6px;
        }
        .section-{{ section.id }} .cont-area .left-pagina-icon{
            left: 20px;
        }
        .section-{{ section.id }} .cont-area .right-pagina-icon{
            right: 20px;
        }
        .section-{{ section.id }} .custom-pagination .pagination-icon svg{
            width: 32px;
            height: 32px;
        }
        .section-{{ section.id }} .edition-item-cont-area{
            width: 90%;
        }
        .section-{{ section.id }} .edition-item-cont-area .item-product-title{
            font-size: 16px;
            line-height: 18px;
        }
        .section-{{ section.id }} .editions-list .edition-item .item-buttons{
            font-size: 12px;
            line-height: 16px;
        }
        .section-{{ section.id }} .editions-list .edition-item .edition-item-btns svg{
            width: 16px;
        }
        .section-{{ section.id }} .container-full .editions-list{
            margin-top: 10px;
        }
    }

    {% comment %} small screen {% endcomment %}
    @media(min-width: 1025px) and (max-width: 1480px){
        .section-{{ section.id }} .container-full .header-cont{
            padding-left: 60px;
            padding-right: 60px;
        }
        .section-{{ section.id }} .cont-area .left-pagina-icon{
            left: 80px;
        }
        .section-{{ section.id }} .custom-pagination .pagination-icon svg{
            width: 40px;
            height: 40px;
        }

        
    
    }
</style>

<section class="section-{{ section.id }} edition-chairs-section" id="{{ section.id }}" data-section-id="{{ section.id }}">
    <div class="container-full">
        <div class="header-cont">
            {% if section.settings.sectionTitle != blank %}
                <h2 class="section-title">{{ section.settings.sectionTitle }}</h2>
            {% endif %}
            {% if section.settings.sectionDesc != blank %}
                <a class="section-link" {% if section.settings.sectionLinkURL != blank %} href="{{ section.settings.sectionLinkURL }}" {% else %} aria-disabled="true" {% endif %} >
                    {{ section.settings.sectionDesc }}
                    <span class="link-icon">
                        <svg width="8" height="13" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0.707031 0.710938L6.36389 6.36779L0.707031 12.0246" stroke="black" stroke-width="2"/>
                        </svg>

                    </span>
                </a>
            {% endif %}
        </div>

        {% if section.blocks.size > 0 %}
            <div class="cont-area">
                <div class="editions-list swiper">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                            {% if block.type == "item" %}
                                <div class="edition-item swiper-slide">
                                    {% if block.settings.itemLargeImage != blank or block.settings.itemLargeImage_mb != blank %}
                                        <div class="edition-item-image">
                                            <picture>
                                                <source media="(max-width: 768px)"
                                                        srcset="{{ block.settings.itemLargeImage_mb | image_url: width: 800 }}"
                                                        data-srcset="{{ block.settings.itemLargeImage_mb | image_url: width: 800 }}">

                                                <img {% render 'lazyload',preview_img: block.settings.itemLargeImage, class: true, enable_rtl: settings.enable_layout_rtl  %}
                                                    width="{{ block.settings.itemLargeImage.width }}"
                                                    height="{{ block.settings.itemLargeImage.height }}"
                                                    alt="{{ block.settings.itemLargeImage.alt | escape }}"
                                                    loading="lazy"
                                                    decoding="async"
                                                    style="height: auto;"/>

                                            </picture>
                                        </div>
                                    {% endif %}
                                    {% if block.settings.itemProduct != blank or block.settings.itemLearnmoreText != blank or block.settings.itemBuynowText != blank %}
                                        <div class="edition-item-cont-area">
                                            {% if block.settings.itemProduct != blank %}
                                                <div class="item-product-title">{{ block.settings.itemProduct.title }}</div>
                                            {% endif %}
                                            {% if block.settings.itemLearnmoreText != blank or block.settings.itemBuynowText != blank %}
                                                <div class="edition-item-btns">
                                                    {% if block.settings.itemLearnmoreText != blank %}
                                                        <a class="learn-more-button item-buttons" {% if block.settings.itemLearnmoreLink != blank %} href="{{ block.settings.itemLearnmoreLink }}" {% else %} aria-disabled="true" {% endif %} >
                                                            {{ block.settings.itemLearnmoreText }}
                                                            <span class="learn-more-icon">
                                                                <svg width="32" height="15" viewBox="0 0 32 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                    <path d="M31.7071 8.07429C32.0976 7.68377 32.0976 7.0506 31.7071 6.66008L25.3431 0.29612C24.9526 -0.0944047 24.3195 -0.0944047 23.9289 0.29612C23.5384 0.686644 23.5384 1.31981 23.9289 1.71033L29.5858 7.36719L23.9289 13.024C23.5384 13.4146 23.5384 14.0477 23.9289 14.4383C24.3195 14.8288 24.9526 14.8288 25.3431 14.4383L31.7071 8.07429ZM0 7.36719V8.36719H31V7.36719V6.36719H0V7.36719Z" fill="white"/>
                                                                </svg>

                                                            </span>
                                                        </a>
                                                    {% endif %}
                                                    {% if block.settings.itemBuynowText != blank %}
                                                        <a class="buy-now-button item-buttons" {% if block.settings.itemBuynowLink != blank %} href="{{ block.settings.itemBuynowLink }}" {% else %} aria-disabled="true" {% endif %} >
                                                            {{ block.settings.itemBuynowText }}
                                                            <span class="buy-now-icon">
                                                                <svg width="32" height="15" viewBox="0 0 32 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                    <path d="M31.7071 8.07429C32.0976 7.68377 32.0976 7.0506 31.7071 6.66008L25.3431 0.29612C24.9526 -0.0944047 24.3195 -0.0944047 23.9289 0.29612C23.5384 0.686644 23.5384 1.31981 23.9289 1.71033L29.5858 7.36719L23.9289 13.024C23.5384 13.4146 23.5384 14.0477 23.9289 14.4383C24.3195 14.8288 24.9526 14.8288 25.3431 14.4383L31.7071 8.07429ZM0 7.36719V8.36719H31V7.36719V6.36719H0V7.36719Z" fill="white"/>
                                                                </svg>

                                                            </span>
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            {% endif %}

                                        </div>
                                    {% endif %}
                                    
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    
                </div>
                <div class="custom-pagination">
                    <div class="left-pagina-icon pagination-icon">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="28" cy="28" r="27.5" fill="white" stroke="#E8E8E8"/>
                            <path d="M29.6562 22L23.9994 27.6569L29.6562 33.3137" stroke="black" stroke-width="2"/>
                        </svg>

                    </div>
                    <div class="right-pagina-icon pagination-icon">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="28" cy="28" r="27.5" transform="matrix(-1 0 0 1 56 0)" fill="white" stroke="#E8E8E8"/>
                            <path d="M26.3438 22L32.0006 27.6569L26.3438 33.3137" stroke="black" stroke-width="2"/>
                        </svg>

                    </div>
                </div>
            </div>
            
        {% endif %}
    </div>
</section>

<script>
    $(document).ready(function(){
        let eventEditionsSwiper = null

        $('.edition-chairs-section .editions-list').css('margin-left', 0)

        function getOffset() {
            const w = window.innerWidth;
            if (w >= 1025 && w <= 1480) return 60;
            return Math.round(w * 0.16);

        }

        function toggleBtnState(swiper) {
            const instance = swiper || this; 
            if (!instance || !instance.el) return;

            const $preBtn = $('.edition-chairs-section .left-pagina-icon');
            const $nextBtn = $('.edition-chairs-section .right-pagina-icon');

            $preBtn.css({
                opacity: instance.isBeginning ? 0.5 : 1,
                pointerEvents: instance.isBeginning ? 'none' : 'auto'
            });
            $nextBtn.css({
                opacity: instance.isEnd ? 0.5 : 1,
                pointerEvents: instance.isEnd ? 'none' : 'auto'
            });
        }

        eventEditionsSwiper = new Swiper('.edition-chairs-section .editions-list', {
            loop: false,
            grabCursor: true,
            simulateTouch: true,
            slidesPerView: 1.5,
            slidesPerGroup: 1,
            spaceBetween: 20,
            slidesOffsetBefore: getOffset(),
            slidesOffsetAfter: 60,
            breakpoints: {
                320: {
                    slidesPerView: 1,
                    slidesPerGroup: 1,
                    spaceBetween: 10,
                    slidesOffsetBefore: 10,
                    slidesOffsetAfter: 10,
                    centeredSlides: false
                },
                992: {
                    slidesPerView: 1.5,
                    slidesOffsetBefore: getOffset()
                }
            },
            on: {
                init: function(){
                    toggleBtnState(this)
                },
                slideChange: function(){
                    toggleBtnState(this)
                } 
            }
        });

        $('.edition-chairs-section .left-pagina-icon').on('click', function() {
            if (eventEditionsSwiper) eventEditionsSwiper.slidePrev();
        });
        $('.edition-chairs-section .right-pagina-icon').on('click', function() {
            if (eventEditionsSwiper) eventEditionsSwiper.slideNext();
        });


    })
</script>

{% schema %}
{
    "name": "Events Editions",
    "settings": [
        {
            "type": "text",
            "id": "sectionTitle",
            "label": "section Title",
            "default": "Experience the Gear Trusted by Esports Pros"
        },
        {
            "type": "text",
            "id": "sectionDesc",
            "label": "section Descripe",
            "default": "View More"
        },
        {
            "type": "url",
            "id": "sectionLinkURL",
            "label": "section Link URL"
        }
    ],
    "blocks": [
        {
            "type": "item",
            "name": "item",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "itemLargeImage",
                    "label": "item Large Image"
                },
                {
                    "type": "image_picker",
                    "id": "itemLargeImage_mb",
                    "label": "item Large Image Mobile"
                },
                {
                    "type": "text",
                    "id": "itemLearnmoreText",
                    "label": "item Learn more Text",
                    "default": "Learn more"
                },
                {
                    "type": "url",
                    "id": "itemLearnmoreLink",
                    "label": "item Learn more Link URL"
                },
                {
                    "type": "text",
                    "id": "itemBuynowText",
                    "label": "item Buy Now Text",
                    "default": "Buy now"
                },
                {
                    "type": "url",
                    "id": "itemBuynowLink",
                    "label": "item Buy now Link URL"
                },
                {
                    "type": "product",
                    "id": "itemProduct",
                    "label": "item product"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Events Editions"
        }
    ]
}
{% endschema %}