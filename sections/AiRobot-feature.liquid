<style>
    .robot-features-section {
        background-color: #000;
        overflow: hidden;
    }

    .robot-features-container{
        position: relative;
    }

    .robot-features-section .robot-image-wrapper{
        width: 100%;
        aspect-ratio: 1920 / 890;
        object-fit: cover;
        object-position: center;
        display: block;
        vertical-align: middle;
    }

    .robot-features-section .robot-main-img {
        width: 100%;
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 0 20px rgba(0, 162, 255, 0.2));
    }

    .robot-features-section .robot-content-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.16vw;
        position: absolute;
        top: 50%;
        left: 58.5%;
        width: auto;
        z-index: 2;
        transform: translateY(-50%);
    }


    .robot-features-section .feature-item {
        width: 28.69vw;
        display: flex;
        flex-direction: column;
        gap: 0.8192vh;
    }

    .robot-features-section .feature-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 500;
        font-size: 1.5625vw;
        line-height: 3.125vw;
        letter-spacing: 0;
        vertical-align: middle;
        color: #fff;
    }

    .robot-features-section .feature-desc {
        font-family: Roboto;
        font-weight: 500;
        font-size: 0.8333vw;
        line-height: 1.25vw;
        letter-spacing: 0.0167vw;
        vertical-align: middle;
        color: #FFFFFF;
        opacity: 0.7;
    }

    .robot-features-section .feature-decoration-line {
        transform: translateX(-6.82839vw);
    }

    .robot-features-section .feature-decoration-line svg {
        width: 100%;
        height: auto;
    }

    @media screen and (max-width: 767px) {
        .robot-features-section { }

        .robot-features-section .robot-image-wrapper{
            aspect-ratio: 375 / 1100;
        }

        .robot-features-section .robot-content-wrapper {
            width: 100%;
            padding: 0 3.4829vw;
            gap: 10.16vw;
            top: auto;
            bottom: 5%;
            transform: none;
            left: 0;
        }

        .robot-features-section .feature-item{
            width: 100%;
        }

        .robot-features-section .feature-title {
            font-size: 6.4vw;
            margin-bottom: 2.6vw;
            text-align: left;
            line-height: normal;
        }

        .robot-features-section .feature-desc {
            font-size: 3.73vw;
            max-width: 100%;
            text-align: left;
            line-height: normal;
        }

        .robot-features-section .feature-desc p{ display: inline; }

        .robot-features-section .feature-decoration-line {
            transform: none;
        }
    }
</style>

<div class="robot-features-section" id="RobotFeatures--{{ section.id }}">
  <div class="robot-features-container">
    <div class="robot-image-wrapper">
      {%- if section.settings.image != blank -%}
        {% render 'picture-simple',
            image: section.settings.image,
            image_mobile: section.settings.image_mb,
            mobile_dpr: 2,
            loading: "eager"
        %}
      {%- endif -%}
    </div>

    <div class="robot-content-wrapper">
      {%- for block in section.blocks -%}
        <div class="feature-item" {{ block.shopify_attributes }}>
          <div class="feature-text">
            <h3 class="feature-title">{{ block.settings.title }}</h3>
            <div class="feature-desc">{{ block.settings.description }}</div>
          </div>
          <div class="feature-decoration-line">
            <svg width="551" height="111" viewBox="0 0 551 111" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                <rect width="551" height="111" fill="url(#pattern0_19022_32934)"/>
                <defs>
                <pattern id="pattern0_19022_32934" patternContentUnits="objectBoundingBox" width="1" height="1">
                <use xlink:href="#image0_19022_32934" transform="scale(0.00181488 0.00900901)"/>
                </pattern>
                <image id="image0_19022_32934" width="551" height="111" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
                </defs>
            </svg>

          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AiRobot Features",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Robot Image"
    },
    {
        "type": "image_picker",
        "id": "image_mb",
        "label": "Main Robot Image Mobile"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "AiRobot Features" }]
}
{% endschema %}