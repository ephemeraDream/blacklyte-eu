<style>
    .home-collapsiable{
        padding-top: 100px;
        padding-bottom: 0;
        background-color: #EBEBEB;
    }
    .home-collapsiable .container-full{
        padding-left: 16%;
        padding-right: 16%;
    }
    .home-collapsiable .collapsiable-title{
        font: 600 40px var(--font-family-3);
        line-height: 1.4;
        color: #262629;
        text-align: center;
        width: 70%;
        margin: auto;
    }
    .home-collapsiable .collapsiable-desc{
        font: 500 16px var(--font-family-3);
        line-height: 1.4;
        color: #262629;
        text-align: center;
        opacity: 0.7;
        margin-top: 10px;
    }
    .home-collapsiable .cont-items-img .image_pc{
        display: block;
    }
    .home-collapsiable .cont-items-img .image_mb{
        display: none;
    }
    .home-collapsiable .collapse-cont{
        display: flex;
        gap: 30px;
        margin-top: 58px;
        align-items: center;
    }
    .home-collapsiable .collapse-cont .collapse-cont-left{
        flex: 1.9;
    }
    .home-collapsiable .collapse-cont .collapse-cont-right{
        flex: 2;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }
    .home-collapsiable .collapse-cont .collapse-cont-right .collapse-right-items{
        {% comment %} border-bottom: 1px solid #CECECE; {% endcomment %}
        transition: all .3s ease;
        background: #F4F4F4;
        border-radius: 10px;
        padding-left: 30px;
        padding-right: 20px;
    }
    .home-collapsiable .collapse-cont .collapse-cont-right .collapse-right-items .collapse-content{
        max-height: 0;
        padding-bottom: 0;
        overflow: hidden;
        transition: max-height 0.5s ease-in-out, padding 0.5s ease-in-out;
    }
    .home-collapsiable .collapse-cont .collapse-cont-right .collapse-right-items.active .collapse-content{
        max-height: fit-content;
        padding-bottom: 30px;
    }
    .home-collapsiable .collapse-cont .collapse-cont-right .collapse-right-items.active .itemsContTitle-icon svg{
        transform: rotate(-180deg);
    }
    .home-collapsiable .collapse-cont .itemsContTitle{
        display: flex;
        justify-content: space-between;
        align-items: center;
        font: 600 20px var(--font-family-3);
        color: #262629;
        padding: 20px 10px 20px 0;
        cursor: pointer;
    }
    .home-collapsiable .collapse-cont .itemsContTitle .itemsContTitle-icon svg{
        width: 14px;
        height: 14px;
        fill: none;
        stroke: none;
        transition: all .35s ease-in-out;
    }
    .home-collapsiable .collapse-cont .itemsContDescripe{
        font: 500 16px var(--font-family-3);
        line-height: 1.4;
        color: #76767F;
        padding-top: 10px;
    }
    .home-collapsiable .collapse-cont .itemsContBtns{
        font: 500 16px var(--font-family-3);
        color: #262629;
        display: flex;
        gap: 8px;
        margin-top: 18px;
        cursor: pointer;
        width: max-content;
    }
    .home-collapsiable .collapse-cont .itemsContBtns svg{
        width: 20px;
    }
    .home-collapsiable .collapse-cont .itemsContBtns:hover svg{
        transform: translateX(5px);
    }

    /* IPhone */
    @media(max-width: 767px){
        .home-collapsiable .collapse-cont .collapse-cont-right{
            gap: 10px;
        }
        .home-collapsiable .collapse-cont .collapse-cont-right .collapse-right-items{
            padding-left: 15px;
            padding-right: 15px;
        }
        .home-collapsiable{
            padding-top: 50px;
            padding-bottom: 0;
        }
        .home-collapsiable .container-full{
            padding-left: 10px;
            padding-right: 10px;
        }
        .home-collapsiable .cont-items-img .image_pc{
            display: none;
        }
        .home-collapsiable .cont-items-img .image_mb{
            display: block;
        }
        .home-collapsiable .collapsiable-title{
            width: 100%;
            font-size: 24px;
        }
        .home-collapsiable .collapse-cont{
            flex-direction: column;
            gap: 20px;
            margin-top: 30px;
        }
        .home-collapsiable .collapse-cont .itemsContTitle{
            font-size: 16px;
            padding: 18px 10px 18px 0;
        }
        .home-collapsiable .collapse-cont .itemsContDescripe{
            font-size: 12px;
        }
        .home-collapsiable .collapse-cont .itemsContBtns{
            font-size: 10px;
        }
        
    }
    /* IPad */
    @media(min-width: 768px) and (max-width: 1024px){
        .home-collapsiable .container-full{
            padding-left: 10px;
            padding-right: 10px;
        }
        .home-collapsiable .collapse-cont{
            gap: 20px;
        }
    }
    /* small screen */
    @media(min-width: 1025px) and (max-width: 1600px){ }
    /* large screen */
    @media(min-width: 2000px){ }

    @media(min-width: 1025px) and (max-width: 1480px){
        .home-collapsiable .container-full{
            padding-left: 60px;
            padding-right: 60px;
        }
        .home-collapsiable .collapse-cont .collapse-cont-right{
            gap: 12px;
        }
    }
</style>

<section class="home-collapsiable">
    <div class="container-full">
        {% if section.settings.sectionTitle != blank %}
            <h2 class="collapsiable-title">{{ section.settings.sectionTitle }}</h2>
        {% endif %}
        {% if section.settings.sectionDesc != blank %}
            <div class="collapsiable-desc">{{ section.settings.sectionDesc }}</div>
        {% endif %}
        <div class="collapse-cont">
            <div class="collapse-cont-left">
                {% for block in section.blocks %}
                    {% if block.type == 'itemsImage' %}
                        <div class="cont-items-img">
                            <img src="{{ block.settings.contItemImage | img_url: 'master' }}" alt="{{ block.settings.contItemImage.alt | escape }}" class="image_pc" />
                            <img src="{{ block.settings.contItemImageMb | img_url: 'master' }}" alt="{{ block.settings.contItemImageMb.alt | escape }}" class="image_mb" />
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="collapse-cont-right">
                {% for block in section.blocks %}
                    {% if block.type == "itemsCont" %}
                        <div class="collapse-right-items">
                            {% if block.settings.itemsContTitle != blank or block.settings.itemsContTitleIcons != blank %}
                                <div class="itemsContTitle">
                                    <h3>{{ block.settings.itemsContTitle }}</h3>
                                    <span class="itemsContTitle-icon">
                                        <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M18.8494 0.92456L9.9248 9.84912L1.00024 0.92456" stroke="#262629" stroke-width="2"/>
                                        </svg>
                                    </span>
                                </div>
                            {% endif %}
                            <div class="collapse-content">
                                {% if block.settings.itemsContDesc != blank %}
                                    <div class="itemsContDescripe">{{ block.settings.itemsContDesc }}</div>
                                {% endif %}
                                {% if block.settings.itemsContLinkText != blank %}
                                    <a class="itemsContBtns" data-url="{{ block.settings.itemsContLinkURl }}" {% if block.settings.itemsContLinkURl != blank %}href="{{ block.settings.itemsContLinkURl }}" {% else %} aria-disabled="true" {% endif %}>
                                        {{ block.settings.itemsContLinkText }}
                                        <span>
                                            <svg width="31" height="16" viewBox="0 0 31 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M30.7071 8.70711C31.0976 8.31658 31.0976 7.68342 30.7071 7.29289L24.3431 0.928932C23.9526 0.538408 23.3195 0.538408 22.9289 0.928932C22.5384 1.31946 22.5384 1.95262 22.9289 2.34315L28.5858 8L22.9289 13.6569C22.5384 14.0474 22.5384 14.6805 22.9289 15.0711C23.3195 15.4616 23.9526 15.4616 24.3431 15.0711L30.7071 8.70711ZM0 8V9H30V8V7H0V8Z" fill="#262629"/>
                                            </svg>

                                        </span>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% elsif block.type == "modalItems" %}
                        {% render 'home-ergonomic-modal', block: block %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<script>
    $('.collapse-right-items').first().addClass('active')
    $('.collapse-right-items .itemsContTitle').on('click', function(){
        const $item = $(this).closest('.collapse-right-items');
        if ($item.hasClass('active')) {
            $item.removeClass('active');
        } else {
            $('.collapse-right-items').removeClass('active');
            $item.addClass('active');
        }
    })

    $('.home-collapsiable .collapse-cont .itemsContBtns').on('click', function() {
        const link = $(this).data('url')
        if(!link) {
            $('body').addClass('home-ergonomic-modal-show')
        }
    })
    $('.prod-erginomic-modal .prod-modal-title .close-icon').on('click', function() {
        $('body').removeClass('home-ergonomic-modal-show')
    })
</script>

{% schema %}
