{{ 'promotion.css' | asset_url | stylesheet_tag }}
{{ 'bundle-card.css' | asset_url | stylesheet_tag }}

<section class="section-{{ section.id }} xmas-event-section" id="{{ section.id }}" data-section-id="{{ section.id }}">
    <div class="container-full container-full-prods container-box">
        {% content_for 'block', type: 'xmas-collections', id: 'xmas-collections-promotion' %}
        {% content_for 'block', type: 'xmas-collections', id: 'xmas-collections-promotions' %}
        {% content_for 'block', type: 'pick-prods', id: 'pick-products' %}
        {% content_for 'block', type: "all-prods", id: 'all-prods' %}
        {% if section.settings.bundleTitle != blank or section.settings.bundleSubTitle != blank %}
            <div class="bundle-head" id="bundle-head">
            {% if section.settings.bundleTitle != blank %}
                <div class="bundle-title">{{ section.settings.bundleTitle }}</div>
            {% endif %}
            {% if section.settings.bundleSubTitle != blank %}
                <div class="bundle-sub-title">{{ section.settings.bundleSubTitle }}</div>
            {% endif %}
            {% if section.settings.bundleDesc != blank %}
                <div class="bundle-desc">{{ section.settings.bundleDesc }}</div>
            {% endif %}
            </div>
        {% endif %}
    </div>
    <div class="bundle-container">
        {% content_for 'blocks' %}
    </div>
    <div class="container-full container-full-prods container-box">
      {% content_for 'block', type: 'xmas-videos', id: 'xmas-video' %}
      {% content_for 'block', type: 'xmas-reviews', id: 'xmas-reviews' %}
    </div>
</section>

<script src="{{ 'xmas-2025.js' | asset_url  }}" defer></script>
<script src="{{ 'bundle-card.js' | asset_url  }}" defer></script>

<script src="{{ 'blastBounty.js' | asset_url }}" defer></script>
    

{% schema %}
{
  "name": "Blast Bounty Event",
  "settings": [
    {
      "type": "text",
      "id": "bundleTitle",
      "label": "bundle Title",
      "default": "Bundle Saving"
    },
    {
      "type": "text",
      "id": "bundleSubTitle",
      "label": "bundle Sub Title",
      "default": "Chair + Desk = Epic Deal!"
    },
    {
      "type": "text",
      "id": "bundleDesc",
      "label": "bundle Descripe"
    }
  ],
  "blocks": [{ "type": "bundle-card" }],
  "presets": [
    {
      "name": "Blast Bounty Event"
    }
  ]
}
{% endschema %}
