              <path d="M1.66699 3.33594H10.8637C11.1125 3.33594 11.3523 3.42866 11.5364 3.596L15.8337 7.50261" stroke="#262629" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3.75 13.75L18.3333 13.7581" stroke="#262629" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3.75 7.5V15.6667C3.75 16.219 4.19772 16.6667 4.75 16.6667H17.3333C17.8856 16.6667 18.3333 16.219 18.3333 15.6667V8.5C18.3333 7.94772 17.8856 7.5 17.3333 7.5H9.16675" stroke="#262629" stroke-linecap="round" stroke-linejoin="round"/>
              </g>
