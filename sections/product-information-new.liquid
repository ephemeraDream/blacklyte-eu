                  d="M23.1292 44.4509C22.3213 44.4509 21.5697 44.2153 20.8933 43.7534C20.2075 43.2821 19.6345 42.6035 19.1836 41.7269L19.0708 41.5101L16.1868 43.1124L16.2995 43.3198C17.0417 44.6583 18.0093 45.6762 19.1554 46.3549C20.3109 47.0336 21.6731 47.3823 23.2043 47.3823C25.4402 47.3823 27.3191 46.6471 28.7752 45.1861C30.2407 43.7345 30.9735 41.8588 30.9735 39.6343C30.9735 37.6266 30.344 35.9583 29.0946 34.6858C27.9391 33.4982 26.4454 32.8384 24.6511 32.7158L30.6071 24.1478H17.455V27.3149L24.9799 27.1735L18.3944 36.2034L19.2399 36.7783L19.3714 36.6841C19.9915 36.2316 20.6115 35.8829 21.2221 35.6567C21.8234 35.4304 22.4434 35.3079 23.0446 35.3079C24.4162 35.3079 25.5529 35.7415 26.4172 36.5898C27.2721 37.4381 27.7136 38.5598 27.7136 39.9077C27.7136 41.1896 27.2721 42.2735 26.3984 43.1407C25.5247 44.0173 24.4256 44.4509 23.1292 44.4509ZM62.9612 40.0679V31.3397C62.9612 28.9832 62.3412 27.1358 61.1387 25.8256C59.9174 24.5154 58.1983 23.8462 56.0188 23.8462C53.9896 23.8462 52.308 24.5343 51.021 25.8822C49.734 27.23 49.0857 29.0115 49.0857 31.1794V40.0773C49.0857 42.2453 49.734 44.0173 51.021 45.3746C52.308 46.7225 53.9802 47.4106 56.0188 47.4106C58.0667 47.4106 59.7483 46.7225 61.0353 45.3746C62.313 44.0079 62.9612 42.2264 62.9612 40.0679ZM52.3644 32.1503C52.3644 30.3405 52.6838 28.9644 53.2944 28.0878C53.905 27.2112 54.7975 26.787 56.0188 26.787C57.24 26.787 58.1325 27.2112 58.7337 28.0784C59.3444 28.9644 59.6544 30.3311 59.6544 32.1503V39.1159C59.6544 40.9351 59.3444 42.2924 58.7431 43.169C58.1513 44.0267 57.2588 44.4509 56.0188 44.4509C54.7787 44.4509 53.8863 44.0267 53.285 43.1596C52.665 42.2736 52.3644 40.9162 52.3644 39.1159V32.1503Z"
                  fill="#999999" />
          </g>
          <defs>
              <clipPath id="clip0_134_10">
                  <rect width="80" height="80.2676" fill="white"
                      transform="translate(0 0.287598)" />
              </clipPath>
          </defs>
        </svg>
      </div>
      <div class="product_info_new_left_imgthumb_prev hidden">
        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="19" viewBox="0 0 12 19" fill="none">
          <path d="M10.3208 1L2.00006 9.32074L10.3208 17.6415" stroke="black" stroke-width="2"/>
        </svg>
      </div>
      <div class="product_info_new_left_imgthumb_next">
        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="19" viewBox="0 0 12 19" fill="none">
          <path d="M1.3208 1L9.64154 9.32074L1.3208 17.6415" stroke="black" stroke-width="2"/>
        </svg>
      </div>

      {% if thumbs != blank and videos != blank %}
        <div class="product_videothumb">
          {% for thumb in thumbs %}
            {% assign i = forloop.index0 %}
            {% for video in videos %}
              {% if i == forloop.index0 %}
                {% assign video = video %}
              {% endif %}
            {% endfor %}
            {% if video != blank %}
              {% comment %} {% assign video_source = video.sources | first %} {% endcomment %}
              {% assign source_1080 = video.sources | where: 'mime_type', 'video/mp4' | where: 'height', 1080 | first %}
              {% assign source_default = video.sources | where: 'mime_type', 'video/mp4' | first %}
              <a
                href="{{ source_1080.url | default: source_default.url }}"
                data-fancybox="Video Collection"
                class="product_videothumb_item"
              >
                <img
                  width="100%"
                  height="100%"
                  src="{{ thumb | image_url }}"
                  alt="{{ thumb.alt | default: product.title }}"
                  loading="eager"
                >
                <svg
                  stroke="currentColor"
                  fill="currentColor"
                  stroke-width="0"
                  viewBox="0 0 448 512"
                  class="tw-text-white"
                  height="1em"
                  width="1em"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M424.4 214.7L72.4 6.6C43.8-10.3 0 6.1 0 47.9V464c0 37.5 40.7 60.1 72.4 41.3l352-208c31.4-18.5 31.5-64.1 0-82.6z"></path>
                </svg>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="product_info_new_left_grid pc_show{% if section.settings.show_pc_thumb %} hidden{% endif %}">
      {% assign skip_first = section.settings.show_spin | default: false %}

      {% for image in product.selected_or_first_available_variant.metafields.custom.multiple_images.value %}
        {% if skip_first == false and forloop.first %}
          {% continue %}
        {% endif %}
        {% assign hide_array = product.selected_or_first_available_variant.metafields.custom.hide_in_pc_images.value %}
        {%- if hide_array != blank and hide_array contains forloop.index -%}
          {% continue %}
        {%- endif %}
        {{-
          image
          | image_url: width: image.width
          | image_tag: alt: image.alt, class: 'product_info_new_left_grid_img'
        -}}
      {% endfor %}
    </div>
  </div>
  <div class="product_info_new_right">
    {% render 'breadcrumb-simplicity', alignment: 'left', product_type: product.metafields.custom.product_type %}
    <div class="product_info_new_right_contain">
      <div class="product_info_new_right_contain_top">
        <h1 class="product_info_new_product_title">{{ product_name }}</h1>
        <div class="product_info_new_product_desc pc_show">{{ product.description }}</div>
        {% comment %}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        {% endcomment %}
        {% render 'rating-simple' %}
        {% render 'product-price-simplicity',
          sale_price: sale_price,
          show_sale_info: show_sale_info,
          save_price: save_price,
          product: product,
          is_bottom: false,
          is_pmd_show: false,
          is_preorder: false
        %}
        <div class="product_info_new_betweenline"></div>
        {% if product.metafields.custom.discount_card != blank %}
          {% render 'discount-card', discount_card: product.metafields.custom.discount_card.value %}
        {% endif %}
        {% if product.metafields.custom.series_product != blank
          and product.metafields.custom.product_type == 'chairs'
        %}
          <div
            class="product_info_new_right_select_contain product_info_new_right_select_contain_common"
            data-type="series"
          >
            <div class="product_info_new_right_select_title">
              <span>Configuration</span>
              {% comment %}
                {% if section.settings.show_compare_modal %}
                  <span class="product_info_new_right_select_title_text" id="show_compare_modal">
                    {{- 'products.product.text.difference' | t -}}
                    <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8" fill="none">
                      <path d="M0 4H8" stroke="#262629"/>
                      <path d="M4 0L4 8" stroke="#262629"/>
                    </svg>
                  </span>
                {% endif %}
              {% endcomment %}
            </div>
            <div class="product_info_new_right_select_itembox">
              {% for series in product.metafields.custom.series_product.value %}
                <div
                  data-handle="{{ series.handle }}"
                  class="product_info_new_right_select_item{% if forloop.first %} product_info_new_right_select_item_active{% endif %}"
                >
                  <span>{{- series.metafields.custom.series_name.value -}}</span>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {% endif %}
        {% if product.metafields.custom.product_type == 'chairs' %}
          {% assign available_variants = product.variants | where: 'available' %}
          {% if available_variants.size > 1 %}
            <div
              class="product_info_new_right_select_contain product_info_new_right_select_contain_spec"
              data-type="Color"
            >
              <div class="product_info_new_right_select_title">
                {% if request.host contains '.uk' %}
                  Colour
                {% else %}
                  Color
                {% endif %}
              </div>
              <div class="product_info_new_right_select_itembox_mask"></div>
              <div class="product_info_new_right_select_itembox">
                <div class="product_info_new_right_select_title pmd_show">
                  {% if request.host contains '.uk' %}
                    Colour
                  {% else %}
                    Color
                  {% endif %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M0.707031 0.710938L14.7058 14.7097" stroke="#262629" stroke-width="2"/>
                    <path d="M14.707 0.710938L0.708308 14.7097" stroke="#262629" stroke-width="2"/>
                  </svg>
                </div>
                <div class="product_info_new_right_select_itembox_color">
                  {% assign available_variants = product.variants | where: 'available' %}
                  {% if product.title contains 'Athena Pro Gaming Chair' %}
                    {% assign unavailable_variants = product.variants | where: 'available', false %}
                    {% for variant in unavailable_variants %}
                      {% if variant.option2 contains 'Black' or variant.option2 contains 'Edition' %}
                        {%- assign add_variant = unavailable_variants | slice: forloop.index0 -%}
                        {%- assign available_variants = available_variants | concat: add_variant -%}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                  {% for variant in available_variants %}
                    {% assign is_current = false %}
                    {% if product.selected_or_first_available_variant.option1 == variant.option1
                      and product.selected_or_first_available_variant.option2 == variant.option2
                    %}
                      {% assign is_current = true %}
                    {% endif %}

                    <div
                      data-id="{{ variant.id }}"
                      data-color="{{ variant.option2 }}"
                      data-material="{{ variant.option1 }}"
                      class="product_info_new_right_select_item{% if is_current %} product_info_new_right_select_item_active{% endif %}{% if variant.available == false %} product_info_new_right_select_item_disabled{% endif %}"
                    >
                      <div class="product_info_new_right_select_item_contain">
                        {{- variant.featured_image | image_url: width: 240 | image_tag: alt: variant.title -}}
                      </div>
                      <div class="product_info_new_right_select_item_tips">
                        {{ variant.option1 | append: ' / ' | append: variant.option2 }}
                      </div>
                      {% if variant.metafields.custom.discount_price.value != blank
                        and variant.metafields.custom.discount_price.value != 0
                      %}
                        <div class="product_info_new_right_select_item_tag">SALE</div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
                <div class="product_info_new_right_select_bottom pmd_show">
                  <div class="product_info_new_right_select_bottom_flex">
                    <div class="product_info_new_right_select_bottom_option">
                      {{ product.selected_or_first_available_variant.option1 }} |
                      {{ product.selected_or_first_available_variant.option2 }}
                    </div>
                    {% render 'product-price-simplicity',
                      sale_price: sale_price,
                      show_sale_info: show_sale_info,
                      save_price: save_price,
                      product: product,
                      is_bottom: false,
                      is_pmd_show: false,
                      is_preorder: false
                    %}
                  </div>
                  <div class="product_info_new_right_select_bottom_btn">Confirm Selection</div>
                </div>
              </div>
              <div class="product_info_new_right_select_choosedbox">
                <div class="product_info_new_right_select_choosedbox_left">
                  <div class="product_info_new_right_select_choosedbox_img">
                    <img
                      src="{{ product.selected_or_first_available_variant.featured_image | image_url }}"
                      width="100%"
                      height="100%"
                    >
                  </div>
                  <div class="product_info_new_right_select_choosedbox_title">
                    {{ product.selected_or_first_available_variant.option1 }} |
                    {{ product.selected_or_first_available_variant.option2 }}
                  </div>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="12" viewBox="0 0 7 12" fill="none">
                  <path d="M0.353516 0.351562L5.85858 5.85663L0.353516 11.3617" stroke="#262629"/>
                </svg>
              </div>
            </div>
          {% endif %}
        {% else %}
          {% for option in product.options_with_values %}
            {%- case option.name -%}
              {%- when 'Color' -%}
                {% if option.values.size > 1 or product.metafields.custom.product_type == 'desk' %}
                  <div
                    class="product_info_new_right_select_contain product_info_new_right_select_contain_common"
                    data-type="{{ option.name }}"
                  >
                    <div class="product_info_new_right_select_title">
                      {% if request.host contains '.uk' %}
                        Colour
