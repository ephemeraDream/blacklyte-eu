{{ 'product-information-new.css' | asset_url | stylesheet_tag }}
{{ 'recommended-products-new.css' | asset_url | stylesheet_tag }}
<link
  rel="stylesheet"
  type="text/css"
  href="https://cdn.shopify.com/s/files/1/0716/1341/5637/files/slick.css?v=1760406619"
>
<link rel="stylesheet" href="{{ 'component-fancybox.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-fancybox.css' | asset_url | stylesheet_tag }}</noscript>

<style>
    {% assign small_img_list = section.settings.small_img | split: "," %}
    {% for item in small_img_list %}
      .product_info_new .product_info_new_left_grid_img:nth-child({{item}}){% unless forloop.last %},{% endunless %}
    {% endfor %}
    {
    flex: 0 0 auto;
    width: calc((100% - 0.78125vw) / 2);
    height: 18.75vw;
    object-fit: cover;
    object-position: center center;
    border-radius: 0.46875vw;
  }
</style>

{% for currency in shop.enabled_currencies %}
  {% if currency.iso_code == shop.currency %}
    {%- assign currency_symbol = currency.symbol -%}
    {% break %}
  {% endif %}
{% endfor %}
{% liquid
  assign show_sale_info = false
  assign sale_price = product.selected_or_first_available_variant.price
  if product.selected_or_first_available_variant.metafields.custom.discount_price.value != blank and product.selected_or_first_available_variant.metafields.custom.discount_price.value != 0
    assign save_price = product.selected_or_first_available_variant.metafields.custom.discount_price.value
    assign sale_price = product.selected_or_first_available_variant.price | minus: save_price
    assign show_sale_info = true
  endif
%}
{% assign product_name = product.metafields.custom.alias | default: product.title %}
{% assign thumbs = product.selected_or_first_available_variant.metafields.custom.multiple_video_thumb.value %}
{% assign videos = product.selected_or_first_available_variant.metafields.custom.multiple_video.value %}

<div class="product_info_new">
  <div class="product_info_new_left{% if section.settings.show_pc_thumb %} show_pc_thumb{% endif %}">
    <div class="product_info_new_left_imgmain">
      <div class="product_info_new_left_imgmain_body">
        {% assign show_images = product.selected_or_first_available_variant.metafields.custom.multiple_images.value
          | default: product.images
        %}
        {% for image in show_images %}
          <div class="product_info_new_left_imgmain_item">
            {{- image | image_url: width: image.width | image_tag: alt: image.alt -}}
          </div>
        {% endfor -%}
      </div>
      <div class="product_info_new_left_spin{% unless section.settings.show_spin %} hidden{% endunless %}">
        {% render 'product-360',
          images: product.selected_or_first_available_variant.metafields.custom.spin_images.value
        %}
      </div>
      <div class="product_info_new_left_imgmain_prev{% unless section.settings.show_pc_thumb %} pmd_show{% endunless %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="19" viewBox="0 0 12 19" fill="none">
          <path d="M10.3208 1L2.00006 9.32074L10.3208 17.6415" stroke="black" stroke-width="2"/>
        </svg>
      </div>
      <div class="product_info_new_left_imgmain_next{% unless section.settings.show_pc_thumb %} pmd_show{% endunless %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="19" viewBox="0 0 12 19" fill="none">
          <path d="M1.3208 1L9.64154 9.32074L1.3208 17.6415" stroke="black" stroke-width="2"/>
        </svg>
      </div>
      <div class="product_info_new_left_pcvideo pc_show">
        {% if thumbs != blank and videos != blank %}
          <div class="product_videothumb">
            {% for thumb in thumbs %}
              {% assign i = forloop.index0 %}
              {% for video in videos %}
                {% if i == forloop.index0 %}
                  {% assign video = video %}
                {% endif %}
              {% endfor %}
              {% if video != blank %}
                {% comment %} {% assign video_source = video.sources | first %} {% endcomment %}
                {% assign source_1080 = video.sources
                  | where: 'mime_type', 'video/mp4'
                  | where: 'height', 1080
                  | first
                %}
                {% assign source_default = video.sources | where: 'mime_type', 'video/mp4' | first %}
                <a
                  href="{{ source_1080.url | default: source_default.url }}"
                  data-fancybox="Video PC Collection"
                  class="product_videothumb_item"
                >
                  <img
                    width="100%"
                    height="100%"
                    src="{{ thumb | image_url }}"
                    alt="{{ thumb.alt | default: product.title }}"
                    loading="eager"
                  >
                  <svg
                    stroke="currentColor"
                    fill="currentColor"
                    stroke-width="0"
                    viewBox="0 0 448 512"
                    class="tw-text-white"
                    height="1em"
                    width="1em"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M424.4 214.7L72.4 6.6C43.8-10.3 0 6.1 0 47.9V464c0 37.5 40.7 60.1 72.4 41.3l352-208c31.4-18.5 31.5-64.1 0-82.6z"></path>
                  </svg>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
    <div class="product_info_new_left_imgthumb{% unless section.settings.show_pc_thumb %} pmd_show{% endunless %}{% if thumbs != blank and videos != blank %} has_video{% endif %}">
      <div class="product_info_new_left_imgthumb_body">
        {% assign thumb_images = product.selected_or_first_available_variant.metafields.custom.multiple_images.value
          | default: product.images
        %}
        {% if product.selected_or_first_available_variant.metafields.custom.multiple_thumb_images != blank %}
          {% assign thumb_images = product.selected_or_first_available_variant.metafields.custom.multiple_thumb_images.value %}
        {% endif %}
        {% for image in thumb_images %}
          <div class="product_info_new_left_imgthumb_item">
            {% assign img_alt = image.alt | default: product.title %}
            {{- image | image_url: width: image.width | image_tag: alt: img_alt -}}
          </div>
        {% endfor -%}
      </div>
      <div class="product_info_new_left_spin_icon hidden">
        {% comment %}
          {{-
            product.selected_or_first_available_variant.featured_image
            | image_url: width: 80
            | image_tag: alt: product.title
          -}}
        {% endcomment %}
        <svg
          width="80"
          height="81"
          viewBox="0 0 80 81"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <g clip-path="url(#clip0_134_10)">
