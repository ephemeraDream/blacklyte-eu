  <div class="product_info_new_bottom_bar">
    <div class="product_info_new_bottom_bar_contain">
      <div class="pc_show">
        <div class="product_info_new_bottom_bar_title">{{ product_name }}</div>
      </div>
      <div class="product_info_new_bottom_bar_contain_right">
        {% render 'product-price-simplicity',
          sale_price: sale_price,
          show_sale_info: show_sale_info,
          save_price: save_price,
          product: product,
          is_bottom: true,
          is_pmd_show: false,
          is_preorder: false,
          need_change: true,
          buy_more_discount: product.metafields.custom.buy_more_discount.value
        %}
        <div class="product_info_new_right_buybox_btns">
          <button
            data-type="buy_it_now"

            class="product_info_new_right_buybox_btns_btn"
            {% if product.selected_or_first_available_variant.available == false
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            {{ 'products.product.buy_it_now' | t }}
          </button>
          <button
            type="submit"
            class="product_info_new_right_buybox_btns_btn"
            data-type="add_to_cart"
            {% if product.selected_or_first_available_variant.available == false
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            {% if product.selected_or_first_available_variant.inventory_quantity <= 0 %}
              {% if product.selected_or_first_available_variant.available %}
                {{ 'products.product.add_to_cart' | t }}
              {% else %}
                {{ 'products.product.out_of_stock' | t }}
              {% endif %}
            {% else %}
              {{ 'products.product.add_to_cart' | t }}
            {% endif %}
          </button>
        </div>
      </div>
    </div>
  </div>

  {% render 'payway-modal' %}
</div>

