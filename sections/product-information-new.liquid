              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag }}
              {%- endfor -%}
            </div>
          </div>
        </div>
        {% if product.metafields.custom.extra_description != blank %}
          <div class="product_info_new_right_extra_desc">
            {{ product.metafields.custom.extra_description | metafield_tag }}
          </div>
        {% endif %}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {% when 'extra_desc' %}
              {{ block.settings.html }}
          {%- endcase -%}
        {%- endfor -%}
        {% render 'recommended-products-new', currency_symbol: currency_symbol %}
      </div>
