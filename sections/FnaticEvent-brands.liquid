<style>
    .section-{{ section.id }}{
        overflow: hidden;
    }
    .section-{{ section.id }} .section-title{
        font-family: Poppins;
        font-weight: 600;
        font-style: SemiBold;
        font-size: 36px;
        line-height: 54px;
        letter-spacing: 0%;
        text-align: center;
        text-transform: capitalize;
        color: #fff;
    }
    .section-{{ section.id }} .brands-cont{
        padding:94px 0 78px;
    }
    .section-{{ section.id }} .brands-list{
        margin-top: 65px;
        padding-left: 16%;
        padding-right: 16%;
        display: flex;
        gap: 56px;
    }
    .section-{{ section.id }} img{
        height: auto;
    }
    .section-{{ section.id }} .online-lists{
        display: flex;
        flex-wrap: wrap;
    }
    .section-{{ section.id }} .online-lists .online-item{
        width: calc(100% / 4);
    }


    {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-{{ section.id }} .brands-list{
            padding-left: 10px;
            padding-right: 10px;
        }
    }

    {% comment %} iPhone {% endcomment %}
    @media(max-width: 767px){
        .section-{{ section.id }} .brands-list{
            padding-left: 10px;
            padding-right: 10px;
            margin-top: 13px;
            gap: 14px;
        }
        .section-{{ section.id }} .online-lists .online-item{
            width: calc(100% / 2);
        }
        .section-{{ section.id }} .section-title{
            font-size: 22px;
            line-height: 30px;
            padding-left: 10px;
            padding-right: 10px;
        }
        .section-{{ section.id }} .brands-cont{
            padding: 37px 0 18px;
        }
    }

    {% comment %} small screen {% endcomment %}
    @media(min-width: 1025px) and (max-width: 1480px){
        .section-{{ section.id }} .brands-list{
            padding-left: 60px;
            padding-right: 60px;
        }
    }

</style>

<section class="section-{{ section.id }}" data-section-id="{{ section.id }}" id="{{ section.id }}">
    {% liquid
      assign brands_cont_bg_image = section.settings.brandsContBgImage
    %}

    <style>
        .brands-cont{
            background-image: url({{ brands_cont_bg_image | img_url: 'master' }});
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }
    </style>

    <div class="container-full">
        <div class="brands-cont">
            {% if section.settings.sectionTitle != blank %}
                <div class="section-title">{{ section.settings.sectionTitle }}</div>
            {% endif %}
            <div class="brands-list">
                {% for block in section.blocks %}
                    {% if block.type == "logoItem" %}
                        <div class="brand-item">
                            <img {% render 'lazyload',preview_img: block.settings.logoImg, class: true, enable_rtl: settings.enable_layout_rtl  %}
                                width="{{ block.settings.logoImg.width }}"
                                height="{{ block.settings.logoImg.height }}"
                                alt="{{ block.settings.logoImg.alt }}" />
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        
        <div class="online-lists">
            {% for block in section.blocks %}
                {% if block.type == "onlineItem" %}
                    <div class="online-item">
                        <img {% render 'lazyload',preview_img: block.settings.onlineImg, class: true, enable_rtl: settings.enable_layout_rtl  %}
                            width="{{ block.settings.onlineImg.width }}"
                            height="{{ block.settings.onlineImg.height }}"
                            alt="{{ block.settings.onlineImg.alt }}" />
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
    "name": "Fnatic Event Brands",
    "settings": [
        {
            "type": "image_picker",
            "id": "brandsContBgImage",
            "label": "brands Cont Background Image"
        },
        {
            "type": "text",
            "id": "sectionTitle",
            "label": "section Title",
            "default": "Chase Victory on the World’s Top Stages"
        }
    ],
    "blocks": [
        {
            "type": "logoItem",
            "name": "logoItem",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "logoImg",
                    "label": "Logo Item"
                }
            ]
        },
        {
            "type": "onlineItem",
            "name": "onlineItem",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "onlineImg",
                    "label": "online Image"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Fnatic Event Brands"
        }
    ]
}
{% endschema %}