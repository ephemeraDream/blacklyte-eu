<style>
    .section-block-{{ section.id }} .large-image-container .large-image-pc{
        display: block;
    }
    .section-block-{{ section.id }} .large-image-container .large-image-mb{
        display: none;
    }
    .section-block-{{ section.id }} .large-image-container{
        position: relative;
        overflow: hidden;
    }
    .section-block-{{ section.id }} .large-image-container .large-image img{
        position: absolute;
        top: 0;
        left: 0;
        height: auto;
    }
    .section-block-{{ section.id }} .large-image-cont{
        position: absolute;
        bottom: 57px;
        width: 58%;
        text-align: center;
        left: 50%;
        transform: translateX(-50%);
    }
    .section-block-{{ section.id }} .large-image-cont-title{
        font-family: Poppins;
        font-weight: 700;
        font-style: Bold;
        font-size: 48px;
        line-height: normal;
        letter-spacing: 0%;
        background: linear-gradient(90deg, #CFA359 0%, #EED497 100%);
        color: transparent;
        -webkit-background-clip: text;
        background-clip: text;
    }
    .section-block-{{ section.id }} .large-image-cont-desc{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 20px;
        line-height: normal;
        letter-spacing: 0%;
        text-align: center;
        color: #fff;
    }
    .section-block-{{ section.id }} .large-image-cont-title-2{
        font-family: Poppins;
        font-weight: 700;
        font-style: Bold;
        font-size: 30px;
        line-height: normal;
        letter-spacing: 0%;
        background: linear-gradient(90deg, #CFA359 0%, #EED497 100%);
        color: transparent;
        -webkit-background-clip: text;
        background-clip: text;
    }
    .section-block-{{ section.id }} .large-image-cont-desc-2{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 14px;
        line-height: normal;
        letter-spacing: 0%;
        text-align: center;
        color: #fff;
    }



    {% comment %} iPhone {% endcomment %}
    @media(max-width: 767px){
        .section-block-{{ section.id }} .large-image-container .large-image-pc{
            display: none;
        }
        .section-block-{{ section.id }} .large-image-container .large-image-mb{
            display: block;
        }
        .section-block-{{ section.id }} .large-image-cont{
            width: 90%;
            bottom: 27px;
        }
        .section-block-{{ section.id }} .large-image-cont-title{
            font-size: 26px;
        }
        .section-block-{{ section.id }} .large-image-cont-desc{
            font-size: 14px;
            margin-top: 5px;
            width: 80%;
            margin-left: auto;
            margin-right: auto;
        }
        .section-block-{{ section.id }} .large-image-cont-title-2{
            font-size: 16px;
            margin-top: 8px;
        }
        .section-block-{{ section.id }} .large-image-cont-desc-2{
            font-size: 10px;
            margin-top: 8px;
        }
    }

    {% comment %} iPad {% endcomment %}
    @media(min-width: 768px) and (max-width: 1024px){
        .section-block-{{ section.id }} .large-image-cont-title{
            font-size: 40px;
        }
        .section-block-{{ section.id }} .large-image-cont-desc{
            font-size: 20px;
        }
    }
</style>

<section id="{{ section.id }}" class="section-block-{{ section.id }}" data-section-id="{{ section.id }}">
    <div class="container-full">
        {% for block in section.blocks %}
            {% if block.type == "largeImage" %}
                <div class="large-image-container">
                    <div class="large-image large-image-pc" style="padding-top: {% unless block.settings.bannerImage.presentation.focal_point == '50.0% 50.0%' %}{{ 1 | divided_by: block.settings.bannerImage.aspect_ratio | times: 120 }}%{% else %}{{ 1 | divided_by: block.settings.bannerImage.aspect_ratio | times: 100 }}%{% endunless %}">
                        <img
                            src="{{ block.settings.bannerImage | img_url: 'master' }}"
                            alt="{{ block.settings.bannerImage.alt }}"
                            width="{{ block.settings.bannerImage.width }}"
                            height="{{ block.settings.bannerImage.height }}" />
                    </div>
                    <div class="large-image large-image-mb" style="padding-top: {% unless block.settings.bannerImageMobile.presentation.focal_point == '50.0% 50.0%' %}{{ 1 | divided_by: block.settings.bannerImageMobile.aspect_ratio | times: 120 }}%{% else %}{{ 1 | divided_by: block.settings.bannerImageMobile.aspect_ratio | times: 100 }}%{% endunless %}">
                        <img
                            src="{{ block.settings.bannerImageMobile | img_url: 'master' }}"
                            alt="{{ block.settings.bannerImageMobile.alt }}"
                            width="{{ block.settings.bannerImageMobile.width }}"
                            height="{{ block.settings.bannerImageMobile.height }}" />
                    </div>
                    <div class="large-image-cont">
                        {% if block.settings.title != blank %}
                            <div class="large-image-cont-title">{{ block.settings.title }}</div>
                        {% endif %}
                        {% if block.settings.descripe != blank %}
                            <div class="large-image-cont-desc">{{ block.settings.descripe }}</div>
                        {% endif %}
                        {% if block.settings.title-sub != blank %}
                            <div class="large-image-cont-title-2">{{ block.settings.title-sub }}</div>
                        {% endif %}
                        {% if block.settings.descripe-sub != blank %}
                            <div class="large-image-cont-desc-2">{{ block.settings.descripe-sub }}</div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</section>

{% schema %}
{
    "name": "xmas Banner",
    "settings": [ ],
    "blocks": [
        {
            "type": "largeImage",
            "name": "largeImage",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "bannerImage",
                    "label": "Banner Image"
                },
                {
                    "type": "image_picker",
                    "id": "bannerImageMobile",
                    "label": "Banner Image Mobile"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Banner Image Title"
                },
                {
                    "type": "text",
                    "id": "descripe",
                    "label": "Banner Image Descripe"
                },
                {
                    "type": "text",
                    "id": "title-sub",
                    "label": "Banner Title sub"
                },
                {
                    "type": "text",
                    "id": "descripe-sub",
                    "label": "Banner Descripe sub"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "xmas Banner"
        }
    ]
}
{% endschema %}