{{ 'bundle-card.css' | asset_url | stylesheet_tag }}

<section class="black-friday-container" id="black-firday-section-target">
  {% comment %} <div class="container-btns">
    {% content_for 'block', type: 'blackfriday-btnitem', id: 'blackfriday-btnitem-1', active: true %}
    {% content_for 'block', type: 'blackfriday-btnitem', id: 'blackfriday-btnitem-2' %}
    {% content_for 'block', type: 'blackfriday-btnitem', id: 'blackfriday-btnitem-3' %}
  </div> {% endcomment %}
  <div class="filter-cont">
    <div class="filter-label">
      <span class="icons">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10.8333 12.0846V13.7513L10 13.2513V9.58463L6.66667 5.83464H14.1667L10.8333 9.5013V12.0846ZM12.5 10.3346L18.3333 4.16797H2.5L8.33333 10.3346V14.168L12.5 16.668V10.3346Z" fill="#262629"/>
        </svg>
      </span>
      <span class="text">{{ section.settings.filterLabelText }}</span>
    </div>
    <div class="filters-options">
      <form id="CollectionFiltersForm" class="collection-filters-form">
        {% for filter in collection.filters %}
          <fieldset class="filter-group">
            <legend class="filter-group-label">
              <span>{{ filter.label }}</span>
              <span class="filter-icon">
                <svg width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M15.5 7.5L10.5 12.5L5.5 7.5" stroke="#262629" stroke-width="1.4"/>
                </svg>
              </span>
            </legend>
            <div class="filter-options-container">
              {% for value in filter.values %}
                <label class="checkbox-container">
                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}
                      checked
                    {% endif %}
                    class="filter-checkbox"
                  >
                  <span class="label-text">{{ value.label }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      </form>
    </div>
  </div>
  <div class="container-box">
    <div class="prods-lists">
      {% for product in collection.products %}
        {%- liquid
          assign variant_img = ''
          for option in product.options_with_values
            for variant in product.variants limit: 1
              if variant.image != null
                assign variant_img = variant.image
              endif
            endfor
          endfor
        -%}
        <div class="prod-items" data-product-id="{{ product.id }}">
          <div class="card-product">
            {% render 'product-badge', product: product, class: 'card__badge', badge_detail: true, serial: serial %}
            <div
              class="card-media card-media--adapt {% if product.media[1] != nil and settings.show_image_swap %} media--hover-effect{% endif%} media--loading-effect"
              style="padding-bottom: {{ 1.1 | times: 100 }}%;"
            >
              {% render 'image-product-card',
                product_card_product: product,
                variant_img: variant_img,
                has_video: false,
                loading: true
              %}
              <a class="card-link" href="{{ product.url }}" title="{{ product.title | escape }}"></a>
            </div>
            <div class="atc-btns">
              <span class="icons-svg">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.25 5L9.25 5" stroke="white" stroke-width="2"/>
                  <path d="M4.75 0.5L4.75 9.5" stroke="white" stroke-width="2"/>
                </svg>
              </span>
              <span>{{ 'products.product.add_to_cart' | t }}</span>
            </div>
            {% if product.selected_or_first_available_variant.metafields.custom.discount_price.value != blank %}
              <div class="sale-tags">
                SALE
              </div>
            {% endif %}
          </div>
          <div class="prod-item-cont">
            <div class="prod-item-cont-title">{{ product.title }}</div>
            <div class="flex-1"></div>
            <div class="prod-item-cont-desc">
              {% if product.selected_or_first_available_variant.title != 'Default Title' %}
                {{ product.selected_or_first_available_variant.title }}
              {% endif %}
            </div>
            <div class="prod-item-cont-price {% if product.selected_or_first_available_variant.metafields.custom.discount_price.value != blank %}prod-item-cont-discount-price{% endif %}">
              {% if product.selected_or_first_available_variant.metafields.custom.discount_price.value != blank %}
                <div class="discount-price-info">
                  {{ product.selected_or_first_available_variant.price
                    | minus: product.selected_or_first_available_variant.metafields.custom.discount_price.value
                    | money_without_currency
                  }}
                </div>
              {% endif %}
              <div class="sale-price-item">{{ product.selected_or_first_available_variant.price | money }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="container-box container-box-bundle hidden">
    <div class="black-friday-bundle-container">{% content_for 'blocks' %}</div>
  </div>
  <div class="container-box container-box-limited hidden">
    <div class="prods-lists">
      {% for product in section.settings.limitProductList %}
        {%- liquid
          assign variant_img = ''
          for option in product.options_with_values
            for variant in product.variants limit: 1
              if variant.image != null
                assign variant_img = variant.image
              endif
            endfor
          endfor
        -%}
        <div class="prod-items" data-product-id={{ product.id }}>
          <div class="card-product">
            {% render 'product-badge', product: product, class: 'card__badge', badge_detail: true, serial: serial %}
            <div
              class="card-media card-media--adapt {% if product.media[1] != nil and settings.show_image_swap %} media--hover-effect{% endif%} media--loading-effect"
              style="padding-bottom: {{ 1.1 | times: 100 }}%;"
            >
              {% render 'image-product-card',
                product_card_product: product,
                variant_img: variant_img,
                has_video: false,
                loading: true
              %}
              <a class="card-link" href="{{ product.url }}" title="{{ product.title | escape }}"></a>
            </div>
            <div class="atc-btns">
              <span class="icons-svg">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.25 5L9.25 5" stroke="white" stroke-width="2"/>
                  <path d="M4.75 0.5L4.75 9.5" stroke="white" stroke-width="2"/>
                </svg>
              </span>
              <span>{{ 'products.product.add_to_cart' | t }}</span>
            </div>
            {% if product.selected_or_first_available_variant.metafields.custom.discount_price.value != blank %}
              <div class="sale-tags">
                SALE
              </div>
            {% endif %}
          </div>
          <div class="prod-item-cont">
            <div class="prod-item-cont-title">{{ product.title }}</div>
            <div class="flex-1"></div>
            <div class="prod-item-cont-desc">
              {% if product.selected_or_first_available_variant.title != 'Default Title' %}
                {{ product.selected_or_first_available_variant.title }}
              {% endif %}
            </div>
            <div class="prod-item-cont-price {% if product.selected_or_first_available_variant.metafields.custom.discount_price.value != blank %}prod-item-cont-discount-price{% endif %}">
              {% if product.selected_or_first_available_variant.metafields.custom.discount_price.value != blank %}
                <div class="discount-price-info">
                  {{ product.selected_or_first_available_variant.price
                    | minus: product.selected_or_first_available_variant.metafields.custom.discount_price.value
                    | money_without_currency
                  }}
                </div>
              {% endif %}
              <div class="sale-price-item">{{ product.selected_or_first_available_variant.price | money }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
    $('.black-friday-container .container-btns .cont-button-item').on('click', function(){
      if ($(this).hasClass('cont-button-item-active')) {
          return;
      }

      $(".black-friday-container .container-btns .cont-button-item").removeClass('cont-button-item-active');
      $(this).addClass('cont-button-item-active');

      {% comment %} 获取当前点击按钮的索引 {% endcomment %}
      const index = $(this).index('.black-friday-container .container-btns .cont-button-item');

      {% comment %} 根据索引切换对应内容 {% endcomment %}
      const $boxes = $(".black-friday-container .container-box");
      $boxes.addClass('hidden');
      $boxes.eq(index).removeClass('hidden');
      $('.filter-cont').toggleClass("hidden");

      {% comment %} 如果点击的是索引为1的按钮（第二个，bundle） {% endcomment %}
      if (index === 1) {
          const url = new URL(window.location.href);
          url.searchParams.set('tab', 'bundle'); 
          window.history.replaceState(null, '', url.toString());
      } else {
          {% comment %} 如果点击的是其他按钮，就移除 tab 参数（可选） {% endcomment %}
          const url = new URL(window.location.href);
          url.searchParams.delete('tab');
          window.history.replaceState(null, '', url.toString());
      }
    });

  {% comment %} ATC buttons {% endcomment %}
  $('.black-friday-container .container-box .prods-lists').on('click', '.atc-btns', function() {
      const cardLink = $(this).closest('.card-product').find('.card-link').attr('href').split('?');
      if(cardLink[1]){
          const variantId = cardLink[1].split('=')[1]
          let formData = {
              'items': [{ 'id': variantId, 'quantity': 1 }]
          };

          fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: {
                  'Content-Type': 'application/json'
              },
              body: JSON.stringify(formData)
          }).then(response => {
              {% comment %} window.location.href = '/cart' {% endcomment %}
              Shopify.getCart((cartTotal) => {
                document.body.classList.add("cart-sidebar-show")
                window.updateSidebarCart(cartTotal)
              });
              
          }).catch((error) => {
              console.error('Error:', error);
          })
      }
  });

  {% comment %} remove gaming chair and update variants {% endcomment %}
  $(document).ready(function() {
      setTimeout(()=>{
          $('.black-friday-container .container-box .prods-lists .prod-items').each(function(){
              const titleArr = $(this).find('.prod-item-cont-title').text().trim().split('-')
              const titleDom = $(this).find('.prod-item-cont-title')
              const descText = $(this).find('.prod-item-cont-desc')
              if(titleArr.length > 0 && titleArr[1]) {
                  const variantText = titleArr[1].replace(/ \/ /, '-')
                  descText.text(variantText)
                  titleDom.text(titleArr[0])
              }
          })

      }, 0)
      
      {% comment %} remove gaming chair {% endcomment %}
      setTimeout(function() {
        $('.black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-title').each(function() {
          var txt = $(this).text().trim();
          if (txt.endsWith(' Gaming Chair')) {
            txt = txt.replace(/ Gaming Chair$/, '');
            $(this).text(txt);
          }
        });
      }, 0)
  })

  {% comment %} filter submit {% endcomment %}
  document.addEventListener('change', function (e) {
      const form = document.querySelector('#CollectionFiltersForm');
      if (form && e.target.closest('#CollectionFiltersForm')) {
          form.submit();
      }
  });
  {% comment %} click filter label {% endcomment %}
  $(document).on('click', '.filter-group-label', function (e) {
      e.stopPropagation();
      const $label = $(this);
      const $group = $label.closest('.filter-group');
      const $content = $group.find('.filter-options-container');

      $('.filter-group-label').not($label).removeClass('filter-group-label-active');
      $('.filter-options-container').not($content).removeClass('filter-options-container-active');

      $label.toggleClass('filter-group-label-active');
      $content.toggleClass('filter-options-container-active');
  });

  $(document).on('click', function (e) {
      if (!$(e.target).closest('.filter-group').length) {
          $('.filter-group-label').removeClass('filter-group-label-active');
          $('.filter-options-container').removeClass('filter-options-container-active');
      }
  });

  $('.black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-price.prod-item-cont-discount-price .discount-price-info').each(function() {
    const text = $(this).text().replace(/\s+/g, '');
    $(this).text(text);
  });

  {% comment %} url has bundle tab {% endcomment %}
  if (new URLSearchParams(window.location.search).get('tab') === 'bundle') {
      $(".black-friday-container .container-btns .cont-button-item").removeClass('cont-button-item-active');

      $(".black-friday-container .container-btns .cont-button-item").eq(1).addClass('cont-button-item-active');

      const $boxes = $(".black-friday-container .container-box");

      $boxes.addClass('hidden');

      $boxes.eq(1).removeClass('hidden');

      $('.filter-cont').toggleClass("hidden");

      {% comment %} scroll {% endcomment %}
      const target = $('#black-firday-section-target');
      if (target.length > 0) {
          $('html, body').animate({
              scrollTop: target.offset().top
          }, 500);
      }
  }

