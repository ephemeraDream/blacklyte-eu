<style>
  .black-friday-container{
      background: #EFEFEF;
      padding-top: 120px;
  }
  .black-friday-container .container-btns{
      display: flex;
      gap: 30px;
      justify-content: center;
      margin-bottom: 80px;
  }
  .black-friday-container .container-btns .shopify-block{
    width: calc((90% - 120px) / 3);
  }
  .black-friday-container .container-btns .cont-button-item{
      font: 700 18px var(--font-family-3);
      border-radius: 74px;
      display: flex;
      padding: 24px 0;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      border: 1px solid #931717;
      cursor: pointer;
      color: #931717;
      text-align: center;
      height: 100%;
  }
  .black-friday-container .container-btns .cont-button-item-active{
      background: #262629;
      color: #ffffff;
      border-color: #262629;
  }
  .black-friday-container .container-btns .cont-button-item .item-btn-title{ }

  .black-friday-container .container-box{
      width: calc(100% - 280px);
      margin: 20px auto 0;
      position: relative;
  }
  .black-friday-container .filter-cont{
      width: calc(100% - 280px);
      margin: 0 auto;
  }
  .black-friday-container .container-box:before{
      content: '';
      display: inline-block;
      width: 100vw;
      height: 0.5px;
      background: #26262980;
      position: absolute;
      left: -140px;
      top: 0;
  }
  .black-friday-container .container-box .prods-lists{
      display: flex;
      flex-wrap: wrap;
  }
  .black-friday-container .container-box .prods-lists .prod-items{
      width: calc(100% / 4);
      border-right: 0.5px solid #26262980;
      border-bottom: 0.5px solid #26262980;
      display: flex;
      flex-direction: column;
  }
  .black-friday-container .container-box .prods-lists .prod-items:nth-of-type(4n+1){
      border-left: 0.5px solid #26262980;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont{
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 20px 40px;
      flex: 1;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-title{
      font: 500 18px var(--font-family-1);
      color: #262629;
      text-align: center;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .flex-1{
      display: block;
      flex: 1;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-desc{
      font: 400 14px var(--font-family-1);
      color: #262629;
      opacity: 0.7;
      margin: 6px auto 12px;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-price{
      font: 500 16px var(--font-family-1);
      color: #262629;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-price.prod-item-cont-discount-price{
    display: flex;
    gap: 5px;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-price.prod-item-cont-discount-price .discount-price-info{
    color: #931717;
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-price.prod-item-cont-discount-price .discount-price-info:before{
    content: '€';
  }
  .black-friday-container .container-box .prods-lists .prod-items .prod-item-cont .prod-item-cont-price.prod-item-cont-discount-price .sale-price-item{
    text-decoration: line-through;
    opacity: 0.7;
  }
  .black-friday-container .container-box .prods-lists .prod-items .atc-btns{
      display: flex;
      gap: 5px;
      font: 600 16px var(--font-family-1);
      color: #fff;
      padding: 8px 18px;
      background: #262629;
      border: 1px solid #262629;
      border-radius: 50px;
      width: max-content;
      cursor: pointer;
      position: absolute;
      bottom: -100px;
      opacity: 0;
      left: 50%;
      transform: translateX(-50%);
      z-index: 19;
      transition: all .5s ease-in-out;
  }
  .black-friday-container .container-box .prods-lists .prod-items:hover .atc-btns{
      opacity: 1;
      bottom: 10px;
  }
  .black-friday-container .container-box .prods-lists .prod-items .atc-btns:hover{
      color: #fff;
      background: #931717;
      border-color: #931717;
  }
  .black-friday-container .container-box .prods-lists .prod-items .atc-btns:hover .icons-svg svg path{
      stroke: #fff;
  }
  .black-friday-container .container-box .prods-lists .prod-items .atc-btns .icons-svg{
      display: flex;
      justify-content: center;
      align-items: center;
  }
  .black-friday-container .container-box .prods-lists .prod-items .atc-btns .icons-svg svg{
      width: 10px;
      height: 10px;
      stroke: none;
  }
  .black-friday-container .container-box .prods-lists .prod-items .sale-tags{
    font: 500 14px var(--font-family-1);
    color: #fff;
    background: #931717;
    padding: 4px;
    position: absolute;
    top: 10px;
    left: 10px;
  }
  .black-friday-container .filter-cont{
      display: flex;
      gap: 30px;
      align-items: center;
  }
  .black-friday-container .filter-cont .filter-label{
      font: 500 14px var(--font-family-3);
      color: #262629;
  }
  .black-friday-container .filter-cont .filter-label svg{
      width: 20px;
      height: 20px;
      fill: none;
      stroke: none;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form{
      display: flex;
      gap: 30px;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group{
      font: 500 16px var(--font-family-3);
      border: none;
      cursor: pointer;
      position: relative;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group:nth-of-type(2){
      display: none;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group .filter-icon svg{
      width: 20px;
      height: 20px;
      transition: all .35s ease-in-out;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group .filter-group-label.filter-group-label-active svg{
      transform: rotate(-180deg);

  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group .filter-options-container{
      display: flex;
      gap: 10px;
      flex-direction: column;
      position: absolute;
      top: 10px;
      left: 0;
      padding: 1rem 2rem 1rem 1rem;
      border: 1px solid #26262980;
      box-shadow: 0px 10px 8px 0px rgba(0, 0, 0, 0.04);
      z-index: -1;
      background: #EFEFEF;
      opacity: 0;
      transition: opacity .35s ease-in-out;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group .filter-options-container.filter-options-container-active{
      opacity: 1;
      z-index: 10;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group .filter-checkbox{
      display: block;
      width: 16px;
      height: 16px;
      position: static;
      clip: auto;
      appearance: auto;
  }
  .black-friday-container .filter-cont .filters-options .collection-filters-form .filter-group .checkbox-container{
      font: 500 14px var(--font-family-3);
      display: flex;
      gap: 5px;
      align-items: center;
      white-space: nowrap;
      cursor: pointer;
  }

    .black-friday-container .black-friday-bundle-container {
      display: flex;
      flex-wrap: wrap;
      gap: 1.984375vw 1.046875vw;
      padding: 0 15.625vw 7.65625vw;
  }

  .black-friday-container .container-box-bundle {
      margin: 0;
      width: 100%;
    }

  .black-friday-container .container-box-bundle::before {
      display: none;
  }

