      {% comment %} // 检查当前页面的URL是否包含特定字符串（例如"/pages/Athena-Gaming-Chair"） {% endcomment %}
      if (
        currentPageUrl.indexOf('/pages/athena-gaming-chair') !== -1 ||
        currentPageUrl.indexOf('/pages/athena-gaming-vorsitzender') !== -1 ||
        currentPageUrl.indexOf('/pages/sillon-de-athena') !== -1 ||
        currentPageUrl.indexOf('/pages/athena-gaming-secaso') !== -1
      ) {
        $('sticky-header.header-navigation-wrapper').attr('data-sticky-type', 'none');
        $('#shopify-section-sections--17951220957433__announcement-bar').css('position', 'static');
      } else {
        $('.header-navigation-wrapper').attr('data-sticky-type', 'always');
      }

      if (currentPageUrl.indexOf('/pages/chair-collection-mb') !== -1) {
        $('.footer').css('display', 'none');
      }

      if (window.location.pathname === '/collections/christmas-sale') {
        $('.shop_now_btn_xmas').each(function () {
          $(this).css('display', 'block');
        });
      }
    })(jQuery);
  </script>
  <script>
    (function () {
      const conversationBadge = document.querySelector('#conversation-badge');
      const zendeskSrc = 'https://static.zdassets.com/ekr/snippet.js?key=6856ecae-0aa6-4f39-aea5-ffac195d4597';
      let zendeskRequested = false;

      function loadZendesk() {
        if (typeof window.zE === 'function') {
          return;
        }

        const existingScript = document.querySelector('script[src*="static.zdassets.com/ekr/snippet.js"]');
        if (zendeskRequested || existingScript) {
          zendeskRequested = true;
          return;
        }

        zendeskRequested = true;
        const script = document.createElement('script');
        script.id = 'ze-snippet';
        script.src = zendeskSrc;
        script.async = true;
        document.body.appendChild(script);
      }

      function waitForZendesk(callback, retries) {
        if (typeof window.zE === 'function') {
          callback();
          return;
        }

        if ((retries || 0) >= 40) {
          return;
        }

        window.setTimeout(function () {
          waitForZendesk(callback, (retries || 0) + 1);
        }, 250);
      }

      function withZendesk(callback, retries) {
        if (typeof window.zE === 'function') {
          callback();
          return;
        }

        loadZendesk();

        if ((retries || 0) >= 40) {
          return;
        }

        window.setTimeout(function () {
          withZendesk(callback, (retries || 0) + 1);
        }, 250);
      }

      {% comment %} // on page load always close widget {% endcomment %}
      window.addEventListener(
        'load',
        function () {
          waitForZendesk(function () {
            window.zE('messenger', 'close');
          });
        },
        { once: true }
      );

      if (conversationBadge) {
        conversationBadge.addEventListener('pointerenter', loadZendesk, { once: true });
        conversationBadge.addEventListener('click', function () {
          withZendesk(function () {
            window.zE('messenger', 'open');
          });
        });
      }
    })();
  </script>
  {% comment %} <!-- 监听到鼠标滚动事件被禁止后, 将事件打开 --> {% endcomment %}
  <script>
    (function ($) {
      window.addEventListener(
        'wheel',
        function (e) {
          $('html, body').css('overflow', '');
          e.stopImmediatePropagation && e.stopImmediatePropagation();
        },
        true
      );
    })(jQuery);
  </script>
</html>
