{% comment %}
  accessory product list
  and
  New Arrival product list
{% endcomment %}
<style>
  .all_edition_list_collection{
      display: flex;
      gap: 30px;
      flex-wrap: wrap;
      height: 100%;
      max-width: 100%;
      max-height: 430px;
      overflow-y: scroll;
      height: fit-content;
      width: 100%;
  }

  .all_edition_list_collection::-webkit-scrollbar{
      width: 8px;
      height: 8px;
  }

  .all_edition_list_collection::-webkit-scrollbar-track{
      background: #f1f1f1;
      border-radius: 4px;
  }

  .all_edition_list_collection::-webkit-scrollbar-thumb{
      background: #888;
      border-radius: 4px;
  }

  .all_edition_list_collection::-webkit-scrollbar-thumb:hover{
      background: #555;
  }

  .all_edition_list_collection .product_item{
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
      width: calc((100% - 60px) / 3);
      position: relative;
  }
  .all_edition_list_collection .product_item .product_main_image{
      width: 160px;
      height: 160px;
      display: flex;
      align-items: center;
  }
  .all_edition_list_collection .product_item .product_main_image img{
      height: 100%;
      object-fit: contain;
  }
  .all_edition_list_collection .product_item .product_title{
      font: 500 16px var(--font-family-1);
      color: #333333;
      line-height: 1.4;
      max-width: 84%;
      text-align: center;
      flex: 1;
  }
  .all_edition_list_collection .product_item .product_btns{
      font: 400 16px var(--font-family-1);
      color: #76767F;
      margin-top: 14px;
      text-decoration: underline;
      text-underline-offset: 3px;
      display: flex;
      gap: 10px;
  }
  .all_edition_list_collection .product_item .learn_more_btn:hover,
  .all_edition_list_collection .product_item .buy_now_btn:hover{
      color: #262629;
  }
  .all_edition_list_collection .product_item .prod_item_tag{
      font: 500 14px var(--font-family-1);
      color: #fff;
      padding: 5px 7px;
      background-color: #DE2E39;
      border-radius: 2px;
      position: absolute;
      right: 0;
      top: 0;
  }

  /* small screen */
  @media(min-width: 1026px) and (max-width: 1600px){
      {% comment %} .all_edition_list_collection{
          max-height: 450px;
      } {% endcomment %}
      .all_edition_list_collection .product_item .product_main_image{
          width: 140px;
          height: 140px;
      }
      .all_edition_list_collection .product_item .product_title{
          font-size: 14px;
          max-width: 100%;
      }
      .all_edition_list_collection .product_item .prod_item_tag{
          font-size: 12px;
          padding: 4px;
      }
  }
</style>

<div class="all_edition_list_collection">
  {% for product in product_list %}
    {% for variant in product.variants %}
      {% if variant.available and variant.title contains 'Edition' %}
        <div class="product_item">
          <a {% if product.url != blank %} href="{{ product.url }}?variant={{ variant.id }}" {% else %} aria-disabled="true" {% endif %} class="product_main_image image-zoom">
            <img
              src="{{ variant.featured_image | image_url: width: 160 }}"
              srcset="{{ variant.featured_image | image_url: width: 160 }}"
              height="{{ variant.featured_image.height }}"
              width="{{ variant.featured_image.width }}"
              alt="{{ variant.featured_image.alt }}"
              loading="lazy"
            >
          </a>
          <div class="product_title">
            {{ variant.option2 }}
            {% comment %}
              {{ product.title | remove: 'Athena Pro' }}
              {% if variant.option2 != blank and variant.option2 != 'Large' %}
                - {{ variant.option2 }}
              {% endif %}
            {% endcomment %}
          </div>
          <div class="product_btns">
            {% if variant.metafields.custom.editionchairdtl.value.url %}
              <a {% if variant.metafields.custom.editionchairdtl.value.url %} href="{{ variant.metafields.custom.editionchairdtl.value.url }}" {% else %} aria-disabled="true" {% endif %} class="learn_more_btn">
                {{ 'general.common.menu_learn_more' | t }}
              </a>
            {% endif %}

            <a {% if product.url != blank %} href="{{ product.url }}?variant={{ variant.id }}" {% else %} aria-disabled="true" {% endif %} class="buy_now_btn">
              {{ 'general.common.menu_buy_btn' | t }}
            </a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% endfor %}
</div>
