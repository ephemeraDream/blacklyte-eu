                            </svg>
                            <div class="parameter_comparison_data_value_tips_context">{{ value.tips }}</div>
                          </div>
                        {% endif %}
                      </div>
                    {% endfor %}
                  </div>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
  <div class="parameter_comparison_contain pmd_show">
    <div class="parameter_comparison_contain_line parameter_comparison_contain_line_sticky_pmd">
      <div class="parameter_comparison_contain_line_item">
        <select class="parameter_comparison_select productSelectOne">
          {% for item in compare_products %}
            <option value="{{ item.metafields.custom.series_name.value }}">
              {{- item.metafields.custom.series_name.value }}
            </option>
          {% endfor %}
        </select>
      </div>
      <div class="parameter_comparison_contain_line_item">
        <select class="parameter_comparison_select productSelectTwo">
          {% for item in compare_products %}
            <option
              value="{{ item.metafields.custom.series_name.value }}"
              {% if forloop.index0 == 1 %}
                selected
              {% endif %}
            >
              {{- item.metafields.custom.series_name.value }}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>
