<script>
  (() => {
    const section = document.querySelector('.desk_parameter_comparison_{{ section.id }}');
    if (!section) return;

    if (section.dataset.inited === 'true') return;
    section.dataset.inited = 'true';

    const selectOne = section.querySelector('.productSelectOne');
    const selectTwo = section.querySelector('.productSelectTwo');
    const closeAllBtns = section.querySelectorAll('.parameter_comparison_contain_switch[data-type="close_all"]');
    const showDiffBtns = section.querySelectorAll('.parameter_comparison_contain_switch[data-type="show_diff"]');

    const isMobile = window.innerWidth < 768;

    // ---------- 工具函数 ----------
    function updateDisabledOptions() {
      const v1 = selectOne.value;
      const v2 = selectTwo.value;
      [...selectOne.options, ...selectTwo.options].forEach((opt) => (opt.disabled = false));
      [...selectOne.options].forEach((opt) => (opt.disabled = opt.value === v2));
      [...selectTwo.options].forEach((opt) => (opt.disabled = opt.value === v1));
    }

    function updateComparisonOrder() {
      const selectedValues = [selectOne.value, selectTwo.value];
      section.querySelectorAll('.parameter_comparison_contain_line.need_change').forEach((line) => {
        const items = Array.from(line.querySelectorAll('.parameter_comparison_contain_line_item'));
        items.forEach((i) => i.classList.add('hidden'));
        selectedValues
          .map((v) => items.find((i) => i.dataset.type === v))
          .filter(Boolean)
          .forEach((i, index) => {
            i.classList.remove('hidden');
            i.classList.remove('spec_tips');
            if (index === 1) i.classList.add('spec_tips');
            line.appendChild(i);
          });
      });
    }

    function refreshShowDiff() {
      const showDiffActive = [...showDiffBtns].some((btn) => btn.hasAttribute('active'));
      const selectedValues = [selectOne.value, selectTwo.value];

      const allLinesPC = section.querySelectorAll(
        '.parameter_comparison_contain.pc_show .parameter_comparison_accordion .parameter_comparison_contain_line'
      );
      const allLinesPMD = section.querySelectorAll(
        '.parameter_comparison_contain.pmd_show .parameter_comparison_accordion .parameter_comparison_contain_line'
      );

      if (showDiffActive) {
        // PC端
        allLinesPC.forEach((line) => {
          const items = [...line.querySelectorAll('.parameter_comparison_contain_line_item')].slice(1);
          const values = items.map((i) => i.innerHTML.trim());
          console.log(values, 'values');
          const allSame = values.length > 0 && values.every((v) => v === values[0]);
          line.classList.toggle('hidden', allSame);
        });

        // 移动端
        allLinesPMD.forEach((line) => {
          const items = selectedValues
            .map((val) => line.querySelector(`.parameter_comparison_contain_line_item[data-type="${val}"]`))
            .filter(Boolean);
          const values = items.map((i) => i.innerHTML.trim());
          const allSame = values.length === 2 && values.every((v) => v === values[0]);
          line.closest('.parameter_comparison_contain_line_box')?.classList.toggle('hidden', allSame);
        });
      } else {
        allLinesPC.forEach((line) => line.classList.remove('hidden'));
        allLinesPMD.forEach((line) =>
          line.closest('.parameter_comparison_contain_line_box')?.classList.remove('hidden')
        );
      }
    }

    function toggleAllAccordions(open) {
      section.querySelectorAll('.parameter_comparison_accordion').forEach((acc) => acc.toggleAttribute('open', open));
      closeAllBtns.forEach((btn) => btn.toggleAttribute('active', !open));
    }

    // ---------- select事件 ----------
    function handleSelectChange() {
      updateDisabledOptions();
      updateComparisonOrder();
      refreshShowDiff();
    }

    selectOne.addEventListener('change', handleSelectChange);
    selectTwo.addEventListener('change', handleSelectChange);
    updateDisabledOptions();
    updateComparisonOrder();

    // ---------- 折叠控制（带PC/PMD同步） ----------
    section.querySelectorAll('.parameter_comparison_accordion_head').forEach((head) => {
      head.addEventListener('click', () => {
        const accordion = head.closest('.parameter_comparison_accordion');
        const contain = head.closest('.parameter_comparison_contain');
        const isPC = contain.classList.contains('pc_show');
        const isOpen = accordion.toggleAttribute('open');

        // 同步另一端 accordion
        const titleText = head.textContent.trim();
        const targetContain = section.querySelector(`.parameter_comparison_contain.${isPC ? 'pmd_show' : 'pc_show'}`);
        const matchAccordion = [...targetContain.querySelectorAll('.parameter_comparison_accordion_head')].find(
          (h) => h.textContent.trim() === titleText
        );
        if (matchAccordion) {
          const targetAcc = matchAccordion.closest('.parameter_comparison_accordion');
          targetAcc.toggleAttribute('open', isOpen);
        }

        // 判断全部关闭状态
        const allClosed = ![...contain.querySelectorAll('.parameter_comparison_accordion')].some((acc) =>
          acc.hasAttribute('open')
        );
        closeAllBtns.forEach((btn) => btn.toggleAttribute('active', allClosed));
      });
    });

    // ---------- 按钮控制 ----------
    section.querySelectorAll('.parameter_comparison_contain_switch').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.type;
        const isActive = btn.toggleAttribute('active');

        if (type === 'close_all') {
          toggleAllAccordions(!isActive);
        }

        if (type === 'show_diff') {
          showDiffBtns.forEach((b) => b.toggleAttribute('active', isActive));
          refreshShowDiff();
        }
      });
    });

    // ---------- 移动端tips ----------
    if (isMobile) {
      const tips = section.querySelectorAll('.parameter_comparison_data_value_tips');
      tips.forEach((tip) => {
        tip.addEventListener('click', (e) => {
          e.stopPropagation();
          tips.forEach((other) => {
            if (other !== tip) other.removeAttribute('open');
          });
          tip.toggleAttribute('open');
        });
      });

      document.addEventListener('click', () => {
        tips.forEach((tip) => tip.removeAttribute('open'));
      });

      const header = document.querySelector('.section-header-mobile');
      const target = section.querySelector('.parameter_comparison_contain_line_sticky_pmd');

      if (header && target) {
        const observer = new MutationObserver((mutationsList) => {
          for (let mutation of mutationsList) {
            if (mutation.attributeName === 'class') {
              const hasHidden = header.classList.contains('shopify-section-header-hidden');

              if (!hasHidden) {
                target.classList.add('is-sticky-top');
              } else {
                target.classList.remove('is-sticky-top');
              }
            }
          }
        });

        observer.observe(header, { attributes: true });
      }
    }
  })();
</script>
