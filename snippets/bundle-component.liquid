<!-- bundle -->
<div class="bundle-prod-lists {% if block.settings.bundleModuleClass != blank %}{{ block.settings.bundleModuleClass }}{% endif %}{% if block.settings.bundleTitle == blank or block.settings.bundleDescripe == blank %} bundle-prod-lists-cont{% endif %}">
  <div class="bundle-prod-items bundle-cont-link" data-href="{{ block.settings.bundleItemLink }}">
    <div class="bundle-prod-items-cont-left">
      <div class="bundle-prod-item-left">
        <div class="image-bundle image-zoom">
          <img src="{{ block.settings.bundleItemChair | img_url:'master' }}" width="100%" height="100%">
        </div>
        <div class="bundle-item-title">{{ block.settings.bundleItemTitle }}</div>
      </div>
      <div class="bundle-middle-icon">
        <svg width="54" height="54" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="54" height="54" rx="27" fill="#7FBF1F"/>
          <path d="M17 27H37" stroke="white" stroke-opacity="0.99" stroke-width="3"/>
          <path d="M27 17L27 37" stroke="white" stroke-opacity="0.99" stroke-width="3"/>
        </svg>
          
      </div>

      <div class="bundle-prod-item-center">
        <div class="image-bundle image-zoom">
          <img src="{{ block.settings.bundleItemDesk | img_url:'master' }}" width="100%" height="100%">
        </div>
        <div class="bundle-item-title">{{ block.settings.bundleItemDeskTitle }}</div>
      </div>
    </div>
    
    <div class="bundle-prod-item-right">
      <div class="bundle-prod-item-right-cont">
        <div class="bundle-item-sale-price">{{ block.settings.bundleItemSalePrice }}</div>
        <div class="bundle-item-discount-price">{{ block.settings.bundleItemDiscountPrice }}</div>
      </div>
      <div class="bundle-item-shopnow-btn bundle-cont-link" data-href="{{ block.settings.bundleItemLink }}">{{ 'products.product.shop_now' | t }}</div>
    </div>
    <!-- save -->
    <div class="bundle-item-save-tag">
      <span>{{ block.settings.bundleSaveTagPrices }}</span>
      <span>OFF</span>
    </div>
  </div>
</div>
