{% assign mobile_widths_default = '750,850,950,1050,1150' %}
{% assign widths_default = '800,1100,1500,2000,2800' %}
{% assign widths_sizes_default = '100vw' %}
{% assign mobile_dpr_default = 3 %}
{% assign mobile_widths_init = mobile_widths | default: mobile_widths_default | split: ',' %}
{% assign widths_init = widths | default: widths_default | split: ',' %}
{% assign mobile_dpr_init = mobile_dpr | default: mobile_dpr_default %}
{% assign widths_sizes_init = widths_sizes | default: widths_sizes_default %}
{% assign loading_init = loading | default: 'lazy' %}
{% assign image_mobile = image_mobile | default: image %}
<picture>
  <source
    media="(max-width: 767px)"
    srcset="
      {% for w in mobile_widths_init %}
        {% assign w_num = w | plus: 0 %}
        {% if w_num <= image_mobile.width %}
         {% assign w_num_half = w_num | divided_by: mobile_dpr_init  %}
          {{ image_mobile | image_url: width: w_num_half }} {{ w_num }}w{% unless forloop.last %}, {% endunless %}
        {% endif %}
      {% endfor %}
    "
    sizes="100vw"
  >
  <source
    media="(min-width: 768px)"
    srcset="
      {% for w in widths_init %}
        {% assign w_num = w | plus: 0 %}
        {% if w_num <= image.width %}
          {{ image | image_url: width: w_num }} {{ w_num }}w{% unless forloop.last %}, {% endunless %}
        {% endif %}
      {% endfor %}
    "
    sizes="{{ widths_sizes_init }}"
  >
  <img
    {% if loading_init != 'lazy' %}
      fetchpriority="high"
    {% endif %}
    loading="{{ loading_init }}"
    src="{{ image | image_url }}"
    alt="{{ image.alt | escape }}"
    width="100%"
    height="100%"
    class="{{ class_str }}"
  >
</picture>
