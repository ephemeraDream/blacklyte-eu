<style>
  @media(max-width: 1024px) {
    .chairs-mobile-cont{
        height: 100vh;
        width: 100%;
        max-height: 100vh;
        max-width: 100%;
        overflow: hidden;
        transition: .5s;
        position: absolute;
        top: 0;
        left: 100vw;
        opacity: 0;
        background-color: #fff;
        z-index: 999;
    }
    .chairs-mobile-cont .cont-chairs-box{
      max-height: calc(100vh - 180px);
      overflow-y: scroll;
      padding-bottom: 30px;
    }
    .chairs-mobile-cont.chairs-mobile-cont-active{
      left: 0;
      opacity: 1;
    }
    .chairs-mobile-cont .title{
      padding: 26px 20px;
      border-bottom: 1px solid #F1F1F1;
      position: relative;
      cursor: pointer;
    }
    .chairs-mobile-cont .title .icons svg{
      width: 18px;
      height: 18px;
      fill: none;
      stroke: none;
    }
    .chairs-mobile-cont .title .header-title-text{
      font: 500 16px var(--font-family-1);
      color: #262629;
      vertical-align: middle;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
    .chairs-mobile-cont .cont-chairs{
      display: flex;
      gap: 18px;
      padding: 26px 20px;
      flex-direction: column;
    }
    .chairs-mobile-cont .cont-chairs .cont-chair-items{
      display: flex;
      align-items: center;
      padding: 20px;
      border: 1px solid #F1F1F1;
    }
    .chairs-mobile-cont .cont-chairs .cont-chair-items .item-left{
      width: 140px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .chairs-mobile-cont .cont-chairs .cont-chair-items .item-right{
      display: flex;
      flex-direction: column;
    }
    .chairs-mobile-cont .cont-chairs .cont-chair-items .item-right .right-title{
      font: 500 16px var(--font-family-1);
      color: #262629;
    }
    .chairs-mobile-cont .cont-chairs .cont-chair-items .item-right .right-desc{
      font: 400 10px var(--font-family-1);
      color: #262629;
      margin-top: 4px;
    }
    .chairs-mobile-cont .cont-chairs .cont-chair-items .item-right .right-btns{
      display: flex;
      gap: 20px;
      font: 400 12px var(--font-family-1);
      color: #76767F;
      text-decoration: underline;
      margin-top: 15px;
    }
    .chairs-mobile-cont .compare-btns{
      padding: 10px 35px;
      background-color: #F3F4F6;
      border: 1px solid #D2D2D2;
      border-radius: 2px;
      max-width: max-content;
      margin: 30px auto 0;
      display: flex;
      gap: 7px;
      align-items: center;
      cursor: pointer;
    }
    .chairs-mobile-cont .compare-btns .compare-icon svg{
      width: 18px;
      height: 21px;
      fill: none;
      stroke: none;
    }
    .chairs-mobile-cont .all-chairs-line {
      display: flex;
      justify-content: space-between;
      padding: 0 20px;
      margin-top: 20px;
    }
    .chairs-mobile-cont .all-chairs-line .all-chairs-line-left {
      font: 500 16px var(--font-family-1);
      color: #262629;
      vertical-align: middle;
    }
  }
  
</style>

<div class="chairs-mobile-cont">
  <div class="title">
    <span class="icons">
      <svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11 19L2 10L11 1" stroke="#262629" stroke-width="1.6"/>
      </svg>
    </span>
    <span class="header-title-text">CHAIRS</span>
  </div>
  <div class="cont-chairs-box">
    <div class="all-chairs-line" data-url="{{ section.settings.ChairsMenuALLLINK }}">
      <span class="all-chairs-line-left">{{ section.settings.ChairsMenuTitle }}</span>
      <div class="all-chairs-line-right">
        <span class="texts">{{ section.settings.ChairsMenuALLText }}</span>
        <span class="icon">
          <svg width="8" height="13" viewBox="0 0 8 13" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1.28906 12L6.57813 6.71094L1.28906 1.42187" stroke="#262629" stroke-width="1.6"/>
          </svg>
        </span>
      </div>
    </div>
    <div class="cont-chairs">
      {% for block in section.blocks %}
        {% if block.type == 'chairsItemMobile' %}
          <div class="cont-chair-items" data-url="{{ block.settings.chairBTN2LINK }}">
            <div class="item-left">
              <img src="{{ block.settings.chairMainImageMobile | img_url: "master" }}" loading="lazy">
            </div>
            <div class="item-right">
              <div class="right-title">{{ block.settings.chairTitleMobile }}</div>
              <div class="right-desc">{{ block.settings.chairDescMobile }}</div>
              <div class="right-btns">
                <span class="right-btns-click" data-href="{{ block.settings.chairBTN1LINK }}">
                  {{- block.settings.chairBTN1 -}}
                </span>
                <span class="right-btns-click" data-href="{{ block.settings.chairBTN2LINK }}">
                  {{- block.settings.chairBTN2 -}}
                </span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="compare-btns show_chair_compare_modal">
      <span class="compare-icon">
        <svg width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 4L1 4.00511V17L11 16.9949" stroke="#262629" stroke-width="1.4"/>
          <path d="M11 4H19V17H11" stroke="#262629" stroke-width="1.4" stroke-dasharray="2 2"/>
          <path d="M11 0L11 21" stroke="#262629" stroke-width="1.4"/>
        </svg>
      </span>
      <span class="compare-text">Compare Chairs</span>
    </div>
  </div>
</div>

<script>
  {% comment %} /* chairs */ {% endcomment %}
  $('.chairs-mobile-cont .title .icons').on('click', function(){
      $('.chairs-mobile-cont').removeClass('chairs-mobile-cont-active')
      $('body').removeClass('menu_open_mb')
  })

  $('.chairs-mobile-cont .cont-chairs .cont-chair-items').on('click', function(e){
    const lns = $(this).data('url')
    if(lns){
      window.location.href = lns
    }
  })

  $('.chairs-mobile-cont .cont-chairs .cont-chair-items .item-right .right-btns')
    .on('click', '.right-btns-click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      const link = $(this).data('href');
      if (link) {
        window.location.assign(link);
      }
    });

  $('.chairs-mobile-cont .all-chairs-line').on('click', function(){
    const links = $(this).data('url')
    if(links){
      window.location.href = links
    }
  
  })
</script>
