<style>
  @media(max-width: 1024px) {
    .newarrival-mobile-cont{
        height: 100vh;
        width: 100%;
        max-height: 100vh;
        max-width: 100%;
        overflow: hidden;
        transition: .5s;
        position: absolute;
        top: 0;
        left: 100vw;
        opacity: 0;
        background-color: #fff;
        z-index: 999;
    }
    .newarrival-mobile-cont.newarrival-mobile-cont-active{
      left: 0;
      opacity: 1;
    }
    .newarrival-mobile-cont .title{
      padding: 26px 20px;
      border-bottom: 1px solid #F1F1F1;
      position: relative;
      cursor: pointer;
    }
    .newarrival-mobile-cont .title .icons svg{
      width: 18px;
      height: 18px;
      fill: none;
      stroke: none;
    }
    .newarrival-mobile-cont .title .header-title-text{
        font: 500 16px var(--font-family-1);
        color: #262629;
        vertical-align: middle;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
    }
    .newarrival-mobile-cont .newarrival-prods{
        display: flex;
        gap: 18px;
        padding: 26px 20px;
        flex-wrap: wrap;
        justify-content: flex-start;
        max-height: calc(100vh - 150px);
        overflow-y: scroll;
    }
    .newarrival-mobile-cont .newarrival-prods .cont-light-items{
        display: flex;
        gap: 10px;
        padding: 20px;
        flex-direction: column;
        width: calc((100% - 18px) / 2);
        justify-content: center;
        align-items: center;
    }
    .newarrival-mobile-cont .newarrival-prods .cont-light-items .item-left{
        width: 140px;
        height: 140px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .accessory-mobile-cont .accessory-prods .cont-light-items .item-right{
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .newarrival-mobile-cont .newarrival-prods .cont-light-items .item-right .right-title{
        font: 500 16px var(--font-family-1);
        color: #262629;
        text-align: center;
        flex: 1;
    }
    .newarrival-mobile-cont .newarrival-prods .cont-light-items .item-right .right-btns{
        text-align: center;
        margin-top: 4px;
    }
    .newarrival-mobile-cont .newarrival-prods .cont-light-items .item-right .right-btns span{
        font: 400 16px var(--font-family-1);
        color: #76767F;
        text-decoration: underline;
        margin-top: 15px;
        text-align: center;
    }
    .newarrival-mobile-cont .item-left img{
      object-fit: contain;
      width: 100%;
      height: 100%;
    }
  }
  
</style>

<div class="newarrival-mobile-cont">
  <div class="title">
    <span class="icons">
      <svg width="12" height="20" viewBox="0 0 12 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11 19L2 10L11 1" stroke="#262629" stroke-width="1.6"/>
      </svg>
    </span>
    <span class="header-title-text">{{ section.settings.newArrivalMenuTitle }}</span>
  </div>
  <div class="newarrival-prods">
    {% for product in section.settings.newArrivalProductList %}
      {% for prodVariant in product.variants %}
        {% if prodVariant.available and prodVariant.inventory_quantity > 0 and prodVariant.metafields.custom.isnewarrivalvisible.value == true %}
          <div class="cont-light-items" data-url="{{ product.url }}?variant={{ prodVariant.id }}">
            <div class="item-left">
              {% if prodVariant.featured_image %}
                <img src="{{ prodVariant.featured_image | image_url: width: 280 }}" loading="lazy">
              {% else %}
                <img src="{{ product.featured_image | image_url: width: 280 }}" loading="lazy">
              {% endif %}
            </div>
            <div class="item-right">
              <div class="right-title">{{ product.title }}</div>
              <div class="right-btns">
                <span>Buy</span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>
<script>
    $('.newarrival-mobile-cont .title .icons').on('click', function(){
        $('.newarrival-mobile-cont').removeClass('newarrival-mobile-cont-active')
        $('body').removeClass('menu_open_mb')
    })

    $('.newarrival-mobile-cont .newarrival-prods .cont-light-items').on('click', function(){
      const linksHref = $(this).data('url')
      if(linksHref){
        window.location.href = linksHref
      }
    })
</script>
