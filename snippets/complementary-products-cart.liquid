{% comment %}
  在购物车显示赠送的配件
{% endcomment %}
{%- liquid
  assign product = product
-%}
{% comment %}
  <style>
    .cart-complementary-products {
      width: calc(100% - (4vw + 25px));
      margin-left: calc(4vw + 25px);
      margin-bottom: 30px;
    }
    .cart-complementary-products .product-sku-attach-main {
      display: flex;
      align-items: center;
    }
    .cart-complementary-products .product-sku-attach-main:nth-of-type(1) {
      border-top: 1px solid #999;
    }
    .cart-complementary-products .product-sku-attach-main .item-left {
      width: 69px;
      height: 69px;
      margin-right: 20px;
      display: inline-flex;
      justify-content: center;
      align-items: center;
    }
    .cart-complementary-products .product-sku-attach-main .item-right {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex: 1;
    }
    .cart-complementary-products .product-sku-attach-main .item-right .item-container-right {
      white-space: nowrap;
    }
    .cart-complementary-products .product-sku-attach-main .item-right .item-title,
    .cart-complementary-products .product-sku-attach-main .item-right .item-price{
      font-family: "Poppins";
      font-size: 12px;
      line-height: 18px;
      font-weight: 400;
      color: #333333;
    }
    .cart-complementary-products .product-sku-attach-main .item-right .item-price {
      margin-left: 4px;
    }
    .cart-complementary-products .product-sku-attach-main .item-right .item-container-right .item-container-right-icons svg {
      fill: none;
      stroke: none;
      width: 35px;
      height: 35px;
      vertical-align: middle;
    }
    .cart-complementary-products .product-sku-attach-main .item-right .item-container-right .item-container-right-tags {
      font-family: "Poppins";
      font-size: 16px;
      font-weight: 500;
      color: #333333;
      vertical-align: middle;
    }
    @media(max-width: 767px) {
      .cart-complementary-products .product-sku-attach-main .item-left {
        width: 39px;
        height: 39px;
        margin-right: 8px;
      }
      .cart-complementary-products .product-sku-attach-main .item-right .item-container-right .item-container-right-icons svg {
        width: 20px;
        height: 20px;
      }
      .cart-complementary-products .product-sku-attach-main .item-right .item-container-right .item-container-right-tags {
        font-size: 12px;
      }
      .cart-complementary-products .product-sku-attach-main .item-right .item-container-right {
        padding-right: 0;
        white-space: nowrap;
      }
      .cart-complementary-products .product-sku-attach-main {
        padding-top: 20px;
      }
    }
    @media (min-width: 1025px) and (max-width: 1900px) {
      .cart-complementary-products .product-sku-attach-main .item-left {
        width: 50px;
        height: 50px;
        margin-right: 10px;
      }
    }
  </style>
{% endcomment %}

<!-- Product Attach -->
<div class="cart-complementary-products">
  {% if productVariant.option2 contains 'WUCHANG Edition' %}
    <div class="product-sku-attach-main oy-in">
      <div class="item-left">
        <img
          width=""
          height=""
          src="https://cdn.shopify.com/s/files/1/0663/6742/2695/files/Wuchang_Series_Gift_Box_cover.webp?v=1760664300"
          alt=""
        >
      </div>
      <div class="item-right">
        <span class="item-title">
          Wuchang Series Gift Box
          <span class="item-price"
            >worth({{ shop.money_format | split: '{{' | first -}}
            {{- 3900 | money_without_currency }})</span
          >
        </span>
        <span class="item-container-right">
          <span class="item-container-right-icons">
            <svg width="35" height="35" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10.2109 18.9583L14.5859 23.3333L24.7943 13.125" stroke="#333333" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="item-container-right-tags">INCLUDED</span>
        </span>
      </div>
    </div>
  {% endif %}
  {% comment %} {% if product.title contains 'Athena Pro Fnatic Edition' %}
    <div class="product-sku-attach-main oy-in">
      <div class="item-left">
        <img
          width=""
          height=""
          src="https://cdn.shopify.com/s/files/1/0663/6742/2695/files/Fnatic_LED_Sign.webp?v=1768801691"
          alt=""
          style="border-radius: 10px;"
        >
      </div>
      <div class="item-right">
        <span class="item-title">
          Fnatic LED Sign
          <span class="item-price"
            >worth({{ shop.money_format | split: '{{' | first -}}
            {{- 3590 | money_without_currency }})</span
          >
        </span>
        <span class="item-container-right">
          <span class="item-container-right-icons">
            <svg width="35" height="35" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10.2109 18.9583L14.5859 23.3333L24.7943 13.125" stroke="#333333" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="item-container-right-tags">INCLUDED</span>
        </span>
      </div>
    </div>
  {% endif %} {% endcomment %}
  {% for item in product.metafields.custom.product_attach.value %}
    {% for variant in item.variants %}
      {% if product.id == 8337380999417 or product.id == 8921908084985 or product.id == 9034692755705 %}
        {% if productVariant.option2 == variant.option2 %}
          <div class="product-sku-attach-main oy-in" data-color="{{ variant.option2 }}">
            <div class="item-left">
              <img width="" height="" src="{{ variant.featured_image | image_url  }}" alt="">
            </div>
            <div class="item-right">
              <span class="item-title">
                {{ item.title }}
                <span class="item-price"
                  >worth({{ shop.money_format | split: '{{' | first -}}
                  {{- item.price | money_without_currency }})</span
                >
              </span>
              <span class="item-container-right">
                <span class="item-container-right-icons">
                  <svg width="35" height="35" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.2109 18.9583L14.5859 23.3333L24.7943 13.125" stroke="#333333" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="item-container-right-tags">INCLUDED</span>
              </span>
            </div>
          </div>
        {% endif %}
      {% elsif product.id == 9008215982329 or product.id == 8507519664377 %}
        {% if item.id == 8507512520953 and 'Black,Schwarz,Negro,Nero,Noir' contains variant.option2 %}
          <div class="product-sku-attach-main oy-in" data-color="{{ variant.option2 }}">
            <div class="item-left">
              <img width="" height="" src="{{ variant.featured_image | image_url  }}" alt="">
            </div>
            <div class="item-right">
              <span class="item-title">
                {{ item.title }}
                <span class="item-price"
                  >worth({{ shop.money_format | split: '{{' | first -}}
                  {{- item.price | money_without_currency }})</span
                >
              </span>
              <span class="item-container-right">
                <span class="item-container-right-icons">
                  <svg width="35" height="35" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.2109 18.9583L14.5859 23.3333L24.7943 13.125" stroke="#333333" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="item-container-right-tags">INCLUDED</span>
              </span>
            </div>
          </div>
        {% elsif item.id != 8507512520953 %}
          <div class="product-sku-attach-main oy-in" data-color="{{ variant.option2 }}">
            <div class="item-left">
              <img
                width=""
                height=""
                src="{{ variant.featured_image | default: item.featured_image | image_url  }}"
                alt=""
              >
            </div>
            <div class="item-right">
              <span class="item-title">
                {{ item.title }}
                <span class="item-price"
                  >worth({{ shop.money_format | split: '{{' | first -}}
                  {{- item.price | money_without_currency }})</span
                >
              </span>
              <span class="item-container-right">
                <span class="item-container-right-icons">
                  <svg width="35" height="35" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10.2109 18.9583L14.5859 23.3333L24.7943 13.125" stroke="#333333" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="item-container-right-tags">INCLUDED</span>
              </span>
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="product-sku-attach-main oy-in" data-color="{{ variant.option2 }}">
          <div class="item-left">
            <img
              width=""
              height=""
              src="{{ variant.featured_image | default: item.featured_image | image_url  }}"
              alt=""
            >
          </div>
          <div class="item-right">
            <span class="item-title">
              {{ item.title }}
              <span class="item-price"
                >worth({{ shop.money_format | split: '{{' | first -}}
                {{- item.price | money_without_currency }})</span
              >
            </span>
            <span class="item-container-right">
              <span class="item-container-right-icons">
                <svg width="35" height="35" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10.2109 18.9583L14.5859 23.3333L24.7943 13.125" stroke="#333333" stroke-width="2" stroke-linecap="square" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="item-container-right-tags">INCLUDED</span>
            </span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  {% endfor %}
</div>
