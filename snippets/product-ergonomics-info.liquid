        <path d="M10.6599 67.609C8.69279 67.328 4.7583 66.7655 3.07225 68.4531C1.33512 70.192 0.121601 73.5109 1.80769 80.2553C3.49378 86.9996 6.02315 88.2642 12.346 86.1566" stroke="#18181B" stroke-width="2"/>
