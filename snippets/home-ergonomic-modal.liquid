{% comment %}
  3.0修改版首页弹窗
{% endcomment %}
<style>
  .prod-erginomic-modal{
    width: 800px;
    margin: 0 auto;
    border-radius: 20px;
    background-color: #ffffff;
    transform: translate(0, -6%);
    opacity: 0;
    display: none;
    transition: all .5s ease;
  }
  body.home-ergonomic-modal-show{
    overflow: hidden;
    padding-inline-end: 0;
  }
  body.home-ergonomic-modal-show .home-background-overlay-ergonomic{
    position: fixed;
    width: 100%;
    height: 100%;
    background: #0009;
    top: 0;
    left: 0;
    z-index: 10000;
  }
  body.home-ergonomic-modal-show .prod-erginomic-modal{
    transition: all .5s ease;
    opacity: 1;
    display: block;
    visibility: visible;
    pointer-events: auto;
    transform: translate(0, 6%);
    animation: slowShow .55s ease-in forwards;
  }
  .prod-erginomic-modal .prod-modal-title{
    display: flex;
    justify-content: space-between;
    background-color: #F8F9FC;
    padding: 27px 42px;
    border-radius: 20px 20px 0 0;
    font: 500 26px "Roboto";
    color: #262629;
  }
  .prod-erginomic-modal .prod-modal-title .close-icon svg{
    width: 18px;
    height: 18px;
    fill: none;
    stroke: none;
    cursor: pointer;
  }
  .prod-erginomic-modal .prod-modal-cont {
    padding: 48px 42px 84px;
    max-height: 84vh;
    overflow-y: scroll;
    transition: all .15s linear;
  }
  .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-desc{
    font: 400 16px var(--font-family-1);
    line-height: 1.4;
    color: #76767F;
  }
  .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists{
    display: flex;
    gap: 20px;
    margin-top: 40px;
    flex-direction: column;
  }
  .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items{
    border: 1px solid #E6E6E6;
    background-color: #F5F5F5;
    padding: 28px 30px 28px 18px;
    border-radius: 2px;
    display: flex;
    gap: 15px;
  }
  .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-image{
    width: 90px;
  }
  .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-cont{
    flex: 1;
    display: flex;
    gap: 10px;
    flex-direction: column;
  }
  .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-cont .items-title{
    font: 500 16px var(--font-family-1);
    color: #262629;
  }
  .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-cont .items-descripe{
    font: 400 16px var(--font-family-1);
    color: #76767F;
  }
  .prod-erginomic-modal .prod-modal-cont .buttons{
    font: 500 16px var(--font-family-1);
    color: #429BFF;
    display: flex;
    gap: 10px;
    margin-top: 23px;
    cursor: pointer;
  }
  .prod-erginomic-modal .prod-modal-cont .buttons svg{
    width: 30px;
    height: 10px;
  }
  
  
  /* IPhone */
  @media(max-width: 767px) {
    .prod-erginomic-modal{
      width: 90%;
    }
    .prod-erginomic-modal .prod-modal-title{
      font-size: 20px;
      padding: 20px 24px;
    }
    .prod-erginomic-modal .prod-modal-cont{
      padding: 30px 24px 30px 24px;
      max-height: 72vh;
    }
    .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-desc{
        font-size: 12px;
    }
    .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists{
        gap: 10px;
        margin-top: 20px;
    }
    .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items{
        padding: 10px;
        gap: 8px;
        align-items: center;
    }
    .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-image{
        width: 45px;
    }
    .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-cont{
        gap: 4px;
    }
    .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-cont .items-title{
        font-size: 12px;
    }
    .prod-erginomic-modal .prod-modal-cont .prod-modal-cont-lists .prod-modal-list-items .items-cont .items-descripe{
        font-size: 10px;
    }
    .prod-erginomic-modal .prod-modal-cont .buttons{
        font-size: 12px;
        gap: 4px;
        margin-top: 14px;
    }
  }
  /* IPad */
  @media(min-width: 768px) and (max-width: 1024px) { }
  /* small screen */
  @media(min-width: 1025px) and (max-width: 1900px) { }
  /* large screen */
  @media(min-width: 2000px) {
    .prod-erginomic-modal{
      width: 1000px;
    }
    .prod-erginomic-modal .prod-modal-cont .pro-modal-cont-fi .content{
      font-size: 2rem;
    }
  }
  
</style>
<section class="home-background-overlay-ergonomic">
  <div class="prod-erginomic-modal">
    <div class="prod-modal-title">
      <span>{{ block.settings.modalItemsTitle }}</span>
      <span class="close-icon">
        <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.00293 2L19.3156 19.3126" stroke="#76767F" stroke-width="3"/>
          <path d="M19.3125 2L1.99986 19.3126" stroke="#76767F" stroke-width="3"/>
        </svg>
      </span>
    </div>
    <div class="prod-modal-cont">
        <div class="prod-modal-cont-desc">
            {{ block.settings.modalItemsDesc }}
        </div>
        <div class="prod-modal-cont-lists">
            <div class="prod-modal-list-items">
                <div class="items-image">
                    <img src="{{ block.settings.modalItemImage | img_url: 'master' }}" />
                </div>
                <div class="items-cont">
                    <div class="items-title">{{ block.settings.modalItemTitle }}</div>
                    <div class="items-descripe">{{ block.settings.modalItemDesc }}</div>
                </div>
            </div>
            <div class="prod-modal-list-items">
                <div class="items-image">
                    <img src="{{ block.settings.modalItemImage2 | img_url: 'master' }}" />
                </div>
                <div class="items-cont">
                    <div class="items-title">{{ block.settings.modalItemTitle2 }}</div>
                    <div class="items-descripe">{{ block.settings.modalItemDesc2 }}</div>
                </div>
            </div>
            <div class="prod-modal-list-items">
                <div class="items-image">
                    <img src="{{ block.settings.modalItemImage3 | img_url: 'master' }}" />
                </div>
                <div class="items-cont">
                    <div class="items-title">{{ block.settings.modalItemTitle3 }}</div>
                    <div class="items-descripe">{{ block.settings.modalItemDesc3 }}</div>
                </div>
            </div>
            <div class="prod-modal-list-items">
                <div class="items-image">
                    <img src="{{ block.settings.modalItemImage4 | img_url: 'master' }}" />
                </div>
                <div class="items-cont">
                    <div class="items-title">{{ block.settings.modalItemTitle4 }}</div>
                    <div class="items-descripe">{{ block.settings.modalItemDesc4 }}</div>
                </div>
            </div>
        </div>
        {% if block.settings.modalItemButtons != blank %}
          <a {% if block.settings.modalItemLINK != blank %} href="{{ block.settings.modalItemLINK }}" {% else %} aria-disabled="true" {% endif %} class="buttons">
              <span>{{ block.settings.modalItemButtons }}</span>
              <span class="icons">
                  <svg width="40" height="16" viewBox="0 0 40 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M39.7071 8.70711C40.0976 8.31658 40.0976 7.68342 39.7071 7.29289L33.3431 0.928932C32.9526 0.538408 32.3195 0.538408 31.9289 0.928932C31.5384 1.31946 31.5384 1.95262 31.9289 2.34315L37.5858 8L31.9289 13.6569C31.5384 14.0474 31.5384 14.6805 31.9289 15.0711C32.3195 15.4616 32.9526 15.4616 33.3431 15.0711L39.7071 8.70711ZM0 8V9H39V8V7H0V8Z" fill="#429BFF"/>
                  </svg>
              </span>
          </a>
        {% endif %}
    </div>
  </div>
</section>
