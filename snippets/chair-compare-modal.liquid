<style>
  .chair_compare_modal {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 105;
    background-color: #00000080;
    display: none;
    padding: 5vh 0;
  }

  .chair_compare_modal .chair_compare_modal_contain {
    min-width: 810px;
    height: 90vh;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    background-color: #fff;
    border-radius: 10px;
    max-width: 1140px;
    width: 95vw;
  }

  .chair_compare_modal .chair_compare_modal_head {
    height: 5.15625vw;
    background-color: #f9fafb;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 36px;
    font-weight: 500;
    font-size: 30px;
    letter-spacing: 0%;
    vertical-align: middle;
    text-transform: uppercase;
    color: #262626;
    border-radius: 10px 10px 0 0;
  }

  .chair_compare_modal .chair_compare_modal_head svg {
    cursor: pointer;
    width: 26px;
    height: 26px;
  }

  .chair_compare_modal .chair_compare_modal_body {
    {% comment %} padding: 2.78vh 42px 5.7703vh; {% endcomment %}
    overflow: auto;
    height: calc(100% - 5.15625vw);
  }

  .chair_compare_modal .parameter_comparison {
    background:#FFF;
    padding: 2.78vh 42px 5.7703vh;
  }

  .chair_compare_modal .parameter_comparison .parameter_comparison_contain_line_sticky {
    position: sticky;
    background-color: #fff;
    top: 0;
    z-index: 1;
  }

  .chair_compare_modal .parameter_comparison_contain_line_item:last-child .parameter_comparison_data_value_tips_context {
    left: -5vw;
  }

  .chair_compare_modal .parameter_comparison_contain_line_item:last-child .parameter_comparison_data_value_tips_context::before {
    left: 88.5%;
  } 

  @media only screen and (max-width: 768px) {
    .chair_compare_modal .chair_compare_modal_contain {
      width: 89.33vw;
      min-width: auto;
    }

    .chair_compare_modal .chair_compare_modal_head {
      padding: 0 5.33vw;
      font-size: 20px;
      height: 12.8vw;
    }

    .chair_compare_modal .chair_compare_modal_body {
        height: calc(100% - 12.8vw);
    }

    .chair_compare_modal .parameter_comparison {
      background:#FFF;
      padding: 5.33vw;
    }

    .chair_compare_modal .parameter_comparison .parameter_comparison_contain_line_sticky_pmd {
      position: sticky;
      background-color: #fff;
      top: -1px;
      z-index: 1;
    }
  }

  @media only screen and (min-width: 2000px) {
    .chair_compare_modal .chair_compare_modal_contain {
      max-width: 1920px;
    }
  }
</style>

<div class="chair_compare_modal">
  <div class="chair_compare_modal_contain">
    <div class="chair_compare_modal_head">
      <span></span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="37"
        height="37"
        viewBox="0 0 37 37"
        fill="none"
        id="close_chair_compare_modal"
      >
        <path d="M27.5762 9.19141L9.19139 27.5762" stroke="#262626" stroke-width="2"/>
        <path d="M9.19141 9.19336L27.5762 27.5781" stroke="#262626" stroke-width="2"/>
      </svg>
    </div>
    <div class="chair_compare_modal_body">
      {% render 'parameter-comparison',
        compare_modal_products: compare_modal_products,
        show_btns: true,
        show_select: true,
        show_img_data: true
      %}
    </div>
  </div>
</div>

<script>
  (() => {
    const compare_modal = document.querySelector('.chair_compare_modal');

    function moveModalToBody(modal) {
      if (modal && modal.parentNode !== document.body) {
        document.body.appendChild(modal);
      }
    }

    function openCompareModal() {
      moveModalToBody(compare_modal);
      compare_modal.style.display = 'flex';
      document.body.classList.add('compare-modals-show');
    }

    function closeCompareModal() {
      compare_modal.style.display = 'none';
      document.body.classList.remove('compare-modals-show');
    }

    document.querySelectorAll('.show_chair_compare_modal').forEach((btn) => {
      btn.addEventListener('click', openCompareModal);
    });

    document.getElementById('close_chair_compare_modal').addEventListener('click', closeCompareModal);

    compare_modal.addEventListener('click', (e) => {
      if (e.target === compare_modal) {
        closeCompareModal();
      }
    });
  })();
</script>
