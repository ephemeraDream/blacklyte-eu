        "extra_desc_JHP4Ug": {
          "type": "extra_desc",
          "settings": {
            "html": "<div class=\"product_infor_simplicity_right_extra_desc\">\n  <div class=\"metafield-rich_text_field\">\n    <p>Specifications</p>\n    <ul>\n      <li>Mineral Oil: 15%, Palm Wax: 8%, Beeswax: 12%, Water: 65%</li>\n      <li>Transparent Milky Color</li>\n      <li>250ML</li>\n      <li>Odorless</li>\n      <li>PH: Neutral</li>\n      <li>Density: 0.98</li>\n      <li>Shelf Life: 3 Years</li>\n      <li>Non-Flammable & Non-Explosive</li>\n      <li>Oxidizing Agents: None</li>\n    </ul>\n    <p>Directions of Use:</p>\n    <div>\n      1. Clean First: Ensure surface is clean and dry, better with leather\n      cleaner first.\n    </div>\n    <div>2. Shake Well: Shake the bottle before use.</div>\n    <div>3. Apply Conditioner: Spray onto a clean microfiber cloth.</div>\n    <div>\n      4. Massage in Circles: Gently rub in a circular motion over the leather.\n    </div>\n    <div>\n      5. Buff to Shine: Use a clean cloth to buff the surface to a smooth, shiny\n      finish.\n    </div>\n    <div>6. Allow to Dry: Let the surface air dry completely.</div>\n    <div>\n      7. Repeat Regularly: Use regularly to keep leather soft and protected.\n    </div>\n    <p>Precautions:</p>\n    <ul>\n      <li>\n        Keep the container sealed and store in a cool, dry, well-ventilated\n        area, away from oxidizing agents.\n      </li>\n      <li>\n        Wipe gently; avoid excessive friction to prevent damaging the leather.\n      </li>\n      <li>\n        Stains that have been present for a long time may be difficult to\n        remove.\n      </li>\n      <li>Keep out of reach of children and pets.</li>\n      <li>\n        In case of eye contact, rinse with plenty of water for at least 15\n        minutes and seek medical attention immediately.\n      </li>\n      <li>\n        Hazardous characteristics: Flammable liquid when exposed to flame or\n        high heat.\n      </li>\n    </ul>\n  </div>\n</div>"
          }
        },
