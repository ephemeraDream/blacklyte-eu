:"bottom","file_type":"video","cover_image":"shopify:\/\/shop_images\/PRECISE_ARM_SUPPORT_RELIEVE_SHOULDER_ARM_STRESS_major.webp","video_url":"","url_upload":"shopify:\/\/files\/videos\/PRECISE ARM SUPPORT RELIEVE SHOULDER & ARM STRESS major.webm"}},"img_with_text_simplicity_GcnqNM":{"type":"img-with-text-simplicity","custom_css":[".img_with_text_simplicity {padding-top: 8.33vw; padding-bottom: 7.8125vw;}",".img_with_text_simplicity .img_with_text_simplicity_subtitle {background: #ff0055; -webkit-background-clip: text; -webkit-text-fill-color: transparent;}"],"settings":{"specId":"","title":"<p>SNAP. SLIDE. RELAX <br>ADJUST WITH EASE<\/p>","sub_title":"MAGNETIC NECK PILLOW","description":"<p>Designed for effortless comfort and adjustment, our magnetic neck pillow adjusts to the perfect height with ease and stay securely in place. Its ergonomic shape and magnetic precision delivers the optimal support right where you need it most, keeping your neck and shoulder relaxed always.<\/p>","file_position":"bottom","file_type":"video","cover_image":"shopify:\/\/shop_images\/SNAP_SLIDE_RELAX_ADJUST_WITH_EASE_major.webp","video_url":"","url_upload":"shopify:\/\/files\/videos\/SNAP SLIDE RELAX ADJUST WITH EASE major.webm"}},"img_with_text_box_simplicity_xHQGVc":{"type":"img-with-text-box-simplicity","blocks":{"file_with_text_G7aHxJ":{"type":"file_with_text","settings":{"title":"Versatile Comfort","sub_title":"155° Backrest Recline","description":"Built for gaming, lounging, napping, and more. Adjust to any position effortlessly with a simple lever pull and push.","file_type":"video","cover_image":"shopify:\/\/shop_images\/major_155_Backrest_Recline.webp","video_url":"","url_upload":"shopify:\/\/files\/videos\/major 155° Backrest Recline.webm"}},"file_with_text_inBCzK":{"type":"file_with_text","settings":{"title":"Maximized Relaxation","sub_title":"13° Rocking Mode","description":"Find your perfect gaming stance with our multi-tilt mechanism. Adjust tension, lock your angle, and play in ultimate comfort.","file_type":"video","cover_image":"shopify:\/\/shop_images\/major_13_Rocking_Mode.webp","video_url":"","url_upload":"shopify:\/\/files\/videos\/major 13° Rocking Mode.webm"}},"file_with_text_HXmhgR":{"type":"file_with_text","settings":{"title":"Adaptive for Every Size","sub_title":"60 mm Height Adjustment","description":"SGS Certified Class Hydraulics. Built for strength and durability. Provide smooth height adjustment for personalized comfort.","file_type":"video","cover_image":"shopify:\/\/shop_images\/major_60_mm_Height_Adjustment.webp","video_url":"","url_upload":"shopify:\/\/files\/videos\/major 60 mm Height Adjustment.webm"}}},"block_order":["file_with_text_G7aHxJ","file_with_text_inBCzK","file_with_text_HXmhgR"],"custom_css":[".img_with_text_box_simplicity .img_with_text_box_simplicity_maintitle {background: #ff0055; -webkit-background-clip: text; -webkit-text-fill-color: transparent;}",".img_with_text_box_simplicity .img_with_text_box_simplicity_subtitle {background: #ff0055; -webkit-background-clip: text; -webkit-text-fill-color: transparent;}"],"settings":{"specId":"","sub_title":"","main_title":"HEAVY-DUTY TILT MECHANISM","text":"","mobile_display":"swiper"}},"specs_simplicity_CFhWKH":{"type":"specs-simplicity","custom_css":[".specs_simplicity .specs_simplicity_title {background: #ff0055; -webkit-background-clip: text; -webkit-text-fill-color: transparent;}"],"settings":{"product":"","show_type":"one"}},"collapsible_content_wUp4BY":{"type":"collapsible-content","blocks":{"content_zT96pN":{"type":"content","settings":{"header_title_before_iconSvg":"","heading":"1. What is the Athena Pro Austin Major Edition Gaming Chair?","content":"<p>The Athena Pro Austin Major Edition is a premium esports gaming chair designed by Blacklyte with comfort and performance in mind. It delivers ergonomic support, stable performance, and adjustable features built to meet the demands of serious gamers and long hours at the desk.<\/p>","page":"","show_header_title_before_icon":false}},"content_KGH7jy":{"type":"content","settings":{"header_title_before_iconSvg":"","heading":"2. What materials and build quality can I expect?","content":"<p>The chair is built with a full steel frame, high-density memory foam padding, and premium fabric or leatherette upholstery. This combination ensures durability, support, and comfort over years of use.<\/p>","page":"","show_header_title_before_icon":false}},"content_XfYfU6":{"type":"content","settings":{"header_title_before_iconSvg":"","heading":"3. Will this chair be comfortable for long gaming or work sessions?","content":"<p>Absolutely. Thanks to its high-density memory foam, ergonomic support, and customizable adjustments, this chair is designed to keep you comfortable and focused through long gaming marathons, work sessions, or content creation hours.<\/p>","page":"","show_header_title_before_icon":false}},"content_dxXEUG":{"type":"content","settings":{"header_title_before_iconSvg":"","heading":"4. What weight and size is this chair suitable for?","content":"<p>The chair adapts to a wide range of adult body types and weights, with a sturdy frame and premium support suitable for extended use. It is recommended for users up to 330 lbs (150kg) and up to 6’2″ (190cm) tall, fitting most body types comfortably.<\/p>","page":"","show_header_title_before_icon":false}},"content_fE4zFX":{"type":"content","settings":{"header_title_before_iconSvg":"","heading":"5. Does this chair require assembly?","content":"<p>Yes. The chair requires basic assembly out of the box. All tools and instructions are included, and most users can complete the setup in approximately 15–30 minutes.<\/p>","page":"","show_header_title_before_icon":false}},"content_gXBwWf":{"type":"content","settings":{"header_title_before_iconSvg":"","heading":"6. Does this chair include a warranty?","content":"<p>Yes. The Athena Pro Austin Major Edition Gaming Chair comes with Blacklyte’s standard 3-year warranty. By joining the <a href=\"\/pages\/warranty-extension\" target=\"_blank\" title=\"Warranty Extension\">Extend Warranty Program<\/a>, coverage can be extended up to 5 years for added long-term protection.<\/p>","page":"","show_header_title_before_icon":false}}},"block_order":["content_zT96pN","content_KGH7jy","content_XfYfU6","content_dxXEUG","content_fE4zFX","content_gXBwWf"],"custom_css":[".faqs-item {border-top: 1px solid #e6e6e6; font-family: Roboto;}",".collapsible-grid__item {border-bottom: 1px solid #e6e6e6;}",".collapsible-content {width: 100%; padding: 0 18.75vw;}",".halo-block-header {padding: 0 18.75vw;}",".halo-block-header h3 {font-family: Roboto; font-weight: 700;}",".card-body {color: #646669; font-size: 14px; font-weight: 400;}","@media screen and (max-width: 768px) {.collapsible-content {padding: 0 5.33vw; } .halo-block-header {padding: 0 5.33vw; }}"],"settings":{"id_section":"faq","container":"fullwidth","padding_full_width":50,"mg_top_desktop":100,"mg_top_tablet":50,"mg_top_mobile":40,"mg_bottom_desktop":100,"mg_bottom_tablet":50,"mg_bottom_mobile":40,"collapsible_bg":"#ffffff","collapsible_bg_gradient":"","collapsible_title":"FAQ","color_title":"#000000","fontsize_title":32,"fontsize_title_mb":24,"collapsible_des":"","color_des":"#3c3c3c","fontsize_des":16,"fontsize_des_mb":12,"max_width_des":700,"title_align":"left","enable_image_right":false,"bg_content_color":"#ffffff","title_color":"#000000","content_color":"#000000","icon_color":"#000000","border_color":"#000000","font-size_heading":16,"font-size_content":16,"font-size_content_line-height":22,"font-size_heading_mb":12,"font-size_content_mb":12,"font-size_content_line-height_mb":18}},"1743652201516533c4":{"type":"apps","blocks":{"judge_me_reviews_review_widget_98B9hP":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"review_data":"sample_data","max_width":1200,"show_shop_reviews":false,"empty_state":"empty_widget"}}},"block_order":["judge_