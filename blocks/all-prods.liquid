<style>
    .collections-prods.all-products-module{
        margin-top: 130px;
    }
    .all-products-module .module-head-cont{
        margin-bottom: 30px;
    }
    .all-products-module .all-prods-tabs{
        width: 100%;
        border-bottom: 1px solid #BCBCBC;
        display: flex;
        justify-content: center;
        gap: 200px;
    }

    .all-products-module .all-prods-tabs .all-prods-tab-item{
        font-family: Poppins;
        font-weight: 500;
        font-style: Medium;
        font-size: 16px;
        line-height: 40px;
        letter-spacing: 0%;
        text-align: center;
        color: #262626;
        cursor: pointer;
        padding-left: 12px;
        padding-right: 12px;
    }
    .all-products-module .all-prods-tabs .all-prods-tab-item.all-prods-tab-item-active{
        border-bottom: 1px solid #262626;
    }
    .images-lists {
        width: calc(50% - 8.5px);
    }
    .images-lists img,
    .images-lists .item-module-cont{
        height: 100%;
        border-radius: 16px;
        overflow: hidden;
    }
    .images-lists [data-module-type="desks"],
    .images-lists [data-module-type="accessories"]{
        display: none;
    }

    @media(max-width: 767px){
        .collections-prods.all-products-module{
            margin-top: 36px;
        }
        .images-lists {
            width: calc((100% - 10px) / 2);
        }

        .all-products-module .all-prods-tabs{
            gap: 50px;
        }
       
    }

    @media(min-width: 768px) and (max-width: 1024px){
        .images-lists{
            width: calc(((100% - 10px) / 3) * 2);
        }
    }
</style>
<div class="collections-prods all-products-module">
    <div class="module-head-cont">
        {% if block.settings.moduleTitle != blank %}
            <div class="collection-title">{{ block.settings.moduleTitle }}</div>
        {% endif %}
        {% if block.settings.moduleDesc != blank %}
            <div class="collection-desc">{{ block.settings.moduleDesc }}</div>
        {% endif %}
    </div>
    <div class="all-prods-tabs">
        {% if block.settings.chairsTab != blank %}
            <div class="all-prods-tab-item all-prods-tab-item-active" data-value="chairs">{{ block.settings.chairsTab }}</div>
        {% endif %}
        {% if block.settings.deskTab != blank %}
            <div class="all-prods-tab-item" data-value="desk">{{ block.settings.deskTab }}</div>
        {% endif %}
        {% if block.settings.accessoryTab != blank %}
            <div class="all-prods-tab-item" data-value="accessories">{{ block.settings.accessoryTab }}</div>
        {% endif %}
    </div>
    <div class="collections-lists limit-items">
        <div class="images-lists" data-module-type="chairs">
            <div class="chairs-main-iamge item-module-cont">
                <picture>
                    <source media="(max-width: 768px)" srcset="{{ block.settings.chairsMainImage_mb | img_url: 'master' }}">

                    <img
                        src="{{ block.settings.chairsMainImage | img_url: 'master' }}"
                        width="{{ block.settings.chairsMainImage.width }}"
                        height="{{ block.settings.chairsMainImage.height }}"
                        alt="{{ block.settings.chairsMainImage.alt | escape }}"
                        loading="lazy">
                </picture>
            </div>
            <div class="desks-main-iamge item-module-cont" data-module-type="desk">
                <picture>
                    <source media="(max-width: 768px)" srcset="{{ block.settings.desksMainImage_mb | img_url: 'master' }}">

                    <img
                        src="{{ block.settings.desksMainImage | img_url: 'master' }}"
                        width="{{ block.settings.desksMainImage.width }}"
                        height="{{ block.settings.desksMainImage.height }}"
                        alt="{{ block.settings.desksMainImage.alt | escape }}"
                        loading="lazy">
                </picture>
            </div>
            <div class="accessory-main-iamge item-module-cont" data-module-type="accessories">
                <picture>
                    <source media="(max-width: 768px)" srcset="{{ block.settings.accessoryMainImage_mb | img_url: 'master' }}">

                    <img
                        src="{{ block.settings.accessoryMainImage | img_url: 'master' }}"
                        width="{{ block.settings.accessoryMainImage.width }}"
                        height="{{ block.settings.accessoryMainImage.height }}"
                        alt="{{ block.settings.accessoryMainImage.alt | escape }}"
                        loading="lazy">
                </picture>
            </div>
        </div>
        {%- for product_card_product in collection.products -%}
            {%- liquid
                assign variant_img = ''
                for option in product_card_product.options_with_values
                    for variant in product_card_product.variants limit: 1
                    if variant.image != null
                        assign variant_img = variant.image
                    endif
                    endfor
                endfor
            -%}

            {%- if product_card_product.variants.size > 0 and product_card_product.has_only_default_variant != true -%}
                <script>
                    window.quick_view_inven_array_{{ product_card_product.id }} = {
                        {%- for variant in product_card_product.variants -%}
                        '{{ variant.id }}': '{{ variant.inventory_quantity }}',
                        {%- endfor -%}
                    };

                    window.quick_shop_policy_array_{{ product_card_product.id }} = {
                        {%- for variant in product_card_product.variants -%}
                        '{{ variant.id }}': '{{ variant.inventory_policy }}',
                        {%- endfor -%}
                    };

                    window.cart_selling_array_{{ product_card_product.id }} = {
                        {%- for variantProduct in product_card_product.variants -%}
                            '{{ variantProduct.id }}': '{{ variantProduct.inventory_policy }}',
                        {%- endfor -%}
                    };
                </script>
            {% endif %}

            
            <div data-url="{{ product_card_product.url }}" class="prod_item has-data-url-link" data-product-id="{{ product_card_product.id }}"  data-product-type="{{ product_card_product.metafields.custom.product_type.value }}">
                <div class="container-prod card">
                    <div class="card-product">
                        {% render 'product-badge', product: product_card_product, class: 'card__badge', badge_detail: true, serial: serial %}
                        <div class="card-media card-media--adapt {% if product_card_product.media[1] != nil and settings.show_image_swap %} media--hover-effect{% endif%} media--loading-effect" style="padding-bottom: {{ 1 | times: 100 }}%;">
                            {% render 'image-product-card', product_card_product: product_card_product, variant_img: variant_img, has_video: false, loading: true %}
                            
                        
                            <a class="card-link" href="{{ product_card_product.url }}" title="{{ product_card_product.title | escape }}"></a>
                        </div>
                    </div>
                    <div class="prod_card_info">
                        <div class="prod_item_series_name">
                            {% if product_card_product.metafields.custom.series_name != blank %}
                            {{ product_card_product.metafields.custom.series_name }}
                            {% else %}
                            {{ product_card_product.title }}
                            {% endif %}
                            
                        </div>
                        <div class="prod_item_title" style="display: none">
                            <span>{{ product_card_product.title }}</span>
                        </div>
                        
                        <div class="flex-1"></div>
                        <div class="prod_item-variants">
                            {% if product_card_product.options.size > 0 and product_card_product.options.first != 'Title' %}
                            {{ product_card_product.selected_or_first_available_variant.option1 }}
                            {% if product_card_product.selected_or_first_available_variant.option2 != blank %} / {% endif %}
                            {% if product_card_product.selected_or_first_available_variant.option2 != blank %} {{ product_card_product.selected_or_first_available_variant.option2 }} {% endif %}
                            {% endif %}
                            </div>
                            <div class="prod_item_price">
                            <div class="price">
                                {% if product_card_product.selected_or_first_available_variant.metafields.custom.discount_price.value %}
                                    <span class="prod_item_discount_price">
                                    {{
                                    product_card_product.selected_or_first_available_variant.price
                                    | minus: product_card_product.selected_or_first_available_variant.metafields.custom.discount_price.value
                                    | money_without_currency
                                    }}
                                    </span>
                                {% endif %}
                                
                                <span class="prod_item_sale_price{% if product_card_product.selected_or_first_available_variant.metafields.custom.discount_price.value %} prod_item_sale_price_new{% endif %}">{{ product_card_product.selected_or_first_available_variant.price | money }}</span>
                            </div>
                            </div>
                            <div class="product-btns">
                                <a class="shop_now_btn" href="{{ product_card_product.url }}">{{ 'products.product.shop_now' | t }}</a>
                                <a class="atc_btn">{{ 'products.product.add_to_cart' | t }}</a>
                            </div>
                            
                    </div>

                    <div class="prod-sale-tag">{{ 'general.navigation.sale_label' | t }}</div>
                </div>
            </div>
            
        {% endfor %}
    </div>
    
</div>

{% schema %}
{
  "name": "all prods",
  "settings": [
    {
        "type": "text",
        "id": "moduleTitle",
        "label": "module Title",
        "default": "Find Your 2026 Glow"
    },
    {
        "type": "text",
        "id": "moduleDesc",
        "label": "module Descripe",
        "default": "Give your home a fresh, brilliant look."
    },
    {
        "type": "text",
        "id": "chairsTab",
        "label": "chairs Tab",
        "default": "Chairs"
    },
    {
        "type": "text",
        "id": "deskTab",
        "label": "desk Tab",
        "default": "Desks"
    },
    {
        "type": "text",
        "id": "accessoryTab",
        "label": "accessory Tab",
        "default": "Accessories"
    },
    {
        "type": "image_picker",
        "id": "chairsMainImage",
        "label": "chairs Main Image"
    },
    {
        "type": "image_picker",
        "id": "chairsMainImage_mb",
        "label": "chairs Main Image Mobile"
    },
    {
        "type": "image_picker",
        "id": "desksMainImage",
        "label": "desks Main Image"
    },
    {
        "type": "image_picker",
        "id": "desksMainImage_mb",
        "label": "desks Main Image Mobile"
    },
    {
        "type": "image_picker",
        "id": "accessoryMainImage",
        "label": "accessory Main Image"
    },
    {
        "type": "image_picker",
        "id": "accessoryMainImage_mb",
        "label": "accessory Main Image Mobile"
    }
  ],
  "blocks": [ ],
  "presets": [
    {
      "name": "all prods"
    }
  ]
}
{% endschema %}
